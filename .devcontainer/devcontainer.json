{
  "name": "Nutrição Equina - Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:noble",

  // Aumentamos a memória para 6GB (necessário para phi3:mini)
  "hostRequirements": {
    "cpus": 2,
    "memory": "6GB",
    "storage": "10GB"
  },

  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  "forwardPorts": [3000, 5173, 11434],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "prisma.prisma"
      ]
    }
  }
}