# ── Banco ────────────────────────────────────────────────────────────────────
# DOIS usuários, e a separação é o que protege: a APLICAÇÃO conecta com um usuário
# SEM privilégio de dono, que por isso NÃO consegue desligar o Row-Level Security que
# o limita a um tenant (ver docs/MULTI-TENANCY-PLANO.md). As MIGRATIONS conectam com o
# dono do schema, que tem CREATE/ALTER.
# ⚠️ Rodar migration com o usuário da aplicação FALHA — ele não tem permissão de DDL:
#   DATABASE_URL=$DATABASE_URL_MIGRATIONS npx prisma migrate deploy
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=schs2vet"
# DATABASE_URL_MIGRATIONS="postgresql://dono:senha@localhost:5432/dbname?schema=schs2vet"

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_REFRESH_SECRET=troque-por-outra-string-longa-e-aleatoria

# -- E-mail -------------------------------------------------------------------
# Sustenta 2FA, boas-vindas, "esqueci minha senha", convite de equipe, link de
# fatura, alerta de cron e o PDF de prescricao/exame/fatura enviado ao cliente.
#
# O S2Vet e CLIENTE de SMTP, nao servidor: nao ha nada para instalar na VPS.
# Trocar de provedor e trocar VARIAVEL, nunca codigo (messaging/emailProvider.js).
#
# ATENCAO NA VPS: varios provedores (DigitalOcean, Vultr, Oracle, Azure) bloqueiam
# as portas 25/465/587 de SAIDA por padrao. Teste antes de investigar outra coisa:
#   nc -zv smtp-relay.brevo.com 587
# Bloqueado -> peca liberacao ao provedor, ou use o Resend (HTTPS/443, mais abaixo).

EMAIL_PROVIDER=nodemailer

# ---- Opcao A: BREVO (SMTP) — recomendado. 300 e-mails/dia no plano gratuito ----
# O login SMTP e gerado pelo Brevo em SMTP & API > SMTP; NAO e o seu e-mail.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=9a1b2c001@smtp-brevo.com
EMAIL_PASS=sua-smtp-key-do-brevo

# ---- Opcao B: GMAIL (legado) ----
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu@gmail.com
# EMAIL_PASS=senha-de-app-do-gmail       # exige 2FA na conta Google
# (com Gmail, EMAIL_FROM pode ficar vazio — o login JA e o endereco de envio)

# ---- Opcao C: RESEND (HTTPS, sem SMTP) ----
# 1. cd backend && npm install resend
# 2. EMAIL_PROVIDER=resend
# 3. RESEND_API_KEY=re_xxxxxxxx
# 4. EMAIL_FROM com o dominio verificado no painel do Resend
# Nenhuma outra mudanca: emailService.js ja passa tudo por getEmailProvider().
# RESEND_API_KEY=

# ---- Remetente (vale para os tres) ----
# 🔴 EMAIL_USER e CREDENCIAL; EMAIL_FROM e o "De:" que o destinatario ve. Com o
# Gmail os dois coincidiam, e por isso este campo nao existia. No Brevo/SES/Resend
# NAO coincidem: sem EMAIL_FROM o e-mail sai assinado por "9a1b2c001@smtp-brevo.com",
# que nao existe como caixa — recusado, ou entregue direto no spam.
# ⚠️ O dominio precisa estar VERIFICADO (SPF + DKIM) no painel do provedor.
# Vazio = cai em EMAIL_USER, que preserva o comportamento antigo do Gmail.
EMAIL_FROM=contato@suaclinica.com.br
# Nome exibido antes do endereco. Vazio = "S2Vet".
# EMAIL_FROM_NAME=S2Vet
# So para SMTP na porta 465 (TLS direto). Na 587 (STARTTLS) DEIXE FALSO — marcar
# true ali trava a conexao ate o timeout, sem erro que explique.
# EMAIL_SECURE=false

# IA — provider único: Google Gemini
GEMINI_API_KEY=sua-chave-gemini
# Modelo usado em TODAS as chamadas (texto, visão e transcrição de áudio).
# gemini-1.5-flash foi retirado da API do Google — só funciona em projetos legados.
# Ao trocar, registre o preço em src/services/aiLogger.service.js#PRECOS.
GEMINI_MODEL=gemini-3.1-flash-lite

# 2FA por e-mail no login com senha. Ligado por padrão para todos os usuários.
# MFA_EMAIL_ENABLED=false é KILL-SWITCH de emergência (ex.: SMTP fora do ar) —
# desliga o segundo fator globalmente sem migration. Por usuário:
#   UPDATE schs2vet.users SET mfa_ativo = false WHERE id = <id>;
MFA_EMAIL_ENABLED=true

# URL pública do frontend (usada em links de e-mail)
APP_URL=http://localhost:5173
PORT=3001

# WhatsApp — Evolution API (instância exclusiva por clínica; ver docs/INTEGRACAO_EVOLUTION_API.md)
EVOLUTION_URL=https://seu-servidor-evolution.com
EVOLUTION_API_KEY=sua-apikey-global-da-evolution
# 🔴 OBRIGATÓRIO em produção: se vazio, o webhook /api/webhooks/evolution fica ABERTO
# (aceita qualquer chamada). A conferência é constant-time (routes/webhooks.js).
EVOLUTION_WEBHOOK_TOKEN=token-aleatorio-do-webhook
# EVOLUTION_TIMEOUT_MS=15000
# Provider dos lembretes de agendamento: noop (simulado) | evolution
WHATSAPP_PROVIDER=noop

# ── Conversao de documento .doc (Word 97-2003) ───────────────────────────────
# LibreOffice headless converte `.doc` para `.docx` no upload do laudo, para que a
# tela de Resultado de Exames consiga PRE-VISUALIZAR o documento e a IA consiga LER
# o laudo (mammoth so abre `.docx`; o Gemini nao aceita `.doc` como anexo).
# OPCIONAL: sem o binario a aplicacao segue funcionando — o `.doc` e guardado como
# veio e apenas nao ganha pre-visualizacao (ver src/lib/documentoConversao.js).
# No Docker ja vem instalado pelo Dockerfile. No Windows, aponte para o executavel:
#   LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_BIN=soffice
# LIBREOFFICE_TIMEOUT_MS=30000
# LIBREOFFICE_MAX_BYTES=26214400

# ── Produção (proxy reverso, HTTPS, domínio próprio) ─────────────────────────
# Valores para o desenho recomendado: UM domínio, com o proxy servindo o estático do
# frontend em `/` e roteando `/api/*` para este backend. Same-origin — é o que mantém
# o cookie de sessão em SameSite=Lax (a ÚNICA proteção contra CSRF que a aplicação
# tem hoje) e evita preflight de CORS em toda requisição.

# Origens autorizadas do CORS, separadas por vírgula. Default: http://localhost:5173.
# Same-origin atrás do proxy nem exercita CORS, mas deixe correto: é o que segura o
# acesso vindo de fora se um dia o backend ganhar host próprio.
# 🔴 EM PRODUÇÃO: OBRIGATÓRIO com o(s) domínio(s) real(is). Deixar no default expõe a
# API a origens não previstas.
# ALLOWED_ORIGINS=https://s2vet.com.br

# Cookie de sessão só por HTTPS. Sem isto o cookie viaja em claro em produção.
# 🔴 EM PRODUÇÃO: OBRIGATÓRIO `true` (senão o cookie de sessão trafega sem criptografia
# e pode ser capturado na rede). Manter ausente/`false` só em dev por HTTP/localhost.
# COOKIE_SECURE=true

# Nº de proxies CONFIÁVEIS à frente da aplicação — é o que faz `req.ip` ser o IP real
# do cliente (rate limit por IP e IP na auditoria dependem disso).
# Default 1, que já serve para UM proxy reverso. Conte os saltos: Cloudflare + Nginx = 2.
# ⚠️ NUNCA `true` — confiar em qualquer X-Forwarded-For deixa o cliente forjar o
# próprio IP e escapar do rate limit.
# TRUST_PROXY_HOPS=1

# Onde o binário do arquivo é gravado. `db` (padrão) guarda no Postgres, e o download
# passa pela rota autorizada /api/midia/:chave — ver CLAUDE.md §8.
# ⚠️ Com `db` o dump de backup cresce junto com os anexos (laudo, foto, vídeo de
# prontuário até 150 MB). Quando incomodar, o caminho previsto é implementar o
# S3StorageProvider e trocar para `s3` — NENHUM controller muda.
# STORAGE_DRIVER=db

# Teto de requisições por minuto, por usuário autenticado (sem sessão, cai no IP).
# RATE_LIMIT_MAX=300
