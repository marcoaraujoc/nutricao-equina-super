DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=schs2vet"

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_REFRESH_SECRET=troque-por-outra-string-longa-e-aleatoria

EMAIL_USER=seu@email.com
EMAIL_PASS=senha-de-app-do-gmail
# Provider de e-mail: nodemailer (SMTP, padrão) | resend (HTTPS API — ver
# messaging/emailProvider.js; precisa de `npm install resend` + descomentar a
# classe ResendEmailProvider antes de usar)
EMAIL_PROVIDER=nodemailer
# RESEND_API_KEY=

# IA — provider único: Google Gemini
GEMINI_API_KEY=sua-chave-gemini
# Modelo usado em TODAS as chamadas (texto, visão e transcrição de áudio).
# gemini-1.5-flash foi retirado da API do Google — só funciona em projetos legados.
# Ao trocar, registre o preço em src/services/aiLogger.service.js#PRECOS.
GEMINI_MODEL=gemini-3.1-flash-lite

# 2FA por e-mail no login com senha. Ligado por padrão para todos os usuários.
# MFA_EMAIL_ENABLED=false é KILL-SWITCH de emergência (ex.: SMTP fora do ar) —
# desliga o segundo fator globalmente sem migration. Por usuário:
#   UPDATE schs2vet.users SET mfa_ativo = false WHERE id = <id>;
MFA_EMAIL_ENABLED=true

# URL pública do frontend (usada em links de e-mail)
APP_URL=http://localhost:5173
PORT=3001

# WhatsApp — Evolution API (instância exclusiva por clínica; ver docs/INTEGRACAO_EVOLUTION_API.md)
EVOLUTION_URL=https://seu-servidor-evolution.com
EVOLUTION_API_KEY=sua-apikey-global-da-evolution
EVOLUTION_WEBHOOK_TOKEN=token-aleatorio-do-webhook
# EVOLUTION_TIMEOUT_MS=15000
# Provider dos lembretes de agendamento: noop (simulado) | evolution
WHATSAPP_PROVIDER=noop