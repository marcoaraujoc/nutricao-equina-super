/// Arquivo binário guardado NO BANCO (bytea), não no filesystem.
///
/// POR QUÊ: em `/uploads` servido por `express.static` o byte saía da aplicação sem
/// passar por autenticação nenhuma — o único gate era o nome aleatório do arquivo
/// (capability URL). Quem obtivesse o link seguia acessando a foto/laudo do paciente
/// mesmo depois de perder acesso a ele, inclusive de outra empresa. Guardando aqui,
/// NÃO EXISTE caminho que não passe pelo controller: o gate deixa de ser o segredo da
/// URL e passa a ser a mesma regra de acesso do resto do sistema.
///
/// `conteudo` é `bytea` (Prisma Bytes) — NÃO usar text/CLOB: obrigaria base64, que
/// infla ~33% e gasta CPU nas duas pontas. O Postgres TOASTa o valor automaticamente
/// (comprime e fatia fora da tabela), e a leitura por faixa (HTTP Range) usa
/// `substring()`, então vídeo grande não é carregado inteiro em memória.
///
/// ESCOPO: `empresaId`/`animalId` são o que a rota de download usa para autorizar —
/// animal → verificarAcessoAnimal; empresa → tem de ser a do contexto. `publico=true`
/// é só para asset do PRODUTO (a marca S2Vet), nunca para dado de cliente.
model MidiaArquivo {
  id           Int      @id @default(autoincrement())
  /// Identificador opaco usado na URL (/api/midia/<chave>) — nunca o id sequencial,
  /// que seria enumerável.
  chave        String   @unique @db.VarChar(64)
  conteudo     Bytes
  mimeType     String   @map("mime_type") @db.VarChar(150)
  nomeOriginal String?  @map("nome_original") @db.VarChar(255)
  tamanho      Int
  /// Categoria de origem (equivale à antiga pasta): animais, evolucoes, exames,
  /// exames-imagens, empresas, profissionais.
  pasta        String   @db.VarChar(64)
  empresaId    Int?     @map("empresa_id")
  animalId     Int?     @map("animal_id")
  criadoPorId  Int?     @map("criado_por_id")
  publico      Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@index([empresaId])
  @@index([animalId])
  @@index([pasta])
  @@map("tb_midia_arquivos")
  @@schema("schs2vet")
}

/// ═══════════════════════════════════════════════════════════════════════════
/// CENTRAL DE DOCUMENTOS (migration 20260918000000_central_documentos)
///
/// TEMPLATE  → modelo reutilizável (o que se edita no editor de blocos)
/// EMITIDO   → instância do template com as variáveis JÁ RESOLVIDAS
///
/// Os dois são INDEPENDENTES de propósito: alterar um template não reescreve
/// documento já emitido. O emitido guarda o próprio conteúdo resolvido, que é o
/// que permite reimprimir daqui a dois anos exatamente o que o cliente recebeu.
/// ═══════════════════════════════════════════════════════════════════════════

/// CATÁLOGO MISTO: `empresaId` NULO = modelo GLOBAL do sistema (os 12 anexos da
/// Res. CFMV 1.321/2020, semeados por `seeds/003_documentos_cfmv.seed.js`);
/// preenchido = modelo daquela clínica.
///
/// ⚠️ COPY-ON-WRITE. A policy de RLS lê global+próprio mas só ESCREVE o próprio, e
/// `DocumentoTemplateController` respeita isso: alterar/favoritar/excluir um modelo
/// GLOBAL não muda o global — cria a cópia da empresa (`origemId` aponta para ele).
/// Sem essa assimetria, uma clínica reescreveria o atestado sanitário de todas.
model DocumentoTemplate {
  id        Int  @id @default(autoincrement())
  empresaId Int? @map("empresa_id")

  /// Identificador estável do modelo GLOBAL (`cfmv_01_atestado_sanitario`), que
  /// torna o seed idempotente. A cópia da empresa PRESERVA a chave — é assim que a
  /// tela sabe que aquele modelo da clínica nasceu de uma norma.
  chave         String?  @db.VarChar(60)
  nome          String   @db.VarChar(160)
  descricao     String   @default("") @db.VarChar(400)
  categoria     String   @default("personalizados") @db.VarChar(30)
  /// EQUINO | BOVINO | AMBOS
  especie       String   @default("AMBOS") @db.VarChar(10)
  tags          String[] @default([])
  /// `Bloco[]` de frontend/src/modules/documentos/types.ts.
  blocos        Json     @default("[]")
  favorito      Boolean  @default(false)
  compartilhado Boolean  @default(false)
  /// Soft delete — vai para a Lixeira. Modelo de documento clínico não se apaga.
  excluido      Boolean  @default(false)
  /// RASCUNHO | PUBLICADO | ARQUIVADO
  status        String   @default("RASCUNHO") @db.VarChar(12)
  origemId      Int?     @map("origem_id")
  autorId       Int?     @map("autor_id")
  autorNome     String?  @map("autor_nome") @db.VarChar(255)
  usos          Int      @default(0)
  versao        Int      @default(1)
  /// `VersaoTemplate[]` — os blocos ANTERIORES. Capado em 30 na aplicação.
  versoes       Json     @default("[]")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  empresa Empresa? @relation("EmpresaDocumentoTemplates", fields: [empresaId], references: [id], onDelete: Cascade)
  autor   User?    @relation("UserDocumentoTemplates", fields: [autorId], references: [id], onDelete: SetNull)
  origem  DocumentoTemplate?  @relation("DocumentoTemplateOrigem", fields: [origemId], references: [id], onDelete: SetNull)
  copias  DocumentoTemplate[] @relation("DocumentoTemplateOrigem")

  emitidos DocumentoEmitido[] @relation("DocumentoTemplateEmitidos")

  @@index([empresaId])
  @@index([categoria])
  @@map("tb_documento_templates")
  @@schema("schs2vet")
}

/// TENANT DIRETO. Snapshot do documento entregue — ver a nota do bloco acima.
model DocumentoEmitido {
  id           Int     @id @default(autoincrement())
  empresaId    Int     @map("empresa_id")
  animalId     Int     @map("animal_id")
  templateId   Int?    @map("template_id")
  templateNome String  @map("template_nome") @db.VarChar(160)
  /// Sequência POR EMPRESA (DOC-0001), resolvida dentro da transaction da emissão.
  numero       Int?
  titulo       String  @default("") @db.VarChar(200)
  /// Blocos com as variáveis JÁ RESOLVIDAS.
  blocos       Json    @default("[]")
  /// As variáveis usadas na resolução — auditoria de onde saiu cada valor.
  contexto     Json    @default("{}")
  evolucaoId   Int?    @map("evolucao_id")
  veterinarioId Int?   @map("veterinario_id")
  /// Nome do animal e do cliente COMO ESTAVAM na emissão (o cadastro muda; o papel não).
  animalNome   String  @default("") @map("animal_nome") @db.VarChar(255)
  clienteNome  String  @default("") @map("cliente_nome") @db.VarChar(255)
  emitidoEm    DateTime @default(now()) @map("emitido_em")
  ativo        Boolean  @default(true)
  canceladoMotivo String? @map("cancelado_motivo") @db.Text

  empresa     Empresa            @relation("EmpresaDocumentosEmitidos", fields: [empresaId], references: [id], onDelete: Cascade)
  animal      Animal             @relation("AnimalDocumentosEmitidos", fields: [animalId], references: [id], onDelete: Cascade)
  template    DocumentoTemplate? @relation("DocumentoTemplateEmitidos", fields: [templateId], references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica?   @relation("EvolucaoDocumentosEmitidos", fields: [evolucaoId], references: [id], onDelete: SetNull)
  veterinario User?              @relation("UserDocumentosEmitidos", fields: [veterinarioId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([animalId])
  @@index([evolucaoId])
  @@map("tb_documentos_emitidos")
  @@schema("schs2vet")
}
