  nome        String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  vetPerfil VetPerfil @relation(fields: [vetPerfilId], references: [id], onDelete: Cascade)

  @@map("tb_vet_subespecialidades")
  @@schema("schs2vet")
}

// Catálogo de especialidades por espécie (fonte única — substitui a lista fixa
// subespecialidades.ts). Cada linha = uma especialidade para uma espécie; uma
// especialidade comum (ex.: "Cardiologia") tem uma linha por espécie.
// CATALOGO MISTO (migration 20260920000000), mesma forma de `Medicamento`:
//   empresa_id NULL   = especialidade GLOBAL do sistema (seedEspecialidades.js) — toda
//                       clinica LE, nenhuma ESCREVE;
//   empresa_id setado = especialidade cadastrada a mao pela clinica (hoje, no
//                       encaminhamento para profissional EXTERNO) — so ela ve e edita.
// A unicidade e por INDICE PARCIAL, criado na migration e nao declaravel aqui:
//   (nome, especie_id)              WHERE empresa_id IS NULL      -> uma global por especie
//   (nome, especie_id, empresa_id)  WHERE empresa_id IS NOT NULL  -> uma por empresa
// `@@unique([nome, especieId, empresaId])` NAO serve: no Postgres dois NULL sao
// distintos, entao o catalogo GLOBAL deixaria de ser protegido contra duplicata.
model Especialidade {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(80)
  especieId Int      @map("especie_id")
  empresaId Int?     @map("empresa_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  especie      Especie                   @relation(fields: [especieId], references: [id], onDelete: Cascade)
  usuarios     UsuarioEspecialidade[]
  fornecedores FornecedorEspecialidade[]
  agendamentos AgendamentoClinico[]      @relation("AgendamentoEspecialidade")

  @@index([especieId])
  @@index([empresaId])
  @@map("tb_especialidades")
  @@schema("schs2vet")
}

// Especialidades de um usuário (VETERINARIO/FORNECEDOR com login). Multi-especialidade.
model UsuarioEspecialidade {
  id              Int @id @default(autoincrement())
  userId          Int @map("user_id")
  especialidadeId Int @map("especialidade_id")
  // Especialidade é POR EMPRESA: o mesmo profissional pode ser ortopedista numa
  // clínica e clínico geral na outra. null = vínculo legado (anterior à 20260807000000).
  empresaId       Int @map("empresa_id")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  especialidade Especialidade @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)
  empresa       Empresa       @relation("UsuarioEspecialidadeEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([userId, especialidadeId, empresaId], map: "tb_usuario_especialidades_user_esp_empresa_key")
  @@index([userId])
  @@index([empresaId])
  @@map("tb_usuario_especialidades")
  @@schema("schs2vet")
}

// Especialidades de um cadastro de Fornecedor (pode não ter login). Multi-especialidade.
model FornecedorEspecialidade {
  id              Int @id @default(autoincrement())
  fornecedorId    Int @map("fornecedor_id")
  especialidadeId Int @map("especialidade_id")

  fornecedor    Fornecedor    @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  especialidade Especialidade @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, especialidadeId])
  @@index([fornecedorId])
  @@map("tb_fornecedor_especialidades")
  @@schema("schs2vet")
}

// ⚠️ FASE 3 DO MULTI-TENANCY — `VetAnimalSolicitacao` (tb_vet_animal_solicitacoes) foi
// REMOVIDA (migration 20260806000000_remove_vinculos_vet_animal).
//
// Ela guardava o vínculo/aprovação entre veterinário, proprietário e animal (tipo
// VINCULO | DESVINCULO | TROCA_VET, com `approvalToken` e `expiresAt` para o link de
// 24h do e-mail). Era a única estrutura que dava acesso a paciente FORA da empresa: o
// vet com vínculo aceito enxergava o animal de qualquer clínica.
//
// O acesso passou a ser exclusivamente por `Animal.empresaId` (+ `equipeId`), e a
// concessão pontual a prestador continua sendo `DesignacaoPrestador` — que NÃO é um
// vínculo entre partes, e sim uma concessão do gestor DENTRO da empresa.
//
// NÃO recriar. Se um dia for preciso "o proprietário autoriza a clínica X", isso é um
// convite no control plane (empresa ↔ cliente), não um vínculo por animal.

// =============================================================================
// EMPRESA E EQUIPES
// =============================================================================

// Resumo de atendimentos do animal gerado por IA (painel do AnimalDetail).
// Um registro por (animal, empresa do contexto); append incremental via LLM
// quando surgem eventos novos (clínicos ou itens manuais de fatura).
// NOTA: acesso via raw SQL em resumoAtendimentoService enquanto o client não for regenerado.
model ResumoAtendimentoIA {
  id             Int       @id @default(autoincrement())
  animalId       Int       @map("animal_id")
  empresaId      Int       @map("empresa_id")
  resumo         String    @default("") @db.Text
  /// ⚠️ `dados` e `versaoPrompt` EXISTIAM no banco (6/6 linhas preenchidas) e são
  /// lidas/gravadas por `services/resumoAtendimentoService.js`, mas FALTAVAM aqui.
  /// Com isso, `prisma migrate diff` mandava **DROPAR as duas** — um `migrate dev`
  /// descuidado apagaria a Memória Clínica inteira (highlights + tópicos ancorados,
  /// CLAUDE.md §7) e o `versao_prompt` que dispara a reconstrução ao subir a versão
  /// do prompt. Declaradas em 2026-08-06 para fechar o drift SEM perder coluna.
  dados          Json?     @db.JsonB
  versaoPrompt   String?   @map("versao_prompt")
  ultimoEventoEm DateTime? @map("ultimo_evento_em")
  totalEventos   Int       @default(0) @map("total_eventos")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  animal  Animal  @relation("AnimalResumosIA", fields: [animalId], references: [id], onDelete: Cascade)
  empresa Empresa @relation("EmpresaResumosIA", fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([animalId, empresaId])
  @@index([animalId])
  @@map("tb_resumo_atendimento_ia")
  @@schema("schs2vet")
}

// Valor de venda de um procedimento definido POR EMPRESA (sobrepõe o valorVenda
// global do catálogo ADMIN). Gerenciado pelo GESTOR em Cadastro > Procedimentos.
model ProcedimentoValorEmpresa {
  id             Int      @id @default(autoincrement())
  empresaId      Int      @map("empresa_id")
  procedimentoId Int      @map("procedimento_id")
  valor          Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa      Empresa                 @relation("EmpresaProcedimentoValores", fields: [empresaId], references: [id], onDelete: Cascade)
  procedimento ProcedimentoVeterinario @relation("ProcedimentoValoresEmpresa", fields: [procedimentoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, procedimentoId])
  @@index([empresaId])
  @@map("tb_procedimento_valores_empresa")
  @@schema("schs2vet")
}

/// Vínculo PRESTADOR × PROCEDIMENTO por EMPRESA (migration 20261001000000).
///
/// Existe porque `ProcedimentoValorEmpresa` só comporta UM preço por procedimento:
/// a clínica com dois ferradores cobrando (e recebendo) valores diferentes pelo
/// mesmo ferrageamento não tinha onde gravar isso — o segundo sobrescrevia o primeiro.
///
/// ⚠️ NÃO substitui `ProcedimentoValorEmpresa`, que continua sendo o valor PADRÃO
/// da empresa (o que vale quando quem executa é a própria equipe, sem prestador
/// externo). Este vínculo só ESTREITA para o par (procedimento, prestador).
///
/// ⚠️ `valorCliente` NULO = "use o valor padrão da empresa" — é o que permite
/// vincular o prestador sem repetir um preço que já existe. `valorPrestador` é o outro
/// lado do balcão (o que a clínica DEVE a ele) e só vai ao recibo quando o
/// `tipoPagamento` do prestador é POR_PROCEDIMENTO.
///
/// 🔴 LEITURA/ESCRITA: SEMPRE por `lib/procedimentoPrestador.js` (SQL cru) — no Windows o
/// `prisma generate` falha com o backend rodando, então o client tipado pode não
/// conhecer esta tabela.
model ProcedimentoPrestador {
  id             Int      @id @default(autoincrement())
  empresaId      Int      @map("empresa_id")
  procedimentoId Int      @map("procedimento_id")
  prestadorId    Int      @map("prestador_id")
  valorCliente   Float?   @map("valor_cliente")
  valorPrestador Float?   @map("valor_prestador")
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  empresa      Empresa                 @relation("EmpresaProcedimentoPrestadores", fields: [empresaId], references: [id], onDelete: Cascade)
  procedimento ProcedimentoVeterinario @relation("ProcedimentoPrestadores", fields: [procedimentoId], references: [id], onDelete: Cascade)
  prestador    Prestador               @relation("PrestadorProcedimentos", fields: [prestadorId], references: [id], onDelete: Cascade)

  @@unique([empresaId, procedimentoId, prestadorId])
  @@index([empresaId])
  @@index([prestadorId])
  @@index([procedimentoId])
  @@map("tb_procedimento_prestadores")
  @@schema("schs2vet")
}

/// LEDGER de procedimento EXECUTADO por um prestador — base do RECIBO de pagamento
/// (migration 20261001000000).
///
/// 🔴 É SNAPSHOT, e por isso é tabela e não uma consulta sobre `Prescricao`: o valor
/// cobrado do cliente, o valor do prestador e a FORMA DE PAGAMENTO dele mudam com o
/// tempo. Um recibo de março recalculado com o percentual de setembro pagaria valor
/// diferente do que foi acordado, e não haveria como provar o contrário — mesma
/// premissa de `FaturaItem.descricao` e do snapshot do documento emitido.
///
/// ⚠️ Uma linha por EXECUÇÃO. A regra de cobrança não muda: procedimento só entra
/// na fatura (e aqui) DEPOIS de executado.
///
/// ⚠️ `animalNome`/`procedimentoNome` são GRAVADOS — o recibo precisa dizer o que
/// foi feito mesmo que o paciente seja renomeado ou o procedimento saia do catálogo.
///
/// ⚠️ SEM FK para prescrição/animal/prestador: o recibo tem de sobreviver ao
/// cancelamento da prescrição (o serviço foi prestado) e à exclusão do cadastro.
///
/// 🔴 LEITURA/ESCRITA: SEMPRE por `lib/procedimentoPrestador.js` (SQL cru).
model ExecucaoProcedimentoPrestador {
  id               Int      @id @default(autoincrement())
  empresaId        Int      @map("empresa_id")
  prestadorId      Int      @map("prestador_id")
  prescricaoId     Int?     @map("prescricao_id")
  animalId         Int      @map("animal_id")
  animalNome       String   @default("") @map("animal_nome") @db.VarChar(255)
  procedimentoNome String   @default("") @map("procedimento_nome") @db.VarChar(255)
  quantidade       Float    @default(1)
  valorCliente     Float    @default(0) @map("valor_cliente")
  valorPrestador   Float?   @map("valor_prestador")
  tipoPagamento    String?  @map("tipo_pagamento") @db.VarChar(20)
  formaPagamento   String?  @map("forma_pagamento") @db.VarChar(20)
  valorPagamento   Float?   @map("valor_pagamento")
  valorAPagar      Float    @default(0) @map("valor_a_pagar")
  /// VALOR_PROCEDIMENTO | PERCENTUAL_CLIENTE | VALOR_FIXO | SALARIO | SEM_CONFIG
  baseCalculo      String   @default("SEM_CONFIG") @map("base_calculo") @db.VarChar(24)
  executadoEm      DateTime @map("executado_em")
  executadoPorId   Int?     @map("executado_por_id")
  faturaItemId     Int?     @map("fatura_item_id")
  createdAt        DateTime @default(now()) @map("created_at")

  empresa Empresa @relation("EmpresaExecucoesPrestador", fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([empresaId, prestadorId, executadoEm])
  @@index([prescricaoId])
  @@map("tb_execucoes_procedimento_prestador")
  @@schema("schs2vet")
}

// Combo de procedimentos POR EMPRESA (pacote com valor próprio).
// Somente o GESTOR da empresa cria/edita; procedimentos vêm do catálogo ADMIN.
model ProcedimentoCombo {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  nome          String   @db.VarChar(255)
  descricao     String?  @db.Text
  // Especialidade do combo — todos os procedimentos do combo são dela.
  // Usada para filtrar os combos por especialidade na prescrição. null = legado.
  especialidade String?  @db.VarChar(100)
  /// **Valor CLIENTE** do pacote — o que se cobra do cliente. O nome da coluna é
  /// histórico (era o único valor que existia); renomeá-lo obrigaria a tocar todos os
  /// leitores para não ganhar nada. Na tela o rótulo é "Valor Cliente".
  valor         Float
  /// PRESTADOR que executa o pacote (migration 20261002000000). Sem FK, pela mesma
  /// razão de `Prescricao.prestadorId`: combo é configuração de preço e não pode ser
  /// alterado porque um cadastro de prestador foi excluído.
  /// ⚠️ Lido/gravado por SQL CRU (`lib/procedimentoPrestador.js`) — o client pode não
  /// conhecer a coluna.
  prestadorId    Int?    @map("prestador_id")
  /// O que o prestador cobra da clínica pelo PACOTE. Vai ao recibo quando o tipo de
  /// pagamento dele é POR_PROCEDIMENTO.
  valorPrestador Float?  @map("valor_prestador")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresa Empresa                 @relation("EmpresaProcedimentoCombos", fields: [empresaId], references: [id], onDelete: Cascade)
  itens   ProcedimentoComboItem[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@index([ativo])
  @@map("tb_procedimento_combos")
  @@schema("schs2vet")
}

model ProcedimentoComboItem {
  id             Int @id @default(autoincrement())
  comboId        Int @map("combo_id")
  procedimentoId Int @map("procedimento_id")

  combo        ProcedimentoCombo       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  procedimento ProcedimentoVeterinario @relation("ProcedimentoComboItens", fields: [procedimentoId], references: [id], onDelete: Cascade)

  @@unique([comboId, procedimentoId])
  @@index([comboId])
  @@map("tb_procedimento_combo_itens")
  @@schema("schs2vet")
}

// =============================================================================
// ORÇAMENTO (etapa OPCIONAL — quote por proprietário/animais)
// =============================================================================
// Monta um orçamento de procedimentos/combos, medicamentos e vacinas. A equipe
// registra o que o cliente aceitou/rejeitou (status derivado dos itens). Os itens
// ACEITO podem ser importados nas telas de Prescrição e Vacina. Não substitui nem
// bloqueia o fluxo clínico/fatura atual.
model Orcamento {
  id             Int      @id @default(autoincrement())
  empresaId      Int      @map("empresa_id") // sem FK — sobrevive à exclusão da empresa
  equipeId       Int?     @map("equipe_id")
  proprietarioId Int      @map("proprietario_id")
  criadoPorId    Int      @map("criado_por_id")
  numero         Int // sequencial por empresa
  status         String   @default("RASCUNHO") // RASCUNHO|APROVADO|APROVADO_PARCIALMENTE|REJEITADO
  observacao     String?  @db.Text
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  proprietario User            @relation("OrcamentoProprietario", fields: [proprietarioId], references: [id], onDelete: Cascade)
  criadoPor    User            @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  itens        OrcamentoItem[]

  @@index([empresaId])
  @@index([proprietarioId])
  @@index([status])
  @@map("tb_orcamentos")
  @@schema("schs2vet")
}

model OrcamentoItem {
  id            Int       @id @default(autoincrement())
  orcamentoId   Int       @map("orcamento_id")
  animalId      Int?      @map("animal_id") // null = item no nível do proprietário
  tipo          String // PROCEDIMENTO|COMBO|MEDICAMENTO|VACINA|OUTROS
  refId         Int?      @map("ref_id") // id do catálogo de origem (proc/combo/medicamento/vacina)
  especialidade String?   @db.VarChar(100)
  descricao     String    @db.VarChar(255)
  quantidade    Float     @default(1)
  unidade       String?   @db.VarChar(50)
  // MEDICAMENTO/PROCEDIMENTO: posologia orçada. quantidade = dias × aplicações/dia;
  // os dois campos voltam preenchidos na importação para a Prescrição (duração e frequência).
  dias          Int?
  frequencia    String?   @db.VarChar(50)
  // VACINA: mesmos campos obrigatórios da tela de aplicação (Tipo Dose/Via) —
  // capturados aqui (migration 20260902000000) para a importação já vir pronta,
  // sem exigir preenchimento manual depois de importar.
  tipoDose      String?   @map("tipo_dose") @db.VarChar(50)
  via           String?   @db.VarChar(100)
  valorUnitario Float     @default(0) @map("valor_unitario")
  // Desconto do item: PERCENTUAL (0-100) ou VALOR (R$ sobre o bruto). null/0 = sem desconto.
  descontoTipo  String?   @map("desconto_tipo") @db.VarChar(12)
  descontoValor Float     @default(0) @map("desconto_valor")
  // LÍQUIDO: quantidade × valorUnitario − desconto
  valorTotal    Float     @default(0) @map("valor_total")
  statusItem    String    @default("PENDENTE") @map("status_item") // PENDENTE|ACEITO|REJEITADO
  // OUTROS: marcado quando o item é lançado direto na fatura (mesma semântica de "importado")
  importadoEm   DateTime? @map("importado_em")
  createdAt     DateTime  @default(now()) @map("created_at")

  orcamento   Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  animal      Animal?      @relation("OrcamentoItemAnimal", fields: [animalId], references: [id], onDelete: SetNull)
  faturaItens FaturaItem[] @relation("FaturaItemOrcamento")
  prescricoes Prescricao[] @relation("PrescricaoOrcamento")

  @@index([orcamentoId])
  @@index([animalId])
  @@map("tb_orcamento_itens")
  @@schema("schs2vet")
}

// Plano de consumo de IA por cliente (empresa). Conta única no Google + medição
// interna: o custo é centralizado e rateado/limitado por tenant aqui.
// SEM LINHA = sem limite (apenas medição). Limite null = ilimitado na dimensão.
/// PLANO COMERCIAL do SaaS — catálogo GLOBAL, não pertence a empresa nenhuma.
/// Fica no control plane (sem RLS): é o cadastro do produto, e o ADMIN da plataforma o
/// edita atravessando todos os tenants.
model Plano {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(40)
  nome String @db.VarChar(100)

  /// Assentos incluídos. **NULL = ilimitado** — e não "zero". Zero é um plano sem
  /// nenhum usuário, que existe (avaliação bloqueada); confundir os dois liberaria
  /// geral no plano mais restrito.
  limiteUsuarios Int?   @map("limite_usuarios")
  limiteAnimais  Int?   @map("limite_animais")
  precoMensal    Float? @map("preco_mensal")

  /// Validade do plano em DIAS, preenchida pelo ADMIN. Ao associar o plano a uma
  /// empresa, o vencimento da assinatura (`AssinaturaEmpresa.fimEm`) é calculado como
  /// `inicioEm + validadeDias`. **NULL = sem validade** (não expira).
  validadeDias Int? @map("validade_dias")

  ativo Boolean @default(true)
  ordem Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assinaturas AssinaturaEmpresa[]

  @@map("tb_planos")
  @@schema("schs2vet")
}

/// ASSINATURA da empresa — uma por empresa. Control plane, mesma razão do `Plano`.
model AssinaturaEmpresa {
  id        Int @id @default(autoincrement())
  empresaId Int @unique @map("empresa_id")
  planoId   Int @map("plano_id")

  /// Situação COMERCIAL. ⚠️ Não bloqueia acesso sozinha: quem barra o login é
  /// `Empresa.status = SUSPENSA` (D3). Aqui fica o PORQUÊ, lá fica o EFEITO — assim a
  /// suspensão por inadimplência é uma decisão explícita, e não um efeito colateral de
  /// uma fatura em atraso.
  status String @default("TRIAL") @db.VarChar(20) // TRIAL | ATIVA | INADIMPLENTE | CANCELADA

  inicioEm DateTime  @default(now()) @map("inicio_em")
  fimEm    DateTime? @map("fim_em")

  /// Negociação pontual sem precisar criar um plano só para um cliente. Quando
  /// preenchido, VENCE o `limiteUsuarios` do plano.
  limiteUsuariosOverride Int? @map("limite_usuarios_override")

  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation("EmpresaAssinatura", fields: [empresaId], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [planoId], references: [id], onDelete: Restrict)

  @@index([planoId])
  @@index([status])
  @@map("tb_assinaturas_empresa")
  @@schema("schs2vet")
}

model IaPlanoEmpresa {
  id                Int      @id @default(autoincrement())
  empresaId         Int      @unique @map("empresa_id")
  plano             String   @default("PADRAO") @db.VarChar(40)
  limiteTokensMes   Int?     @map("limite_tokens_mes")
  limiteChamadasMes Int?     @map("limite_chamadas_mes")
  // false = modo observação (deixa passar, apenas sinaliza no painel)
  bloquearAoExceder Boolean  @default(true) @map("bloquear_ao_exceder")
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  empresa Empresa @relation("EmpresaIaPlano", fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("tb_ia_plano_empresa")
  @@schema("schs2vet")
}

// Configuração global de segurança (linha única, id = 1) — chave mestra do ADMIN
// da plataforma. Tira o 2FA da dependência exclusiva de variável de ambiente.
// Ordem de resolução em services/mfaService.js:
//   MFA_EMAIL_ENABLED=false (kill-switch) > mfaEmailAtivo (aqui) > User.mfaAtivo
model ConfiguracaoSeguranca {
  id              Int      @id @default(1)
  mfaEmailAtivo   Boolean  @default(false) @map("mfa_email_ativo")
  atualizadoPorId Int?     @map("atualizado_por_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  atualizadoPor User? @relation("ConfigSegurancaAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("tb_configuracao_seguranca")
  @@schema("schs2vet")
}

// Desafio de 2FA pendente entre a senha correta e a emissão dos cookies de sessão.
// O código nunca é persistido em claro — só o hash SHA-256.
model MfaDesafio {
  id         String   @id
  userId     Int      @map("user_id")
  codigoHash String   @map("codigo_hash")
  expiraEm   DateTime @map("expira_em")
  tentativas Int      @default(0)
  reenvios   Int      @default(0)
  consumido  Boolean  @default(false)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  user User @relation("UserMfaDesafios", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiraEm])
  @@map("tb_mfa_desafios")
  @@schema("schs2vet")
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String?
  telefone  String?
  endereco  String?
  ownerId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Cadastro do ASSINANTE (fase 2 do multi-tenancy) ────────────────────────
  // `nome`, `cnpj`, `telefone` e `endereco` acima são os campos LEGADOS: continuam
  // porque o unique(ownerId, nome, cnpj) e ~60 pontos de código dependem deles. A
  // limpeza é tarefa própria, depois que os leitores migrarem.
  razaoSocial       String? @map("razao_social") @db.VarChar(255)
  nomeFantasia      String? @map("nome_fantasia") @db.VarChar(255)
  // Documento em DÍGITOS (sem máscara) + o que ele é. A "empresa pessoal" (CPF) já existe
  // no modelo — ver o comentário do unique abaixo.
  // ÚNICO ENTRE EMPRESAS (migration `20260816100000`): o documento é o que identifica o
  // assinante, e duas linhas com o mesmo CNPJ são duplicata, não filial. NULL fica de
  // fora do índice (o Postgres trata NULLs como distintos), o que preserva a empresa
  // legada que ainda não informou o seu — a aplicação é que passou a exigi-lo.
  // Escrita SEMPRE junto do `cnpj` legado, com os mesmos dígitos — ver lib/documentoEmpresa.js.
  documento         String? @unique @db.VarChar(14)
  tipoDocumento     String? @map("tipo_documento") @db.VarChar(4) // CNPJ | CPF
  inscricaoEstadual String? @map("inscricao_estadual") @db.VarChar(20)
  emailContato      String? @map("email_contato") @db.VarChar(255)
  // D4: o DONO do WhatsApp é este cadastro. `EmpresaConfiguracao.whatsapp` passa a ler
  // daqui — dois donos para o mesmo dado sempre divergem.
  whatsapp          String? @db.VarChar(15)
  cep               String? @db.VarChar(10)
  numero            String? @db.VarChar(20)
  complemento       String? @db.VarChar(100)
  bairro            String? @db.VarChar(100)
  cidade            String? @db.VarChar(100)
  estado            String? @db.VarChar(2)

  // D3: empresa SUSPENSA **bloqueia o login de todos** dela. É por EMPRESA — quem também
  // trabalha em outra clínica entra nela normalmente, e a suspensa some do seletor de
  // contexto. Quem lê isto é `podeAcessarSistema`, o mesmo ponto do `acessoSistema`.
  // ⚠️ Este campo governa o ACESSO. `AssinaturaEmpresa.status` descreve a situação
  // COMERCIAL (o porquê) e não bloqueia nada sozinho — não confundir os dois.
  status      String    @default("ATIVA") @db.VarChar(20) // ATIVA | SUSPENSA | CANCELADA
  canceladoEm DateTime? @map("cancelado_em")

  owner                       User?                         @relation("EmpresaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assinatura                  AssinaturaEmpresa?            @relation("EmpresaAssinatura")
  iaPlano                     IaPlanoEmpresa?               @relation("EmpresaIaPlano")
  proprietarios               User[]                        @relation("ProprietarioEmpresa")
  proprietarioPerfis          ProprietarioPerfil[]          @relation("ProprietarioPerfilEmpresa")
  proprietarioLocalidades     ProprietarioLocalidade[]      @relation("ProprietarioLocalidadeEmpresa")
  profissionalPerfis          ProfissionalPerfil[]          @relation("ProfissionalPerfilEmpresa")
  usuariosVinculados          UsuarioEmpresa[]              @relation("UsuarioEmpresaEmpresa")
  especialidadesMembros       UsuarioEspecialidade[]        @relation("UsuarioEspecialidadeEmpresa")
  equipes                     Equipe[]
  animais                     Animal[]                      @relation("EmpresaAnimais")
  animalProprietarioHistorico AnimalProprietarioHistorico[]
  estoques                    EstoqueClinica[]              @relation("EmpresaEstoque")
  loteVacinas                 LoteVacina[]                  @relation("LoteVacinaEmpresa")
  configuracoes               EmpresaConfiguracao[]
  procedimentoValores         ProcedimentoValorEmpresa[]    @relation("EmpresaProcedimentoValores")
  procedimentoPrestadores     ProcedimentoPrestador[]       @relation("EmpresaProcedimentoPrestadores")
  execucoesPrestador          ExecucaoProcedimentoPrestador[] @relation("EmpresaExecucoesPrestador")
  procedimentoCombos          ProcedimentoCombo[]           @relation("EmpresaProcedimentoCombos")
  resumosIA                   ResumoAtendimentoIA[]         @relation("EmpresaResumosIA")
  documentoTemplates          DocumentoTemplate[]           @relation("EmpresaDocumentoTemplates")
  documentosEmitidos          DocumentoEmitido[]            @relation("EmpresaDocumentosEmitidos")

  // Duplicidade: mesmo gestor (ownerId ≡ e-mail único) + mesmo nome + mesmo CNPJ é bloqueado.
  // cnpj NULL (empresa pessoal/CPF): Postgres trata NULLs como distintos — enforcement na aplicação.
  @@unique([ownerId, nome, cnpj])
  @@map("tb_empresas")
  @@schema("schs2vet")
}

// Perfil do PROPRIETÁRIO por EMPRESA — isolamento multi-tenant dos dados do cliente.
//
// O `User` permanece como IDENTIDADE de login (email/senha/ativo global) e é único no
// sistema (User.email @unique). Já os dados CADASTRAIS que cada clínica mantém sobre o
// mesmo cliente (nome como ela o chama, telefones, documento, endereço, condição
// comercial) vivem AQUI, uma linha por empresa. Assim, o mesmo proprietário atendido
// pelas empresas A e B tem dois cadastros independentes: alterar na A não reflete na B.
//
// REGRA DE LEITURA (lib/proprietarioPerfil.js): quando existe perfil para a empresa do
// contexto, ele é a AUTORIDADE de todos os seus campos — null aqui significa "vazio
// nesta empresa", e NÃO cai de volta no User. Sem perfil (dado legado), lê-se o User.
/// Cadastro do PROFISSIONAL por EMPRESA (migration 20260807000000).
/// Mesma regra do ProprietarioPerfil: `User` é só IDENTIDADE (e-mail, senha, userType,
/// ativo global) e o cadastro — nome, contato, endereço, CRMV — vive aqui, um registro
/// por empresa. O mesmo profissional pode atuar em várias clínicas com cadastros
/// INDEPENDENTES; ao ser incluído numa empresa nova, nada é pré-carregado da outra.
/// LEITURA/ESCRITA: sempre via `lib/profissionalPerfil.js`.
// ─────────────────────────────────────────────────────────────────────────────
// UsuarioEmpresa — TABELA DE LIGAÇÃO usuário × empresa (decisão 2026-07-30)
//
// `users` guarda APENAS a identidade/autenticação (e-mail, senha, refresh token,
// 2FA, role de plataforma, ativo global). TUDO o que a pessoa é e tem DENTRO de
// uma empresa mora aqui: o PERFIL (tipo de usuário naquela clínica) e o cadastro
// (nome, telefone, documento, endereço, CRMV, condição comercial de cliente).
//
// É o que permite o mesmo e-mail ser gestora na empresa 1, veterinária na 2,
// estagiária na 3 e proprietária na 4 — cada uma com endereço e telefone próprios —
// mantendo UM login (e sem duplicar linha em `users`, o que quebraria login, 2FA,
// OAuth e reset de senha, todos indexados por e-mail único).
//
// Substitui e unifica ProfissionalPerfil + ProprietarioPerfil (mantidos por ora
// como legado, sem uso novo, para não perder histórico antes do backfill validado).
// ─────────────────────────────────────────────────────────────────────────────
model UsuarioEmpresa {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  empresaId Int @map("empresa_id")

  // PERFIL do usuário NESTA empresa — é o "tipo de usuário" por empresa.
  // GESTOR | VETERINARIO | ESTAGIARIO | ENFERMEIRO | SECRETARIA | FINANCEIRO |
  // FORNECEDOR | PRESTADOR | PROPRIETARIO
  perfil String @db.VarChar(20)

  // Cadastro nesta empresa (nada é herdado de outra nem do `users`)
  fullName    String? @map("full_name") @db.VarChar(255)
  phone       String? @db.VarChar(30)
  phone2      String? @db.VarChar(30)
  cpf         String? @db.VarChar(14)
  cnpj        String? @db.VarChar(18)
  cep         String? @db.VarChar(10)
  endereco    String? @db.VarChar(255)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cidade      String? @db.VarChar(100)
  estado      String? @db.VarChar(2)
  // CRMV por empresa (VetPerfil.crmv é @unique global e não comporta o mesmo
  // profissional cadastrado por duas clínicas)
  crmv        String? @db.VarChar(20)
  // Foto da pessoa NESTA empresa (migration 20260814000000) — URL do StorageProvider.
  // null = sem foto (a tela cai nas iniciais). Lida/gravada por SQL cru, ver
  // lib/usuarioEmpresa.js.
  fotoUrl     String? @map("foto_url")
  // Assinatura do profissional NESTA empresa (migration 20260918000000) — imagem
  // recortada, usada pelo bloco `assinatura` da Central de Documentos. POR EMPRESA
  // pela mesma razão da foto: o cadastro é da clínica. O CRMV que acompanha é a
  // coluna `crmv` logo acima. Lida/gravada por SQL cru, ver lib/usuarioEmpresa.js.
  assinaturaUrl String? @map("assinatura_url")

  // Condição comercial do CLIENTE nesta empresa
  mensalista          Boolean @default(false)
  valorAssistencia    Float?  @map("valor_assistencia")
  frequenciaVisitas   Int?    @map("frequencia_visitas")
  diaVencimentoFatura Int?    @map("dia_vencimento_fatura")

  // Remuneração do PROFISSIONAL nesta empresa (o acordo é com cada clínica:
  // salário aqui, comissão ali). NULL = vínculo legado, anterior à migration
  // 20260812000002 — a obrigatoriedade é da aplicação, na inclusão/edição do membro.
  tipoPagamento  String? @map("tipo_pagamento") @db.VarChar(10) // SALARIO | COMISSAO
  formaPagamento String? @map("forma_pagamento") @db.VarChar(10) // VALOR | PERCENTUAL
  valorPagamento Float?  @map("valor_pagamento")

  // Sem acesso, a pessoa NÃO loga — fica só como cadastro da clínica. Concedido por
  // EMPRESA: quem tem acesso pela clínica A e está bloqueado na B só enxerga a A no
  // seletor de contexto. Base do futuro controle de usuários por plano.
  acessoSistema Boolean @default(true) @map("acesso_sistema")

  // Ativo DENTRO desta empresa (User.ativo continua global, só o ADMIN mexe)
  ativo                Boolean   @default(true)
  // Quando o PRÓPRIO usuário salvou o Cadastro Pessoal nesta empresa. NULL = ainda
  // não confirmou → módulos bloqueados (o gestor ter preenchido não conta).
  cadastroConfirmadoEm DateTime? @map("cadastro_confirmado_em")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user    User    @relation("UsuarioEmpresaUser", fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation("UsuarioEmpresaEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([userId, empresaId])
  @@index([empresaId])
  @@index([perfil])
  @@map("tb_usuario_empresa")
  @@schema("schs2vet")
}

model ProfissionalPerfil {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  empresaId Int @map("empresa_id")

  fullName    String?  @map("full_name") @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  cep         String?  @db.VarChar(10)
  endereco    String?  @db.VarChar(255)
  complemento String?  @db.VarChar(100)
  bairro      String?  @db.VarChar(100)
  cidade      String?  @db.VarChar(100)
  estado      String?  @db.VarChar(2)
  // CRMV aqui (e não em VetPerfil, que é @unique global) — cada empresa informa o seu
  crmv        String?  @db.VarChar(20)
  // Ativo DENTRO desta empresa (User.ativo continua global, só o ADMIN mexe)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User    @relation("ProfissionalPerfilUser", fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation("ProfissionalPerfilEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([userId, empresaId])
  @@index([empresaId])
  @@map("tb_profissional_perfis")
  @@schema("schs2vet")
}

model ProprietarioPerfil {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  empresaId Int @map("empresa_id")

  fullName            String?   @map("full_name") @db.VarChar(255)
  phone               String?   @db.VarChar(30)
  phone2              String?   @db.VarChar(30)
  cpf                 String?   @db.VarChar(14)
  cnpj                String?   @db.VarChar(18)
  cep                 String?   @db.VarChar(10)
  endereco            String?   @db.VarChar(255)
  complemento         String?   @db.VarChar(100)
  bairro              String?   @db.VarChar(100)
  cidade              String?   @db.VarChar(100)
  estado              String?   @db.VarChar(2)
  mensalista          Boolean   @default(false)
  valorAssistencia    Float?    @map("valor_assistencia")
  frequenciaVisitas   Int?      @map("frequencia_visitas")
  diaVencimentoFatura Int?      @map("dia_vencimento_fatura")
  // COMO o cliente quer receber a fatura NESTA empresa (migration 20261017000000):
  // CSV de EMAIL|WHATSAPP|IMPRESSO — pode ser mais de uma. NULL/vazio = TODAS, que é
  // o comportamento de toda a base anterior à coluna (por isso a migration não tem
  // backfill: escolher por alguém TIRARIA um botão de envio que a clínica usa hoje).
  // 🔴 LEITURA/ESCRITA SEMPRE por lib/formasRecebimentoFatura.js (SQL cru) — a coluna
  // NÃO entra em CAMPOS_PERFIL de lib/proprietarioPerfil.js de propósito: aquele
  // monta o `select` TIPADO, e no Windows o `prisma generate` falha com o backend no
  // ar, então um client defasado derrubaria o cadastro de cliente inteiro (§11).
  formasRecebimentoFatura String? @map("formas_recebimento_fatura") @db.VarChar(60)
  // Ativo DENTRO desta empresa (User.ativo continua global, só o ADMIN mexe)
  ativo               Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de Fornecedor/
  // Prestador/Tratador (migration 20260827000000), lida/gravada por
  // lib/cadastroAtivacao.js. Sem FK cascade: excluir quem fez a ação não apaga
  // nem restaura o registro afetado.
  ativoEm             DateTime? @map("ativo_em")
  ativoPorId          Int?      @map("ativo_por_id")
  inativoEm           DateTime? @map("inativo_em")
  inativoPorId        Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000000) — obrigatória em
  // ProprietarioController.removerDaEmpresa, exibida na aba Inativos.
  inativoMotivo       String?   @map("inativo_motivo") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user    User    @relation("ProprietarioPerfilUser", fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation("ProprietarioPerfilEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([userId, empresaId])
  @@index([empresaId])
  @@map("tb_proprietario_perfis")
  @@schema("schs2vet")
}

// Localidades atendidas de um PROPRIETÁRIO, cada uma com a SUA frequência de visitas
// (ex.: Sociedade Hípica Brasileira 2x/semana + Haras H.P. 3x/semana). Um cliente pode
// ter animais em mais de um lugar, e o combinado de visitas é por lugar — por isso não
// cabia no campo único `frequenciaVisitas`, que segue existindo como AGREGADO (o maior
// entre as localidades) para as leituras legadas e para o ADMIN global.
// POR EMPRESA, pela mesma razão do ProprietarioPerfil: o combinado da clínica A não é
// o da clínica B, mesmo sendo o mesmo cliente (e-mail único).
model ProprietarioLocalidade {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  empresaId         Int      @map("empresa_id")
  localizacaoId     Int      @map("localizacao_id")
  // Visitas por SEMANA naquela localidade (1-7). Validado na aplicação.
  frequenciaVisitas Int      @map("frequencia_visitas")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user        User              @relation("ProprietarioLocalidadeUser", fields: [userId], references: [id], onDelete: Cascade)
  empresa     Empresa           @relation("ProprietarioLocalidadeEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)
  localizacao LocalizacaoAnimal @relation("ProprietarioLocalidadeLocal", fields: [localizacaoId], references: [id], onDelete: Cascade)

  // A mesma localidade não se repete para o mesmo cliente na mesma empresa — ao
  // contrário do local de trabalho do profissional, aqui não há turno: é uma
  // frequência por lugar.
  @@unique([userId, empresaId, localizacaoId])
  @@index([empresaId])
  @@index([localizacaoId])
  @@map("tb_proprietario_localidades")
  @@schema("schs2vet")
}

model Equipe {
  id        Int      @id @default(autoincrement())
  nome      String
  empresaId Int
  createdAt DateTime @default(now())

  empresa                 Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  membros                 MembroEquipe[]
  convites                ConviteEquipe[]
  permissoesMembros       PermissaoMembro[]
  permissoesProprietarios PermissaoProprietario[]
  perfis                  PerfilEquipe[]
  animais                 Animal[]                @relation("EquipeAnimais")
  proprietarios           User[]                  @relation("ProprietarioEquipe")
  designacoesPrestador    DesignacaoPrestador[]   @relation("EquipeDesignacoes")
  fornecedores            Fornecedor[]            @relation("EquipeFornecedores")
  tratadores              Tratador[]              @relation("EquipeTratadores")
  localizacoes            LocalizacaoAnimal[]     @relation("EquipeLocalizacoes")
  configuracoes           EmpresaConfiguracao[]

  @@unique([empresaId, nome])
  @@map("tb_equipes")
  @@schema("schs2vet")
}

// Configuração por empresa (CNPJ) ou por equipe (empresa pessoal/CPF) — mesmo critério de
// escopo usado pelo EmpresaContext no frontend (ver EquipeController.getEmpresaDoGestor/
// getEquipeAtiva). equipeId null = configuração no nível da empresa inteira.
model EmpresaConfiguracao {
  id                     Int       @id @default(autoincrement())
  empresaId              Int
  equipeId               Int?
  logoUrl                String?
  // DIA_FIXO (usa diaFechamentoFatura 1-31, com clamp em meses menores) |
  // DIA_UTIL (usa diaFechamentoFatura como Nº do dia útil, 1-10) |
  // ULTIMO_DIA_MES (ignora diaFechamentoFatura) |
  // null → compat: se diaFechamentoFatura setado, trata como DIA_FIXO; senão ULTIMO_DIA_MES (fallback)
  tipoFechamento         String?
  diaFechamentoFatura    Int? // dia do mês (DIA_FIXO) ou Nº do dia útil (DIA_UTIL)
  whatsapp               String? // WhatsApp da empresa (somente dígitos, DDD+número) — envio/recebimento de mensagens
  // Expediente de atendimento — usado para liberar horários no Agendamento.
  // diasAtendimento: CSV de dias da semana (0=Dom … 6=Sáb), ex: "1,2,3,4,5". null = todos os dias.
  // horaInicio/horaFim: "HH:MM" (ex: "08:00" / "20:00"). null = sem restrição (00:00–24:00).
  diasAtendimento        String?   @map("dias_atendimento")
  horaInicioAtendimento  String?   @map("hora_inicio_atendimento") @db.VarChar(5)
  horaFimAtendimento     String?   @map("hora_fim_atendimento") @db.VarChar(5)
  // Espécies que a empresa atende — CSV de IDs de Especie (ex: "1,2"). null/"" = todas.
  // Usado para filtrar as especialidades oferecidas no cadastro de membros/fornecedores.
  especiesAtendidas      String?   @map("especies_atendidas")
  // Tempo de consulta PADRÃO da empresa (minutos). É o que vale para a especialidade
  // que o profissional não configurou no card "Locais de trabalho" — herança dinâmica,
  // não snapshot. null = padrão do sistema (60 min).
  tempoConsultaPadraoMin Int?      @map("tempo_consulta_padrao_min")
  // Validade do ORÇAMENTO em dias (migration 20260813000000). Passado o prazo contado
  // de Orcamento.createdAt, o cron cancela o que não foi aprovado (nem parcialmente).
  // null = sem validade — o orçamento não expira.
  validadeOrcamentoDias  Int?      @map("validade_orcamento_dias")
  // Forma de cobrança do item que SAI DO ESTOQUE — medicamento e vacina
  // (migration 20261007000000): VALOR_REPASSADO | PERCENTUAL | MAIOR_VALOR | CUSTO_MEDIO.
  // `percentualCobrancaEstoque` só vale (e só é gravado) na forma PERCENTUAL.
  // null = VALOR_REPASSADO, que é o comportamento histórico — por isso a migration
  // não tem backfill. 🔴 LEITURA/ESCRITA por SQL cru (`lib/formaCobrancaEstoque.js`) — §11.
  formaCobrancaEstoque      String? @map("forma_cobranca_estoque") @db.VarChar(20)
  percentualCobrancaEstoque Float?  @map("percentual_cobranca_estoque")
  // Dispensa a etapa de EXECUÇÃO DE PRESCRIÇÃO (migration 20261023000000). true = a
  // fatura, a baixa de estoque e o pagamento do prestador saem na FINALIZAÇÃO da
  // prescrição/vacina, e o documento já nasce EXECUTADO. false (padrão) = como sempre:
  // tudo acontece na execução, no plantão.
  // 🔴 LEITURA/ESCRITA por SQL cru (`lib/etapaExecucaoPrescricao.js`) — §11.
  dispensarExecucaoPrescricao Boolean @default(false) @map("dispensar_execucao_prescricao")
  // Fuso horário da clínica (IANA, ex.: "America/Manaus") — migration 20260823000000.
  // A aplicação roda nos 4 fusos do Brasil (UTC−2 a UTC−5); sem isto o backend
  // assumia America/Sao_Paulo fixo e a fila do plantão / e-mail / WhatsApp saíam
  // 1-2h deslocados para quem está em UTC−4/−5.
  // null = America/Sao_Paulo (comportamento anterior). Ler/gravar SEMPRE por
  // lib/fusoEmpresa.js (SQL cru — ver a nota lá).
  fusoHorario            String?   @map("fuso_horario") @db.VarChar(60)
  // Evolution API — instância exclusiva de WhatsApp da clínica (migration 20260718170000).
  // waInstance: identificador da instância (nunca exposto ao frontend);
  // waStatus: DESCONECTADO | AGUARDANDO_QR | CONECTADO | ERRO.
  // NOTA: acessados via raw SQL nos services de WhatsApp enquanto o client não for regenerado.
  waInstance             String?   @unique @map("wa_instance")
  waStatus               String    @default("DESCONECTADO") @map("wa_status") @db.VarChar(30)
  waStatusEm             DateTime? @map("wa_status_em")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  equipe  Equipe? @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@unique([empresaId, equipeId])
  @@map("tb_empresa_configuracoes")
  @@schema("schs2vet")
}

// Configuração global dos alertas das tarefas agendadas (cron) — lida pelo cron.
// Linha única (a app usa/atualiza a primeira; cria se não existir).
model CronAlertaConfig {
  id               Int      @id @default(autoincrement())
  emails           String? // destinatários dos alertas (CSV). Vazio → ADMINs do sistema
  notificarSucesso Boolean  @default(true) // false = só envia e-mail em erros
  ativo            Boolean  @default(true) // liga/desliga o envio de e-mail dos alertas
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("tb_cron_alerta_config")
  @@schema("schs2vet")
}

// Histórico de execuções das tarefas agendadas (para a tela de Monitoração).
// Registra eventos relevantes: erros e execuções que fizeram trabalho.
model CronExecucao {
  id          Int      @id @default(autoincrement())
  nome        String // nome legível da tarefa
  ok          Boolean // true = sucesso, false = erro
  resumo      String?  @db.Text
  erro        String?  @db.Text
  notificado  Boolean  @default(false) // e-mail de alerta foi enviado?
  // Como a tarefa foi disparada: AUTOMATICA (agenda do node-cron) ou MANUAL (botao
  // "Executar agora" da tela de Configuracao). Sem isto, log de teste e execucao de
  // producao ficam indistinguiveis no historico.
  origem      String   @default("AUTOMATICA") @db.VarChar(12)
  /// Duracao em milissegundos — e o que denuncia o job que passou a demorar demais.
  duracaoMs   Int?
  executadoEm DateTime @default(now())

  @@index([executadoEm])
  @@index([nome, executadoEm])
  @@map("tb_cron_execucoes")
  @@schema("schs2vet")
}

// Agenda (horário) de cada tarefa agendada — editável pelo ADMIN e aplicada ao
// vivo (reagendamento dinâmico do node-cron). `chave` identifica o job no código.
model CronAgenda {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  nome      String
  cronExpr  String // expressão cron de 5 campos (min hora dia mês diaSemana)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_cron_agenda")
  @@schema("schs2vet")
}

// Catálogo de "itens frequentes" da fatura, reutilizáveis em novas faturas.
// Escopado por empresa (empresaId null = global/legado). Sem FK (igual AuditLog)
// para não acoplar a exclusão da empresa.
model FaturaItemCatalogo {
  id          Int      @id @default(autoincrement())
  empresaId   Int      @map("empresa_id")
  tipo        String // ASSISTENCIA | MEDICAMENTO | PROCEDIMENTO
  descricao   String
  valor       Float    @default(0)
  ativo       Boolean  @default(true)
  criadoPorId Int?     @map("criado_por_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
  @@map("tb_fatura_item_catalogo")
  @@schema("schs2vet")
}

model MembroEquipe {
  id                 Int      @id @default(autoincrement())
  equipeId           Int
  userId             Int
  cargo              String
  cargos             String[] @default([])
  // Expediente de trabalho do profissional (usado pela Agenda para liberar horários).
  // null = herda o expediente da empresa (EmpresaConfiguracao).
  diasTrabalho       String?  @db.VarChar(20) // CSV 0-6 (0=Dom … 6=Sáb)
  horaInicioTrabalho String?  @db.VarChar(5) // HH:MM
  horaFimTrabalho    String?  @db.VarChar(5) // HH:MM
  // Checkbox "Atender somente no local de trabalho" (Incluir/Editar Membro). false
  // (padrão) = atende em qualquer local, comportamento de sempre — nada muda. true = a
  // listagem de animais deste profissional (lib/animalScope.js) fica restrita aos
  // animais cuja localização bate com um dos `locaisTrabalho` DELE configurados para o
  // dia de HOJE.
  restringirPorLocal Boolean  @default(false) @map("restringir_por_local")
  createdAt          DateTime @default(now())

  equipe         Equipe                @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  locaisTrabalho MembroLocalTrabalho[]

  @@unique([equipeId, userId])
  @@index([userId])
  @@map("tb_membros_equipe")
  @@schema("schs2vet")
}

// Local de trabalho do membro na empresa. Um membro pode ter VÁRIOS locais, cada um
// com dias e horário próprios (ex: atende no CENTRO HIPICO seg/qua manhã e no CENTAURO
// ter/qui tarde). Os campos de expediente em MembroEquipe seguem existindo como
// AGREGADO (união dos dias, faixa min–max) — a Agenda ainda os lê; ver EquipeController.
model MembroLocalTrabalho {
  id                 Int      @id @default(autoincrement())
  membroEquipeId     Int      @map("membro_equipe_id")
  localizacaoId      Int      @map("localizacao_id")
  diasTrabalho       String?  @db.VarChar(20) // CSV 0-6 (0=Dom … 6=Sáb)
  horaInicioTrabalho String?  @db.VarChar(5) // HH:MM
  horaFimTrabalho    String?  @db.VarChar(5) // HH:MM
  especialidadesIds  String?  @db.VarChar(255) // CSV de IDs de tb_especialidades (por local)
  // Tempo de consulta POR especialidade NESTE local: { "<especialidadeId>": minutos }.
  // Toda especialidade em `especialidadesIds` tem entrada aqui (obrigatório na app).
  // É o que define o passo da grade de horários — ver AgendamentoController.
  temposConsulta     Json?    @map("tempos_consulta")
  createdAt          DateTime @default(now())

  membro      MembroEquipe      @relation(fields: [membroEquipeId], references: [id], onDelete: Cascade)
  localizacao LocalizacaoAnimal @relation(fields: [localizacaoId], references: [id], onDelete: Cascade)

  @@index([membroEquipeId])
  @@index([localizacaoId])
  @@map("tb_membro_locais_trabalho")
  @@schema("schs2vet")
}

model ConviteEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int
  email     String
  cargo     String
  token     String   @unique @default(uuid())
  status    String   @default("PENDENTE")
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Acordo definido pelo gestor AO CONVIDAR — aplicado ao vínculo quando o convite
  // é aceito (ver UsuarioEmpresa). Sem isto, quem entra por convite nasceria sem
  // remuneração e o campo só seria obrigatório na inclusão direta.
  tipoPagamento  String? @map("tipo_pagamento") @db.VarChar(10)
  formaPagamento String? @map("forma_pagamento") @db.VarChar(10)
  valorPagamento Float?  @map("valor_pagamento")
  acessoSistema  Boolean @default(true) @map("acesso_sistema")

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId])
  @@map("tb_convites_equipe")
  @@schema("schs2vet")
}

// Catálogo imutável de módulos e ações do sistema.
// Populado via seed — NUNCA alterado em runtime.
model ModuloSistema {
  id        Int    @id @default(autoincrement())
  slug      String @unique // "atendimento.evolucoes.criar"
  modulo    String @db.VarChar(50) // "atendimento"
  submodulo String @db.VarChar(50) // "evolucoes"
  acao      String @db.VarChar(50) // "criar"
  label     String @db.VarChar(150) // "Evoluções — Criar"
  ordemExib Int    @default(0)

  permissoes   PermissaoMembro[]
  matrizPerfis MatrizPerfil[]

  @@map("tb_modulos_sistema")
  @@schema("schs2vet")
}

// Matriz real de permissões — uma linha por (equipeId, userId, moduloSlug).
// nivel: NENHUM | LEITURA | PROPRIO | EQUIPE | FULL
model PermissaoMembro {
  id            Int      @id @default(autoincrement())
  equipeId      Int
  userId        Int
  moduloSlug    String   @db.VarChar(100)
  nivel         String   @default("LEITURA") @db.VarChar(20)
  atualizadoPor Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipe Equipe        @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modulo ModuloSistema @relation(fields: [moduloSlug], references: [slug])

  @@unique([equipeId, userId, moduloSlug])
  @@index([equipeId, userId])
  @@map("tb_permissoes_membros")
  @@schema("schs2vet")
}

// Log imutável de alterações de permissão.
// Sem FKs deletáveis — deve persistir mesmo se user for removido.
model AuditoriaPermissao {
  id              Int      @id @default(autoincrement())
  equipeId        Int
  equipeNome      String   @db.VarChar(150)
  alvoUserId      Int
  alvoUserNome    String   @db.VarChar(255)
  alvoUserEmail   String   @db.VarChar(255)
  moduloSlug      String   @db.VarChar(100)
  moduloLabel     String   @db.VarChar(150)
  nivelAnterior   String?  @db.VarChar(20)
  nivelNovo       String   @db.VarChar(20)
  alteradoPorId   Int
  alteradoPorNome String   @db.VarChar(255)
  motivo          String?  @db.Text
  ipOrigem        String?  @db.VarChar(45)
  createdAt       DateTime @default(now())

  @@index([equipeId])
  @@index([alvoUserId])
  @@index([alteradoPorId])
  @@index([createdAt])
  @@map("tb_auditoria_permissoes")
  @@schema("schs2vet")
}

// Perfis (cargos) explícitos por equipe — existem independentemente de membros.
// Permite criar e configurar um perfil antes de associar qualquer membro.
model PerfilEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int
  slug      String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipe Equipe         @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  matriz MatrizPerfil[]

  @@unique([equipeId, slug])
  @@index([equipeId])
  @@map("tb_perfis_equipe")
  @@schema("schs2vet")
}

// Matriz de permissões template por perfil — independente de membros.
// Quando um membro é adicionado/tem cargo alterado, essa matriz é copiada para PermissaoMembro.
model MatrizPerfil {
  id         Int     @id @default(autoincrement())
  equipeId   Int
  perfilSlug String  @db.VarChar(50)
  moduloSlug String  @db.VarChar(100)
  nivel      String  @default("NENHUM") @db.VarChar(20)
  locked     Boolean @default(false)

  perfil PerfilEquipe  @relation(fields: [equipeId, perfilSlug], references: [equipeId, slug], onDelete: Cascade)
  modulo ModuloSistema @relation(fields: [moduloSlug], references: [slug])

  @@unique([equipeId, perfilSlug, moduloSlug])
  @@index([equipeId, perfilSlug])
  @@map("tb_matriz_perfis")
  @@schema("schs2vet")
}

// Permissões especiais liberadas para proprietários pelo veterinário gestor.
// Por padrão todas são false — habilitadas sob demanda.
// funcionalidade: "ver_prontuario" | "ver_exames" | "ver_faturas" | "agendar"
model PermissaoProprietario {
  id             Int      @id @default(autoincrement())
  equipeId       Int
  userId         Int // userId do proprietário
  funcionalidade String   @db.VarChar(50)
  habilitado     Boolean  @default(false)
  atualizadoPor  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([equipeId, userId, funcionalidade])
  @@index([equipeId, userId])
  @@map("tb_permissoes_proprietarios")
  @@schema("schs2vet")
}

// =============================================================================
// ÍNDICE CRMV (scraping diário do SISCAD/CFMV)
// =============================================================================

// Veterinários ATIVOS encontrados no SISCAD — varredura SEQUENCIAL do NÚMERO de
// inscrição (não mais busca por nome, ver crmvScraperService.js). Guardado EM CLARO
// (nome + número) de propósito: reverte a política anterior ("nunca em claro", só
// hash) — sem o nome em claro não dá pra reportar QUEM mudou no diff diário, que é
// o pedido explícito do job (decisão de 2026-08-20).
model CrmvValido {
  id            Int       @id @default(autoincrement())
  numero        Int
  uf            String    @db.VarChar(2)
  nome          String    @db.VarChar(200)
  classe        String?   @db.VarChar(10)
  dataInscricao DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([numero, uf])
  @@index([uf])
  @@map("tb_crmv_validos")
  @@schema("schs2vet")
}

// Log de cada execução do scraper
model CrmvSyncLog {
  id               Int      @id @default(autoincrement())
  executadoEm      DateTime @default(now()) @db.Timestamptz
  totalRegistros   Int      @default(0)
  totalAdicionados Int      @default(0)
  totalRemovidos   Int      @default(0)
  duracao          Int? // segundos
  sucesso          Boolean  @default(true)
  erro             String?  @db.Text

  @@map("tb_crmv_sync_log")
  @@schema("schs2vet")
}

// =============================================================================
// FARMÁCIA — CATÁLOGO GLOBAL + ESTOQUE POR CLÍNICA
// =============================================================================

// Catálogo global de medicamentos (compartilhado entre clínicas)
model Medicamento {
  id                Int      @id @default(autoincrement())
  nome              String   @db.VarChar(90)
  formaFarmaceutica String   @db.VarChar(255)
  unidade           String   @db.VarChar(100)
  apresentacao      String   @db.VarChar(255)
  classificacao     String?  @db.VarChar(255)
  fabricante        String?  @db.VarChar(150)
  controlado        Boolean  @default(false)
  // 🔴 MULTIDOSE (migration 20261009000000): a embalagem rende N aplicações. Fica no
  // ITEM porque é propriedade DELE, não do fornecedor — e a tela de Produtos, que é
  // quem o informa, deixou de pedir fornecedor. Só a CÓPIA da empresa é escrita
  // (copy-on-write em `lib/catalogoEmpresa.js`); o catálogo global nunca é marcado.
  // ⚠️ `dosesPorEmbalagem` NULL não é 1: com NULL a regra não entra em vigor, e
  // tratá-lo como 1 afirmaria "o frasco é dose única".
  // 🔴 O SIGNIFICADO MUDOU EM 2026-09-16: `dosesPorEmbalagem` era "N aplicações por
  // frasco, desconta 1/N"; passa a ser QUANTO a embalagem contém, na `formaCalculo`
  // (frasco de 20 mL → 20). O nome da coluna ficou (mesmo precedente de
  // `tb_procedimento_combos.valor`) — renomear obrigaria a tocar todos os leitores
  // sem ganhar nada. Leia-o SEMPRE por `lib/formaCalculo.js#qtdPorEmbalagemDe`.
  // ⚠️ `formaCalculo` é a unidade do CONTEÚDO (mL, g, doses…); `unidade`, acima, é a da
  // EMBALAGEM ("Frasco", "Un."). Confundir as duas faz 5 mL virarem 5 frascos.
  multidose         Boolean  @default(false)
  dosesPorEmbalagem Float?   @map("doses_por_embalagem")
  formaCalculo      String?  @map("forma_calculo") @db.VarChar(20)
  // null = catálogo global (ADMIN); setado = medicamento próprio da empresa
  // (criado por item manual de orçamento) — só a empresa dona vê/edita.
  empresaId         Int?     @map("empresa_id")
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vias        MedicamentoVia[]
  especies    MedicamentoEspecie[]
  estoques    EstoqueClinica[]
  prescricoes Prescricao[]         @relation("MedicamentoPrescricoes")
  lotes       LoteVacina[]         @relation("MedicamentoLotes")

  @@index([nome])
  @@index([ativo])
  @@index([controlado])
  @@index([empresaId])
  @@map("tb_medicamentos")
  @@schema("schs2vet")
}

// Espécies para as quais o medicamento é indicado (relação N:N)
model MedicamentoEspecie {
  id            Int @id @default(autoincrement())
  medicamentoId Int
  especieId     Int

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  especie     Especie     @relation(fields: [especieId], references: [id], onDelete: Cascade)

  @@unique([medicamentoId, especieId])
  @@index([medicamentoId])
  @@index([especieId])
  @@map("tb_medicamento_especies")
  @@schema("schs2vet")
}

// Vias de administração vinculadas ao catálogo
model MedicamentoVia {
  id            Int    @id @default(autoincrement())
  medicamentoId Int
  via           String @db.VarChar(255)

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)

  @@unique([medicamentoId, via])
  @@index([medicamentoId])
  @@map("tb_medicamento_vias")
  @@schema("schs2vet")
}

// Estoque por clínica (uma linha = um medicamento em uma clínica)
model EstoqueClinica {
  id                Int       @id @default(autoincrement())
  medicamentoId     Int
  empresaId         Int
  valor             Float     @default(0) // preço de compra
  valorRepassado    Float     @default(0) @map("valor_repassado")
  precoUnitarioBase Float?    @map("preco_unitario_base") // R$/g ou R$/mL — fixo na entrada
  lote              String?   @db.VarChar(100)
  validade          DateTime?
  qtdEstoque        Float     @default(0)
  qtdEmbalagens     Int?      @map("qtd_embalagens") // nº de embalagens da(s) entrada(s)
  pesoPorEmbalagem  Float?    @map("peso_por_embalagem") // peso/vol por embalagem (unidade do catálogo)
  estoqueMinimo     Float     @default(0) // alerta vermelho
  estoqueAlarmante  Float     @default(0) // alerta amarelo
  ativo             Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de
  // `Fornecedor` (migration 20260828000000_estoque_ativacao_trilha). Sem FK
  // cascade: excluir quem fez a ação não apaga nem destrava o registro afetado.
  ativoEm           DateTime? @map("ativo_em")
  ativoPorId        Int?      @map("ativo_por_id")
  inativoEm         DateTime? @map("inativo_em")
  inativoPorId      Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000001) — obrigatória em
  // EstoqueController.toggle, exibida na aba Inativos.
  inativoMotivo     String?   @map("inativo_motivo") @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fornecedorId Int?    @map("fornecedor_id")
  notaFiscal   String? @map("nota_fiscal") @db.VarChar(100)

  medicamento Medicamento        @relation(fields: [medicamentoId], references: [id])
  empresa     Empresa            @relation("EmpresaEstoque", fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedor  Fornecedor?        @relation("FornecedorEstoque", fields: [fornecedorId], references: [id], onDelete: SetNull)
  movimentos  MovimentoEstoque[]
  reservas    ReservaEstoque[]   @relation("EstoqueReservas")

  @@index([medicamentoId])
  @@index([empresaId])
  @@index([fornecedorId])
  @@index([ativo])
  @@map("tb_estoque_clinica")
  @@schema("schs2vet")
}

// Movimentações de estoque por clínica
model MovimentoEstoque {
  id         Int      @id @default(autoincrement())
  estoqueId  Int
  tipo       String   @db.VarChar(20) // ENTRADA | SAIDA | AJUSTE
  quantidade Float
  motivo     String?  @db.Text
  createdAt  DateTime @default(now())

  estoque EstoqueClinica @relation(fields: [estoqueId], references: [id], onDelete: Cascade)

  @@index([estoqueId])
  @@index([createdAt])
  @@map("tb_movimentos_estoque")
  @@schema("schs2vet")
}

// =============================================================================
// CADASTRO — TRATADOR
// =============================================================================

model Tratador {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(255)
  telefone      String?   @db.VarChar(30)
  localizacaoId Int?      @map("localizacao_id")
  tipoEntrada   String    @default("CLIENTE") @map("tipo_entrada") @db.VarChar(10)
  ativo         Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de Fornecedor/
  // Prestador (migration 20260825000000), replicada aqui (migration 20260826000000).
  // Sem FK cascade: excluir quem fez a ação não apaga nem destrava o registro afetado.
  ativoEm       DateTime? @map("ativo_em")
  ativoPorId    Int?      @map("ativo_por_id")
  inativoEm     DateTime? @map("inativo_em")
  inativoPorId  Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000000) — obrigatória em
  // TratadorController.toggleAtivo, exibida na aba Inativos.
  inativoMotivo String?   @map("inativo_motivo") @db.Text
  // SYSTEM (ADMIN) e registros legados: empresaId/equipeId null = visível para todos.
  // CLIENTE novo: escopado à empresa/equipe ativa (req.empresaId/req.equipeId) de quem criou.
  empresaId     Int       @map("empresa_id") // sem FK — sobrevive à exclusão da empresa
  equipeId      Int?      @map("equipe_id")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  localizacao LocalizacaoAnimal? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  equipe      Equipe?            @relation("EquipeTratadores", fields: [equipeId], references: [id], onDelete: SetNull)
  animais     Animal[]

  @@index([localizacaoId])
  @@index([empresaId])
  @@index([equipeId])
  @@map("tb_tratadores")
  @@schema("schs2vet")
}

model Fornecedor {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(255)
  cpf           String?   @db.VarChar(20)
  cnpj          String?   @db.VarChar(20)
  telefone      String?   @db.VarChar(30) // obrigatório na app (nullable p/ legado)
  email         String?   @db.VarChar(255) // obrigatório na app (nullable p/ legado) — usado p/ vincular ao User
  tipoServico   String    @map("tipo_servico") @db.VarChar(50)
  tipoEntrada   String    @default("CLIENTE") @map("tipo_entrada") @db.VarChar(10)
  // Vencimento da CONTA A PAGAR deste credor (migration 20261020000000) — a mesma
  // forma do fechamento da fatura no cadastro da empresa: uma FORMA (DIA_FIXO |
  // DIA_UTIL | ULTIMO_DIA_MES) e o número que só faz sentido dentro dela. NULL = o
  // credor não declarou vencimento, e a conta dele nunca atrasa.
  // LEITURA/ESCRITA: sempre por `lib/vencimentoCredor.js`.
  tipoVencimento String?  @map("tipo_vencimento") @db.VarChar(20)
  diaVencimento  Int?     @map("dia_vencimento")
  cep           String?   @db.VarChar(10)
  endereco      String?   @db.VarChar(500)
  complemento   String?   @db.VarChar(255)
  bairro        String?   @db.VarChar(255)
  cidade        String?   @db.VarChar(255)
  estado        String?   @db.VarChar(2)
  ativo         Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de `User`
  // (migration 20260824000000_user_ativacao_trilha), replicada aqui (migration
  // 20260825000000). Sem FK cascade: excluir quem fez a ação não apaga nem
  // destrava o registro afetado.
  ativoEm       DateTime? @map("ativo_em")
  ativoPorId    Int?      @map("ativo_por_id")
  inativoEm     DateTime? @map("inativo_em")
  inativoPorId  Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000000) — obrigatória em
  // FornecedorController.toggleAtivo, exibida na aba Inativos.
  inativoMotivo String?   @map("inativo_motivo") @db.Text
  // SYSTEM (ADMIN) e registros legados: empresaId/equipeId null = visível para todos.
  // CLIENTE novo: escopado à empresa/equipe ativa (req.empresaId/req.equipeId) de quem criou.
  empresaId     Int?      @map("empresa_id") // sem FK — sobrevive à exclusão da empresa
  equipeId      Int?      @map("equipe_id")
  userId        Int?      @unique @map("user_id") // conta de login (User FORNECEDOR) — dá ao prestador o tipoServico
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user           User?                     @relation("FornecedorUser", fields: [userId], references: [id], onDelete: SetNull)
  estoques       EstoqueClinica[]          @relation("FornecedorEstoque")
  equipe         Equipe?                   @relation("EquipeFornecedores", fields: [equipeId], references: [id], onDelete: SetNull)
  especialidades FornecedorEspecialidade[]

  @@index([empresaId])
  @@index([equipeId])
  @@map("tb_fornecedores")
  @@schema("schs2vet")
}

// Prestadores de serviço — catálogo PRÓPRIO e INDEPENDENTE de Fornecedor (2026-08-14).
// Mesma forma de cadastro (nome, documento, contato, tipo de serviço, endereço) e o
// mesmo tratamento SYSTEM×CLIENTE, mas em tabela e RLS próprios — dado de prestador
// não compartilha linha com fornecedor. `empresaId`/`equipeId` SEM FK, de propósito
// (igual Fornecedor.empresaId): sobrevivem à exclusão da empresa/equipe.
model Prestador {
  id             Int       @id @default(autoincrement())
  nome           String    @db.VarChar(255)
  cpf            String?   @db.VarChar(20)
  cnpj           String?   @db.VarChar(20)
  telefone       String?   @db.VarChar(30)
  email          String?   @db.VarChar(255)
  // VÁRIOS tipos de serviço por prestador (migration 20261010000000), gravados como
  // CSV nesta MESMA coluna — é o formato que os leitores já esperam
  // (`EncaminhamentoController` faz `tipoServico.split(',')`). Por isso a coluna
  // ALARGOU de 50 para 255 em vez de virar tabela: 50 não comporta quatro atuações
  // ("Fisioterapeuta, Quiroprata, Radiologista" já ocupa 40), e passar do limite NÃO
  // dá erro de validação — dá `value too long` do Postgres, que é a armadilha do
  // status VARCHAR(20) registrada no CLAUDE.md.
  // ⚠️ `Fornecedor.tipoServico` continua VarChar(50): lá o campo é DERIVADO da 1ª
  // especialidade (`FornecedorEspecialidade`), nunca uma lista digitada.
  tipoServico    String    @map("tipo_servico") @db.VarChar(255)
  tipoEntrada    String    @default("CLIENTE") @map("tipo_entrada") @db.VarChar(10)
  // Vencimento da CONTA A PAGAR deste prestador — ver a nota gêmea em `Fornecedor`.
  tipoVencimento String?   @map("tipo_vencimento") @db.VarChar(20)
  diaVencimento  Int?      @map("dia_vencimento")
  cep            String?   @db.VarChar(10)
  endereco       String?   @db.VarChar(500)
  complemento    String?   @db.VarChar(255)
  bairro         String?   @db.VarChar(255)
  cidade         String?   @db.VarChar(255)
  estado         String?   @db.VarChar(2)
  ativo          Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de `User`/
  // `Fornecedor` (migration 20260825000000). Sem FK cascade.
  ativoEm        DateTime? @map("ativo_em")
  ativoPorId     Int?      @map("ativo_por_id")
  inativoEm      DateTime? @map("inativo_em")
  inativoPorId   Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000000) — obrigatória em
  // PrestadorController.toggleAtivo, exibida na aba Inativos.
  inativoMotivo  String?   @map("inativo_motivo") @db.Text
  empresaId      Int?      @map("empresa_id")
  equipeId       Int?      @map("equipe_id")
  // Login opcional, SEM MembroEquipe (decisão de 2026-08-21 revista): dá para logar,
  // mas sem RBAC — quem precisa de tela de verdade continua indo por Equipe > Incluir
  // Membro (cargo Fornecedor). Ver §5 do plano "Prestador: pagamento/local/acesso".
  userId         Int?      @unique @map("user_id")
  tipoPagamento  String?   @map("tipo_pagamento") @db.VarChar(20)
  formaPagamento String?   @map("forma_pagamento") @db.VarChar(20)
  valorPagamento Float?    @map("valor_pagamento")
  acessoSistema  Boolean   @default(false) @map("acesso_sistema")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User?                    @relation("PrestadorUser", fields: [userId], references: [id], onDelete: SetNull)
  procedimentos  ProcedimentoPrestador[]  @relation("PrestadorProcedimentos")
  locaisTrabalho PrestadorLocalTrabalho[]

  @@index([empresaId])
  @@index([equipeId])
  @@map("tb_prestadores")
  @@schema("schs2vet")
}

// Local(is) de trabalho do Prestador — irmã de MembroLocalTrabalho, mais simples
// (sem especialidade/tempo de consulta: Prestador não entra na Agenda nem tem
// catálogo de especialidade próprio). empresaId/equipeId são denormalizados do
// Prestador pai só para a policy de RLS.
model PrestadorLocalTrabalho {
  id                 Int      @id @default(autoincrement())
  prestadorId        Int      @map("prestador_id")
  localizacaoId      Int      @map("localizacao_id")
  diasTrabalho       String?  @map("dias_trabalho") @db.VarChar(20)
  horaInicioTrabalho String?  @map("hora_inicio_trabalho") @db.VarChar(5)
  horaFimTrabalho    String?  @map("hora_fim_trabalho") @db.VarChar(5)
  empresaId          Int?     @map("empresa_id")
  equipeId           Int?     @map("equipe_id")
  createdAt          DateTime @default(now()) @map("created_at")

  prestador   Prestador         @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  localizacao LocalizacaoAnimal @relation(fields: [localizacaoId], references: [id], onDelete: Cascade)

  @@index([prestadorId])
  @@index([localizacaoId])
  @@map("tb_prestador_locais_trabalho")
  @@schema("schs2vet")
}

// Catálogo de "tipo de fornecedor" (categoria FORNECEDOR) e "tipo de serviço do
// prestador" (categoria PRESTADOR) — cresce por uso: quando alguém digita um
// tipo novo no cadastro, ele é gravado aqui e passa a aparecer como opção nas
// próximas vezes. TENANT DIRETO (mesma policy de tb_fornecedores/tb_prestadores,
// migration 20260825000000): cada empresa só vê/cria os PRÓPRIOS tipos —
// nenhuma leitura cross-tenant aqui, mesmo para o "type ahead" do formulário.
// ADMIN (escopo de plataforma) grava com empresaId null.
model CatalogoTipoServico {
  id          Int      @id @default(autoincrement())
  categoria   String   @db.VarChar(20) // 'FORNECEDOR' | 'PRESTADOR'
  nome        String   @db.VarChar(100)
  empresaId   Int?     @map("empresa_id")
  criadoPorId Int?     @map("criado_por_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([categoria, empresaId])
  @@map("tb_catalogo_tipo_servico")
  @@schema("schs2vet")
}

// Reservas de estoque vinculadas a prescrições finalizadas (aguardando execução)
model ReservaEstoque {
  id                Int      @id @default(autoincrement())
  estoqueId         Int
  prescricaoGrupoId Int
  animalId          Int
  quantidade        Float
  criadoEm          DateTime @default(now())

  estoque         EstoqueClinica  @relation("EstoqueReservas", fields: [estoqueId], references: [id], onDelete: Cascade)
  prescricaoGrupo PrescricaoGrupo @relation("GrupoReservas", fields: [prescricaoGrupoId], references: [id], onDelete: Cascade)
  animal          Animal          @relation("AnimalReservas", fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([prescricaoGrupoId, estoqueId])
  @@index([estoqueId])
  @@map("tb_reservas_estoque")
  @@schema("schs2vet")
}

// Reserva de doses de VACINA — espelho de `ReservaEstoque` (prescrição/medicamento),
// mesma lógica: criada ao FINALIZAR (SALVA→FINALIZADA) via FEFO entre os lotes do
// medicamento/vacina do catálogo, respeitando o que já está reservado por OUTRAS
// vacinas; consumida (debitada de verdade em `LoteVacina.qtdDisponivel`) ao EXECUTAR;
// liberada sem debitar ao CANCELAR antes da execução. Migration 20260830000000.
// Não existe para o quadrante cliente:true (nunca debita) nem para
// aplicadaPeloProprietario×!cliente (debita direto na FINALIZAÇÃO, sem passar pelo
// plantão — não há intervalo "reservado, aguardando execução" para essa vacina).
model ReservaEstoqueVacina {
  id              Int      @id @default(autoincrement())
  loteVacinaId    Int
  vacinaClinicaId Int
  animalId        Int
  // Float desde 2026-09-16: a reserva acompanha a dosagem, que passou a ser medida na
  // forma de cálculo (2,5 mL). Inteiro truncaria a fração em silêncio.
  quantidade      Float
  criadoEm        DateTime @default(now())

  loteVacina    LoteVacina    @relation("LoteVacinaReservas", fields: [loteVacinaId], references: [id], onDelete: Cascade)
  vacinaClinica VacinaClinica @relation("VacinaReservas", fields: [vacinaClinicaId], references: [id], onDelete: Cascade)
  animal        Animal        @relation("AnimalReservasVacina", fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([vacinaClinicaId, loteVacinaId])
  @@index([loteVacinaId])
  @@map("tb_reservas_estoque_vacina")
  @@schema("schs2vet")
}

