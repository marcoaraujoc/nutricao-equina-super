// =============================================================================
// S2Vet — Prisma Schema
// Provider : PostgreSQL
// Schema   : schs2vet
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["schs2vet"]
}

// =============================================================================
// USUÁRIOS
// =============================================================================

model User {
  id                        Int                     @id @default(autoincrement())
  fullName                  String                  @db.VarChar(255)
  email                     String                  @unique @db.VarChar(255)
  passwordHash              String                  @db.VarChar(255)
  phone                     String?                 @db.VarChar(30)
  phone2                    String?                 @db.VarChar(30)
  role                      String                  @default("USER") @db.VarChar(50)
  userType                  String                  @default("PROPRIETARIO") @db.VarChar(50)
  cep                       String?                 @db.VarChar(10)
  endereco                  String?                 @db.VarChar(255)
  complemento               String?                 @db.VarChar(100)
  bairro                    String?                 @db.VarChar(100)
  cidade                    String?                 @db.VarChar(100)
  estado                    String?                 @db.VarChar(2)
  createdAt                 DateTime                @default(now())
  ativo                     Boolean                 @default(true)
  // Trilha de quem ATIVOU/INATIVOU este usuário e quando (migration
  // 20260824000000) — `ativo` sozinho só diz o estado ATUAL. Sem FK cascade:
  // excluir quem fez a ação não pode apagar nem destravar o estado do usuário
  // afetado (mesmo padrão de `Animal.inativoPorId`).
  ativoEm                   DateTime?               @map("ativo_em")
  ativoPorId                Int?                    @map("ativo_por_id")
  inativoEm                 DateTime?               @map("inativo_em")
  inativoPorId              Int?                    @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000000) — obrigatória no
  // endpoint (EquipeController.toggleMembro), exibida na aba Inativos da Equipe.
  inativoMotivo             String?                 @map("inativo_motivo") @db.Text
  resetPasswordToken        String?                 @unique @db.VarChar(255)
  resetPasswordExpires      DateTime?
  mustChangePassword        Boolean                 @default(false)
  isConvidado               Boolean                 @default(false)
  refreshToken              String?                 @db.VarChar(512)
  // Contador de geração de sessão. Todo login (senha, 2FA, Google) INCREMENTA e
  // grava no access token (`sessionTokens.js#assinarAccessToken`); `authenticate`
  // compara a cada requisição contra o valor do banco — divergiu, o token é de um
  // login anterior e cai na hora (não espera os ~30min do access expirar). Refresh
  // NÃO incrementa (é o mesmo dispositivo continuando a sessão, não um login novo).
  sessionVersion            Int                     @default(0) @map("session_version")
  // 2FA por e-mail no login com senha. Ligado por padrão; desligar por usuário
  // aqui, ou globalmente via MFA_EMAIL_ENABLED=false (kill-switch de emergência).
  mfaAtivo                  Boolean                 @default(true) @map("mfa_ativo")
  // Bloqueio de conta por senha errada (migration 20260915000000). O contador mora
  // AQUI, e não por empresa, porque a credencial é global — contar por empresa daria
  // 6 tentativas em CADA uma. `bloqueadoEm` null = liberada; sem expiração
  // automática de propósito: o desbloqueio é um ato de alguém e deixa rastro.
  // Leitura/escrita SEMPRE por `lib/bloqueioLogin.js`.
  tentativasLogin           Int                     @default(0) @map("tentativas_login")
  bloqueadoEm               DateTime?               @map("bloqueado_em")
  mfaDesafios               MfaDesafio[]            @relation("UserMfaDesafios")
  configSegurancaAtualizada ConfiguracaoSeguranca[] @relation("ConfigSegurancaAtualizadoPor")
  cpf                       String?                 @db.VarChar(14)
  cnpj                      String?                 @db.VarChar(18)
  mensalista                Boolean                 @default(false)
  valorAssistencia          Float?
  frequenciaVisitas         Int?
  // Dia do mês (1-28) em que a fatura vence. Fatura FECHADA não paga após o
  // vencimento (dia do mês SEGUINTE ao mesReferencia) é considerada ATRASADA.
  diaVencimentoFatura       Int?                    @map("dia_vencimento_fatura")
  empresaId                 Int?                    @map("empresa_id")
  equipeId                  Int?                    @map("equipe_id") // equipe que cadastrou o proprietário (segregação por equipe)

  empresa                        Empresa?                      @relation("ProprietarioEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)
  equipe                         Equipe?                       @relation("ProprietarioEquipe", fields: [equipeId], references: [id], onDelete: SetNull)
  animais                        Animal[]
  animaisInativados              Animal[]                      @relation("AnimalInativadoPor")
  auditLogs                      AuditLog[]
  dietasCriadas                  Dieta[]                       @relation("CriadorDieta")
  dietasModificadas              Dieta[]                       @relation("ModificadorDieta")
  evolucoesCriadas               EvolucaoClinica[]             @relation("EvolucaoVeterinario")
  evolucoesModificadas           EvolucaoClinica[]             @relation("EvolucaoModificadoPor")
  prescricoes                    Prescricao[]                  @relation("PrescricaoVeterinario")
  prescricaoDosesExecutadas      PrescricaoExecucaoDose[]      @relation("PrescricaoDoseExecutadaPor")
  prescricaoGrupos               PrescricaoGrupo[]             @relation("PrescricaoGrupoVet")
  prescricaoGruposFinalizou      PrescricaoGrupo[]             @relation("PrescricaoGrupoFinaliza")
  prescricaoGruposExecutou       PrescricaoGrupo[]             @relation("PrescricaoGrupoExecuta")
  vacinas                        VacinaClinica[]               @relation("VacinaVeterinario")
  encaminhamentos                EncaminhamentoClinico[]       @relation("EncaminhamentoVeterinario")
  examesClinicos                 ExameClinico[]                @relation("ExameClinicoVeterinario")
  faturaItens                    FaturaItem[]                  @relation("FaturaItemVet")
  faturas                        Fatura[]                      @relation("FaturaProprietario")
  faturaLinksPublicos            FaturaLinkPublico[]           @relation("FaturaLinkProprietario")
  faturaLinksRevogados           FaturaLinkPublico[]           @relation("FaturaLinkRevogadoPor")
  aiUsageLogs                    AiUsageLog[]
  vetPerfil                      VetPerfil?
  especialidades                 UsuarioEspecialidade[]
  empresasOwner                  Empresa[]                     @relation("EmpresaOwner")
  membrosEquipe                  MembroEquipe[]
  permissoesMembro               PermissaoMembro[]
  permissoesProprietario         PermissaoProprietario[]
  proprietarioPerfis             ProprietarioPerfil[]          @relation("ProprietarioPerfilUser")
  proprietarioLocalidades        ProprietarioLocalidade[]      @relation("ProprietarioLocalidadeUser")
  profissionalPerfis             ProfissionalPerfil[]          @relation("ProfissionalPerfilUser")
  empresasVinculadas             UsuarioEmpresa[]              @relation("UsuarioEmpresaUser")
  fornecedorPerfil               Fornecedor?                   @relation("FornecedorUser")
  prestadorPerfil                Prestador?                    @relation("PrestadorUser")
  encaminhamentosRecebidos       EncaminhamentoClinico[]       @relation("EncaminhamentoPrestador")
  designacoesComoPrestador       DesignacaoPrestador[]         @relation("DesignacaoPrestadorUser")
  designacoesCriadas             DesignacaoPrestador[]         @relation("DesignacaoCriadoPor")
  agendamentosComoVet            AgendamentoClinico[]          @relation("AgendamentoVeterinario")
  agendamentosCriados            AgendamentoClinico[]          @relation("AgendamentoCriadoPor")
  agendamentosPerdidos           AgendamentoClinico[]          @relation("AgendamentoAssumidoDe")
  resenhasCriadas                ResenhaEquino[]               @relation("ResenhasCriadas")
  resenhasGraficasCriadas        ResenhaGrafica[]              @relation("ResenhaGraficaCriadaPor")
  passwordHistory                PasswordHistory[]
  orcamentos                     Orcamento[]                   @relation("OrcamentoProprietario")
  orcamentosCriados              Orcamento[]                   @relation("OrcamentoCriadoPor")
  animalHistoricoRegistrado      AnimalHistorico[]             @relation("AnimalHistoricoCriadoPor")
  animalPropHistComoProprietario AnimalProprietarioHistorico[] @relation("AnimalPropHistProprietario")
  animalPropHistCriados          AnimalProprietarioHistorico[] @relation("AnimalPropHistCriadoPor")
  documentoTemplates             DocumentoTemplate[]           @relation("UserDocumentoTemplates")
  documentosEmitidos             DocumentoEmitido[]            @relation("UserDocumentosEmitidos")
  ativoPor                       User?                         @relation("UserAtivoPor", fields: [ativoPorId], references: [id], onDelete: SetNull)
  inativoPor                     User?                         @relation("UserInativoPor", fields: [inativoPorId], references: [id], onDelete: SetNull)
  usuariosQueAtivou              User[]                        @relation("UserAtivoPor")
  usuariosQueInativou            User[]                        @relation("UserInativoPor")

  @@index([equipeId])
  @@map("users")
  @@schema("schs2vet")
}

// Guarda os hashes das senhas anteriores do usuário para impedir reuso (regra: a nova
// senha não pode repetir nenhuma das últimas 6 — a atual em User.passwordHash + as
// últimas 5 aqui). Populado no momento da troca (o hash ANTIGO, prestes a ser
// substituído, é inserido aqui); podado para manter só os 5 mais recentes por usuário.
model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tb_password_history")
  @@schema("schs2vet")
}

// =============================================================================
// ANIMAIS
// =============================================================================

model Animal {
  id                 Int       @id @default(autoincrement())
  nome               String    @db.Text
  peso               Float
  dataNascimento     DateTime?
  sexo               String    @db.Text
  photoUrl           String?   @db.Text
  dataCadastro       DateTime  @default(now())
  ativo              Boolean   @default(true)
  // Trilha de ATIVAÇÃO/DESATIVAÇÃO do `ativo` acima (exclusão lógica — o animal
  // some de tudo enquanto ativo=false; ver AnimalController.excluir/reativar e
  // lib/animalAtivacao.js, migration 20260827000001). Nomes DELIBERADAMENTE
  // diferentes de `inativo*` abaixo: aquele é outro recurso (bloqueio, paciente
  // continua visível) e já ocupa `inativo_em`/`inativo_por_id`.
  ativoEm            DateTime? @map("ativo_em")
  ativoPorId         Int?      @map("ativo_por_id")
  desativadoEm       DateTime? @map("desativado_em")
  desativadoPorId    Int?      @map("desativado_por_id")
  // Justificativa da EXCLUSÃO LÓGICA acima (migration 20260901000000) — NÃO
  // confundir com `inativoMotivo` abaixo, que é do bloqueio somente-leitura
  // (Animal.inativo, outro recurso). Obrigatória em AnimalController.excluir.
  desativadoMotivo   String?   @map("desativado_motivo") @db.Text
  /// CATEGORIA da inativação, de lista fechada (`lib/motivosInativacao.js`) —
  /// migration 20260919000000. É o que o relatório AGRUPA, e por isso mora em coluna
  /// própria e indexada: junto da descrição, agrupar exigiria `LIKE '%...%'`, que com
  /// curinga à esquerda não usa índice e vira Seq Scan na tabela de animais.
  /// ⚠️ NULO = legado (inativado antes desta migration, com só o texto livre) OU
  /// cascata do sistema (proprietário inativado). Não é "sem motivo".
  desativadoMotivoTipo String? @map("desativado_motivo_tipo") @db.VarChar(40)
  especieId          Int
  racaId             Int?
  userId             Int
  empresaId          Int // multi-tenant: clínica principal que gerencia este animal
  equipeId           Int? // equipe responsável dentro da empresa (segregação de permissões)
  categoriaAnimal    String?   @db.VarChar(100)
  tipoExercicio      String?   @db.VarChar(100)
  veterinarioNome    String?   @db.VarChar(255)
  veterinarioClinica String?   @db.VarChar(255)
  local              String?   @db.VarChar(255)
  baia               String?   @db.VarChar(100)
  idadeAnos          Int?
  localizacaoId      Int?      @map("localizacao_id")
  tratadorId         Int?      @map("tratador_id")
  bloqueado          Boolean   @default(false)
  bloqueioTipo       String?   @map("bloqueio_tipo") @db.VarChar(30)
  bloqueioExpira     DateTime? @map("bloqueio_expira")
  pelagem            String?   @db.VarChar(100)
  altura             String?   @db.VarChar(50)
  registroPassaporte String?   @map("registro_passaporte") @db.VarChar(100)
  numeroChip         String?   @map("numero_chip") @db.VarChar(50)
  finalidade         String?   @db.VarChar(100)
  seguradora         String?   @db.VarChar(150)
  /// Inscrito na FEI (Fédération Équestre Internationale) — migration
  /// 20261016000000. SIM/NÃO em coluna própria (e não mais texto dentro de
  /// `registro_passaporte`, que guarda o NÚMERO do registro): é o que decide
  /// elegibilidade para prova internacional e precisa ser filtrável.
  /// ⚠️ Leitura/escrita SEMPRE por `lib/animalFei.js` (SQL cru com guarda de
  /// existência da coluna) — no Windows o `prisma generate` falha com o backend
  /// rodando, e um campo desconhecido no `animal.create` derrubaria o CADASTRO
  /// INTEIRO do paciente, não só o campo novo.
  registradoFei      Boolean   @default(false) @map("registrado_fei")

  // TRANSFERÊNCIA DE PROPRIEDADE — `propriedadeDesde` é uma CÓPIA RÁPIDA da
  // `dataInicio` da janela ABERTA (dataFim=null) em `AnimalProprietarioHistorico`,
  // mantida em sincronia nos dois únicos pontos que escrevem (criação do animal e
  // `lib/transferenciaPropriedadeAnimal.js`, sempre na mesma transaction). Existe só
  // para evitar uma consulta extra em cada endpoint que precisa saber "desde quando
  // o dono ATUAL é dono" — a tabela de histórico continua sendo a fonte de verdade
  // (é dela que a exportação por dono ANTERIOR lê as janelas fechadas).
  propriedadeDesde DateTime @default(now()) @map("propriedade_desde")

  // Paciente INATIVO — somente leitura: bloqueia criação/edição de qualquer registro
  // clínico ligado a ele (evolução, prescrição, vacina, exame, encaminhamento,
  // agendamento, dieta) e a edição do próprio cadastro. DIFERENTE de `ativo` (exclusão
  // lógica — o animal SOME de tudo): aqui o animal continua visível, só travado.
  // Qualquer perfil com `animais.ativar` pode inativar (com motivo); reativar é
  // SEMPRE gestor/admin (regra fixa no controller, não configurável na matriz).
  inativo       Boolean   @default(false)
  inativoEm     DateTime? @map("inativo_em")
  inativoMotivo String?   @map("inativo_motivo") @db.Text
  inativoPorId  Int?      @map("inativo_por_id")

  especie               Especie                       @relation(fields: [especieId], references: [id])
  raca                  Raca?                         @relation(fields: [racaId], references: [id])
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inativoPor            User?                         @relation("AnimalInativadoPor", fields: [inativoPorId], references: [id], onDelete: SetNull)
  empresa               Empresa                       @relation("EmpresaAnimais", fields: [empresaId], references: [id], onDelete: Restrict)
  equipe                Equipe?                       @relation("EquipeAnimais", fields: [equipeId], references: [id], onDelete: SetNull)
  localizacao           LocalizacaoAnimal?            @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  tratador              Tratador?                     @relation(fields: [tratadorId], references: [id], onDelete: SetNull)
  dietas                Dieta[]
  exames                ExameNutricional[]
  ocorrencias           OcorrenciaSaude[]
  planosDieta           PlanoDieta[]
  relatorios            RelatorioSalvo[]
  evolucoes             EvolucaoClinica[]             @relation("AnimalEvolucoes")
  prescricoes           Prescricao[]                  @relation("AnimalPrescricoes")
  prescricaoGrupos      PrescricaoGrupo[]             @relation("AnimalPrescricaoGrupos")
  vacinas               VacinaClinica[]               @relation("AnimalVacinas")
  encaminhamentos       EncaminhamentoClinico[]       @relation("AnimalEncaminhamentos")
  examesClinicos        ExameClinico[]                @relation("AnimalExamesClinicos")
  faturas               Fatura[]                      @relation("AnimalFaturas")
  faturaItens           FaturaItem[]                  @relation("FaturaItemAnimal")
  resumosIA             ResumoAtendimentoIA[]         @relation("AnimalResumosIA")
  reservasEstoque       ReservaEstoque[]              @relation("AnimalReservas")
  reservasEstoqueVacina ReservaEstoqueVacina[]        @relation("AnimalReservasVacina")
  designacoes           DesignacaoPrestador[]         @relation("AnimalDesignacoes")
  agendamentos          AgendamentoClinico[]          @relation("AnimalAgendamentos")
  resenha               ResenhaEquino?                @relation("AnimalResenha")
  resenhasGraficas      ResenhaGrafica[]              @relation("ResenhaGraficaAnimal")
  exameImagens          ExameImagemAnexo[]            @relation("AnimalExameImagens")
  orcamentoItens        OrcamentoItem[]               @relation("OrcamentoItemAnimal")
  historico             AnimalHistorico[]             @relation("AnimalHistoricoAnimal")
  historicoPropriedade  AnimalProprietarioHistorico[]
  documentosEmitidos    DocumentoEmitido[]            @relation("AnimalDocumentosEmitidos")

  @@index([especieId])
  @@index([racaId])
  @@index([userId])
  @@index([empresaId])
  @@index([equipeId])
  @@index([localizacaoId])
  @@index([tratadorId])
  /// Índice do relatório "por que perdemos pacientes": empresa primeiro (toda
  /// consulta é escopada por tenant), depois a categoria que se agrupa.
  @@index([empresaId, desativadoMotivoTipo])
  @@map("tb_animais")
  @@schema("schs2vet")
}

// =============================================================================
// ESPÉCIES E RAÇAS
// =============================================================================

model Especie {
  id             Int                  @id @default(autoincrement())
  nome           String               @db.Text
  animais        Animal[]
  composicoes    ComposicaoAlimento[]
  racas          Raca[]
  exigenciasNRC  ExigenciasNRC[]
  vetEspecies    VetEspecie[]
  medicamentos   MedicamentoEspecie[]
  especialidades Especialidade[]

  @@map("tb_especies")
  @@schema("schs2vet")
}

model Raca {
  id        Int      @id @default(autoincrement())
  nome      String   @db.Text
  especieId Int
  animais   Animal[]
  especie   Especie  @relation(fields: [especieId], references: [id])

  @@index([especieId])
  @@map("tb_racas")
  @@schema("schs2vet")
}

// =============================================================================
// DIETAS E PLANOS
// =============================================================================

model PlanoDieta {
  id          Int      @id @default(autoincrement())
  animalId    Int
  nome        String   @db.VarChar(255)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now())

  animal Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  itens  Dieta[]

  @@map("tb_planos_dieta")
  @@schema("schs2vet")
}

model Dieta {
  id            Int       @id @default(autoincrement())
  animalId      Int
  alimentoId    Int
  qtdGramasDia  Float
  periodicidade String?   @db.Text
  unidade       String?   @db.Text
  dataInicio    DateTime  @default(now())
  dataFim       DateTime?
  horario       String?   @db.Text
  observacao    String?   @db.Text
  dataCriacao   DateTime  @default(now())
  dataAlteracao DateTime  @updatedAt
  criadopor     Int?
  modificadopor Int?
  planoDietaId  Int?

  plano           PlanoDieta? @relation(fields: [planoDietaId], references: [id])
  alimento        Alimento    @relation(fields: [alimentoId], references: [id])
  animal          Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  userCriador     User?       @relation("CriadorDieta", fields: [criadopor], references: [id], onDelete: SetNull)
  userModificador User?       @relation("ModificadorDieta", fields: [modificadopor], references: [id], onDelete: SetNull)

  @@index([alimentoId])
  @@index([animalId])
  @@index([criadopor])
  @@index([modificadopor])
  @@index([planoDietaId])
  @@map("tb_dieta")
  @@schema("schs2vet")
}

// =============================================================================
// ALIMENTOS E NUTRIENTES
// =============================================================================

model Alimento {
  id          Int                  @id @default(autoincrement())
  nome        String               @db.Text
  categoria   String               @db.Text
  fabricante  String?              @db.Text
  forma       String?              @db.Text
  unidade     String?              @db.Text
  // null = catálogo global do sistema (ADMIN); setado = alimento próprio da clínica.
  // CATÁLOGO MISTO, mesma forma de `tb_medicamentos` (migration 20261004000000).
  empresaId   Int?                 @map("empresa_id")
  ativo       Boolean              @default(true)
  composicoes ComposicaoAlimento[]
  dietas      Dieta[]

  @@index([empresaId])
  @@map("tb_alimentos")
  @@schema("schs2vet")
}

model Nutriente {
  id            Int                  @id @default(autoincrement())
  nome          String               @db.Text
  categoria     String               @db.Text
  unidadePadrao String               @db.Text
  // null = catálogo global do sistema; setado = nutriente próprio da clínica.
  empresaId     Int?                 @map("empresa_id")
  composicoes   ComposicaoAlimento[]
  exames        ExameNutricional[]
  exigenciasNRC ExigenciasNRC[]

  @@index([empresaId])
  @@map("tb_nutrientes")
  @@schema("schs2vet")
}

model ComposicaoAlimento {
  id          Int    @id @default(autoincrement())
  alimentoId  Int
  nutrienteId Int
  especieId   Int?
  valorPorKg  Float
  base        String @default("Seca") @db.VarChar(50)
  // null = composição global do sistema; setada = da clínica.
  // ⚠️ O @@unique([alimentoId, nutrienteId]) abaixo NÃO virou índice parcial por
  // empresa: o par alimenta o CÁLCULO da dieta, e duas linhas para o mesmo par
  // (uma global, uma da clínica) contariam o nutriente duas vezes. Ver a migration.
  empresaId   Int?   @map("empresa_id")

  alimento  Alimento  @relation(fields: [alimentoId], references: [id])
  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])
  especie   Especie?  @relation(fields: [especieId], references: [id])

  @@unique([alimentoId, nutrienteId])
  @@index([nutrienteId])
  @@index([especieId])
  @@index([empresaId])
  @@map("tb_composicao_alimento")
  @@schema("schs2vet")
}

model ExigenciasNRC {
  id              Int      @id @default(autoincrement())
  nutrienteId     Int
  peso            Int
  categoriaAnimal String?  @db.VarChar(100)
  tipoExercicio   String   @db.VarChar(100)
  valorExigido    Float
  unidade         String?  @db.VarChar(20)
  fonte           String?  @db.VarChar(100)
  especieId       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])
  especie   Especie?  @relation(fields: [especieId], references: [id])

  @@unique([nutrienteId, peso, categoriaAnimal, tipoExercicio])
  @@index([nutrienteId])
  @@index([especieId])
  @@map("tb_exigencias_nrc")
  @@schema("schs2vet")
}

// =============================================================================
// EXAMES
// =============================================================================

model ExameNutricional {
  id              Int      @id @default(autoincrement())
  animalId        Int
  nutrienteId     Int
  dataExame       DateTime
  valorEncontrado Float
  unidade         String   @db.Text
  valorMinRef     Float?
  valorMaxRef     Float?
  observacao      String?  @db.Text
  arquivoUrl      String?  @db.Text

  animal    Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])

  @@index([animalId])
  @@index([nutrienteId])
  @@map("tb_exames_nutricionais")
  @@schema("schs2vet")
}

// Anexos da página Resultado de Exame — arquivo é ARMAZENADO aqui, para qualquer tipo
// de exame clínico (`exameClinicoId`, nullable). Nasceu só para Imagem (nome legado),
// mas Laboratorial/Bioquímico passou a usá-la também para guardar TODOS os arquivos
// de um resultado com mais de um documento anexado — `ExameClinico.arquivoUrl`
// continua apontando só para o primeiro, por compatibilidade com leitores antigos.
model ExameImagemAnexo {
  id             Int      @id @default(autoincrement())
  animalId       Int
  exameClinicoId Int?     @map("exame_clinico_id")
  nome           String?  @db.Text
  arquivoUrl     String   @db.Text
  dataExame      DateTime @default(now())
  criadoPorId    Int?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())

  animal Animal        @relation("AnimalExameImagens", fields: [animalId], references: [id], onDelete: Cascade)
  exame  ExameClinico? @relation("ExameClinicoImagens", fields: [exameClinicoId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([exameClinicoId])
  @@map("tb_exame_imagem_anexos")
  @@schema("schs2vet")
}

model ExameClinico {
  id              Int       @id @default(autoincrement())
  animalId        Int
  veterinarioId   Int?
  evolucaoId      Int?      @map("evolucao_id")
  tipo            String
  descricao       String
  status          String    @default("SOLICITADO")
  resultado       String?   @db.Text
  dataSolicitacao DateTime  @default(now())
  dataResultado   DateTime?
  arquivoUrl      String?
  observacao      String?   @db.Text
  qtdAmostra      Int?      @map("qtd_amostra")
  numero          Int?
  ativo           Boolean   @default(true)
  // Trava otimista (migration 20260923000000) — o laudo é o pior lugar para uma
  // sobrescrita calada: é o dado que fundamenta a conduta.
  versao          Int       @default(1)

  /// Quem EXECUTA o exame (migration 20261005000000). Sem FK, como
  /// `tb_prescricoes.prestador_id`: prontuário não muda porque um cadastro de
  /// prestador foi excluído. `null` = executado pela própria equipe.
  /// 🔴 LEITURA/ESCRITA por `lib/exameImagemValor.js` (SQL cru) — o client pode não
  /// conhecer estas colunas (§11: no Windows o `prisma generate` falha com o backend
  /// no ar), e um `select` tipado derrubaria a listagem inteira de exames.
  prestadorId     Int?      @map("prestador_id")
  /// SNAPSHOT do preço no dia do PEDIDO (vínculo do prestador ou padrão da empresa).
  /// `null` = não resolvido (exame laboratorial, ou sem valor cadastrado) — que é
  /// DIFERENTE de 0 (gratuito).
  valorCobrado    Float?    @map("valor_cobrado")

  animal         Animal                      @relation("AnimalExamesClinicos", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario    User?                       @relation("ExameClinicoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  evolucao       EvolucaoClinica?            @relation("EvolucaoExames", fields: [evolucaoId], references: [id], onDelete: SetNull)
  faturaItens    FaturaItem[]                @relation("FaturaItemExameClinico")
  resultadoItens ExameClinicoResultadoItem[] @relation("ExameClinicoResultados")
  imagens        ExameImagemAnexo[]          @relation("ExameClinicoImagens")

  @@index([animalId])
  @@index([evolucaoId])
  @@index([veterinarioId])
  @@map("tb_exames_clinicos")
  @@schema("schs2vet")
}

// Resultado ESTRUTURADO do exame clínico laboratorial (uma linha por parâmetro).
// O laudo/arquivo fica em ExameClinico (resultado verbatim + arquivoUrl); as imagens
// do exame de imagem usam ExameImagemAnexo. Migration 20260730000000.
model ExameClinicoResultadoItem {
  id             Int      @id @default(autoincrement())
  exameClinicoId Int      @map("exame_clinico_id")
  parametro      String   @db.Text
  valor          String?  @db.Text
  unidade        String?  @db.VarChar(50)
  referencia     String?  @db.Text
  ordem          Int      @default(0)
  createdAt      DateTime @default(now())

  exame ExameClinico @relation("ExameClinicoResultados", fields: [exameClinicoId], references: [id], onDelete: Cascade)

  @@index([exameClinicoId])
  @@map("tb_exame_clinico_resultado_itens")
  @@schema("schs2vet")
}

// =============================================================================
// OCORRÊNCIAS DE SAÚDE
// =============================================================================

model OcorrenciaSaude {
  id          Int       @id @default(autoincrement())
  animalId    Int
  dataInicio  DateTime
  dataFim     DateTime?
  problema    String    @db.Text
  tratamento  String?   @db.Text
  responsavel String?   @db.Text

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("tb_ocorrencias_saude")
  @@schema("schs2vet")
}

// Histórico de PESO, LOCALIZAÇÃO e BAIA do animal — um snapshot por alteração,
// gravado por `AnimalController.criar`/`atualizar` sempre que qualquer um dos três
// campos muda. Alimenta o gráfico de peso e a linha do tempo de local/baia em
// AnimalDetail (ver GraficosAnimalController). Resultado de exame já tem histórico
// próprio (ExameClinico + ExameClinicoResultadoItem) — não duplicado aqui.
// Migration 20260819000000.
model AnimalHistorico {
  id            Int      @id @default(autoincrement())
  animalId      Int      @map("animal_id")
  peso          Float?
  localizacaoId Int?     @map("localizacao_id")
  local         String?  @db.VarChar(255)
  baia          String?  @db.VarChar(100)
  registradoEm  DateTime @default(now()) @map("registrado_em")
  criadoPorId   Int?     @map("criado_por_id")

  animal      Animal             @relation("AnimalHistoricoAnimal", fields: [animalId], references: [id], onDelete: Cascade)
  localizacao LocalizacaoAnimal? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  criadoPor   User?              @relation("AnimalHistoricoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([animalId, registradoEm])
  @@index([localizacaoId])
  @@map("tb_animal_historico")
  @@schema("schs2vet")
}

// Janelas de POSSE do animal — uma linha por período contínuo de propriedade. A
// janela ABERTA (dataFim=null) é sempre o dono ATUAL; ela é o que a Transferência de
// Propriedade fecha (grava motivoTransferencia) ao mesmo tempo que abre a próxima.
// Fonte de verdade para "quem foi dono, e entre quando e quando" — é dela que a
// Exportação lê a janela exata de um proprietário ANTERIOR (nunca antes de ele se
// tornar dono, nunca depois de deixar de ser). `Animal.propriedadeDesde` é só uma
// cópia rápida de `dataInicio` da janela aberta, para não repetir esta consulta em
// toda tela — ver comentário no model Animal. Migration <PENDENTE> — GERADA, NÃO
// aplicada (ver o próprio arquivo de migration para o backfill obrigatório).
model AnimalProprietarioHistorico {
  id                  Int       @id @default(autoincrement())
  animalId            Int       @map("animal_id")
  proprietarioId      Int       @map("proprietario_id")
  dataInicio          DateTime  @default(now()) @map("data_inicio")
  dataFim             DateTime? @map("data_fim") // null = janela ATUAL (dono corrente)
  motivoTransferencia String?   @map("motivo_transferencia") @db.VarChar(20) // DOACAO|VENDA|ALUGUEL — motivo que ENCERROU esta janela
  empresaId           Int       @map("empresa_id")
  criadoPorId         Int?      @map("criado_por_id")

  animal       Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  proprietario User    @relation("AnimalPropHistProprietario", fields: [proprietarioId], references: [id], onDelete: Cascade)
  empresa      Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPor    User?   @relation("AnimalPropHistCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([animalId, dataFim])
  @@index([proprietarioId])
  @@map("tb_animal_proprietario_historico")
  @@schema("schs2vet")
}

// =============================================================================
// CLÍNICA — EVOLUÇÕES, PRESCRIÇÕES, VACINAS, ENCAMINHAMENTOS
// =============================================================================

model EvolucaoClinica {
  id                    Int       @id @default(autoincrement())
  animalId              Int
  veterinarioId         Int?
  modificadoPorId       Int?
  agendamentoId         Int?      @map("agendamento_id")
  especialidade         String
  status                String    @default("EM_ANDAMENTO")
  texto                 String    @db.Text
  titulo                String?   @db.VarChar(255)
  numero                Int? // sequencial por animal dentro do tipo (EV-0001 ou herdado do AG)
  tipoAtendimento       String?   @default("EV") @map("tipo_atendimento") @db.VarChar(2) // 'AG' | 'EV'
  // Tenancy: empresa/equipe do CONTEXTO em que a evolução foi criada (multi-vet:
  // o mesmo animal pode ter histórico dividido entre clínicas). Sem FK — o registro
  // clínico sobrevive à exclusão da empresa. null = legado/vet autônomo.
  empresaId             Int       @map("empresa_id")
  equipeId              Int?      @map("equipe_id")
  dataInicio            DateTime  @default(now())
  dataFim               DateTime?
  dataModificacao       DateTime?
  ativo                 Boolean   @default(true)
  justificativaExclusao String?   @db.Text
  aprovado              Boolean   @default(true)
  // ── Concorrência de edição (migration 20260922000000) ────────────────────
  // TRAVA OTIMISTA: quem salva manda a versão que LEU e o UPDATE é condicionado a
  // ela. Gravação concorrente vira 409, nunca overwrite silencioso. Ver
  // lib/concorrenciaRegistro.js — leitura/escrita por SQL cru (o client pode não
  // conhecer a coluna: no Windows o `generate` falha com o backend rodando).
  versao                Int       @default(1)
  // QUEM CRIOU, imutável. `veterinarioId` continua sendo o EDITOR/RESPONSÁVEL atual
  // (é ele que `assumir` transfere) — sem esta coluna, assumir APAGAVA o criador.
  // Sem FK de propósito: o prontuário sobrevive à exclusão da conta do autor.
  autorId               Int?      @map("autor_id")
  // TODOS os que já responderam pelo registro, do mais antigo ao mais recente — é a
  // coluna "Responsável" da tela, que risca cada um deles e deixa em pé só o atual.
  // `assumidoDeId`/`autorId` guardam UM nome cada (o anterior imediato e o primeiro);
  // com três assunções seguidas nenhum dos dois conta a história.
  // Leitura/escrita por SQL cru — lib/cadeiaResponsaveis.js (migration 20260924000000).
  responsaveisAnteriores  Int[]     @map("responsaveis_anteriores")
  resumoIaData          Json?     @map("resumo_ia_data") // ResumoAtendimento (body-map + scores) cacheado — ver laudoEquinoExtracao.service.ts
  resumoIaVersao        String?   @map("resumo_ia_versao") @db.VarChar(50) // ex: "extrair_resultado_sessao_equino@v2" — invalida o cache se mudar

  animal           Animal                  @relation("AnimalEvolucoes", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario      User?                   @relation("EvolucaoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  modificadoPor    User?                   @relation("EvolucaoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)
  agendamento      AgendamentoClinico?     @relation("AgendamentoEvolucoes", fields: [agendamentoId], references: [id], onDelete: SetNull)
  midias           EvolucaoMidia[]
  prescricaoGrupos PrescricaoGrupo[]       @relation("EvolucaoPrescricaoGrupos")
  vacinasClinicas  VacinaClinica[]         @relation("EvolucaoVacinas")
  examesClinicos   ExameClinico[]          @relation("EvolucaoExames")
  encaminhamentos  EncaminhamentoClinico[] @relation("EvolucaoEncaminhamentos")
  documentosEmitidos DocumentoEmitido[]    @relation("EvolucaoDocumentosEmitidos")

  @@index([agendamentoId])
  @@index([animalId, especialidade, dataInicio])
  @@index([empresaId])
  @@index([equipeId])
  @@index([veterinarioId])
  @@index([autorId])
  @@map("tb_evolucoes_clinicas")
  @@schema("schs2vet")
}

model EvolucaoMidia {
  id         Int      @id @default(autoincrement())
  evolucaoId Int
  tipo       String   @db.VarChar(10)
  url        String   @db.VarChar(500)
  nome       String   @db.VarChar(255)
  tamanho    Int?
  criadoEm   DateTime @default(now())

  evolucao EvolucaoClinica @relation(fields: [evolucaoId], references: [id], onDelete: Cascade)

  @@index([evolucaoId])
  @@map("tb_evolucao_midias")
  @@schema("schs2vet")
}

model Prescricao {
  id                       Int       @id @default(autoincrement())
  animalId                 Int
  veterinarioId            Int?
  grupoId                  Int? // FK para PrescricaoGrupo (null = item legado sem grupo)
  medicamentoCatId         Int? // FK para Medicamento quando selecionado do catálogo
  tipo                     String    @default("MEDICAMENTO")
  medicamento              String // nome livre ou nome do catálogo
  dose                     String    @default("")
  dosagem                  String?
  unidade                  String?
  frequencia               String    @default("")
  duracao                  String    @default("")
  duracaoDias              Int       @default(1)
  diasAplicacaoInicio      Int       @default(1)
  diasAplicacaoFim         Int?
  horaInicio               String?
  via                      String    @default("Oral")
  observacao               String?
  status                   String    @default("RASCUNHO") // RASCUNHO(=SALVO) | ATIVA(=FINALIZADO) | CANCELADA
  horariosGerados          Json?
  dataInicio               DateTime  @default(now())
  dataFim                  DateTime?
  ativo                    Boolean   @default(true)
  aprovado                 Boolean   @default(true)
  medicamentoCliente       Boolean   @default(false)
  // Quem aplica ESTE item é o proprietário, em casa: orientação clínica, não serviço
  // da clínica. Não entra na Execução de Prescrição (plantão) e, por consequência,
  // não gera FaturaItem nem reserva/debita estoque. Irmão do `medicamentoCliente`
  // (que trata de quem FORNECE) — os dois são por ITEM, nunca por documento.
  aplicadaPeloProprietario Boolean   @default(false) @map("aplicada_pelo_proprietario")
  executadoEm              DateTime? // horário da ÚLTIMA dose executada (não só a 1ª — ver §execução por dose)
  // Origem no orçamento: `valorOrcado` é o valor UNITÁRIO aceito pelo cliente e tem
  // precedência sobre o preço do catálogo/estoque no lançamento da fatura.
  orcamentoItemId          Int?      @map("orcamento_item_id")
  valorOrcado              Float?    @map("valor_orcado")
  /// PRESTADOR que executa ESTE item (procedimento). Fica no ITEM, não no grupo: a
  /// mesma prescrição pode ter o bloqueio do veterinário da casa e o ferrageamento do
  /// ferrador externo — mesma razão de `medicamentoCliente`/`aplicadaPeloProprietario`
  /// serem por item.
  /// ⚠️ Lido/gravado por SQL CRU (`lib/procedimentoPrestador.js`) — o client Prisma
  /// pode não conhecer a coluna. Sem FK: prontuário não muda porque um cadastro de
  /// prestador foi excluído, e o ledger do recibo já guarda o vínculo.
  prestadorId              Int?      @map("prestador_id")

  // ── Execução por DOSE individual (não mais por dia) ──────────────────────────
  // `dosesExecutadas`/`proximaDoseEm` são desnormalizados a partir do log
  // `PrescricaoExecucaoDose` — evitam um COUNT/ORDER BY a cada leitura (tela de
  // execução, cron de WhatsApp). `proximaDoseEm` é ROLLING: recalculado a cada
  // execução como (horário REAL da última dose) + intervalo da frequência — não é
  // uma grade fixa desde `horaInicio`. Só itens COM `horaInicio` e frequência
  // diferente de agora/SOS/seNecessario entram nesse fluxo (ver lib/agendaDoses.js
  // `elegivelParaFluxoNovo`); os demais mantêm o comportamento antigo (1x/dia).
  dosesExecutadas         Int       @default(0) @map("doses_executadas")
  proximaDoseEm           DateTime? @map("proxima_dose_em")
  // Guarda QUAL `proximaDoseEm` já recebeu o aviso de WhatsApp de 15min — muda
  // sozinho quando uma dose antecipada/atrasada desloca o próximo horário,
  // permitindo reenviar sem precisar de uma segunda coluna de controle.
  proximaDoseAvisoEnviado DateTime? @map("proxima_dose_aviso_enviado")

  animal         Animal                   @relation("AnimalPrescricoes", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario    User?                    @relation("PrescricaoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  grupo          PrescricaoGrupo?         @relation("GrupoPrescricoes", fields: [grupoId], references: [id])
  medicamentoCat Medicamento?             @relation("MedicamentoPrescricoes", fields: [medicamentoCatId], references: [id])
  faturaItens    FaturaItem[]             @relation("FaturaItemPrescricao")
  orcamentoItem  OrcamentoItem?           @relation("PrescricaoOrcamento", fields: [orcamentoItemId], references: [id], onDelete: SetNull)
  execucoesDose  PrescricaoExecucaoDose[] @relation("PrescricaoExecucoesDose")

  @@index([animalId])
  @@index([veterinarioId])
  @@index([grupoId])
  @@index([orcamentoItemId])
  @@index([proximaDoseEm])
  @@map("tb_prescricoes")
  @@schema("schs2vet")
}

// Log append-only de CADA dose individual executada de um item de prescrição —
// substitui o modelo antigo de "uma execução cobre o dia inteiro". Uma linha por
// clique em Executar. Fonte de auditoria (paciente/medicamento/previsto/executado/
// quem) e base do rolling schedule (a última linha do item define a próxima dose
// esperada). `grupoId`/`animalId` são denormalizados para o cron de WhatsApp e para
// a policy de RLS lerem sem precisar de join até `Prescricao`.
model PrescricaoExecucaoDose {
  id               Int      @id @default(autoincrement())
  prescricaoId     Int
  grupoId          Int
  animalId         Int
  numeroDose       Int      @map("numero_dose") // 1..N dentro do item — só para exibição/auditoria
  horarioPrevisto  DateTime @map("horario_previsto")
  horarioExecutado DateTime @default(now()) @map("horario_executado")
  executadoPorId   Int?     @map("executado_por_id")
  // NO_HORARIO | ANTECIPADA | ATRASADA
  classificacao    String   @db.VarChar(20)
  diferencaMinutos Int      @map("diferenca_minutos") // executado − previsto, em minutos
  createdAt        DateTime @default(now()) @map("created_at")

  prescricao   Prescricao @relation("PrescricaoExecucoesDose", fields: [prescricaoId], references: [id], onDelete: Cascade)
  executadoPor User?      @relation("PrescricaoDoseExecutadaPor", fields: [executadoPorId], references: [id], onDelete: SetNull)

  @@index([prescricaoId])
  @@index([grupoId])
  @@map("tb_prescricao_execucoes_dose")
  @@schema("schs2vet")
}

// Documento de prescrição (agrupa itens Medicamento/Procedimento)
model PrescricaoGrupo {
  id                 Int       @id @default(autoincrement())
  numero             Int // sequencial por animal (1=001, 2=002…)
  animalId           Int
  veterinarioId      Int?
  empresaId          Int
  evolucaoId         Int?      @map("evolucao_id") // evolução que originou este grupo
  status             String    @default("SALVO") // SALVO | FINALIZADO | EXECUTADO | CANCELADO | CANCELADO_PARCIALMENTE
  // "Aplicada pelo proprietário" mora no ITEM (Prescricao.aplicadaPeloProprietario) —
  // o mesmo documento mistura o que a clínica aplica e o que o cliente aplica em casa.
  motivoCancelamento String?   @db.Text
  finalizadoPorId    Int?
  finalizadoEm       DateTime?
  executadoPorId     Int?
  executadoEm        DateTime?
  // Trava otimista do DOCUMENTO (migration 20260923000000). Fica no GRUPO e não
  // no item: o que se disputa é o conjunto — incluir/remover item muda o
  // documento, e versão por item deixaria isso passar. Ver lib/concorrenciaRegistro.js.
  versao             Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  animal        Animal           @relation("AnimalPrescricaoGrupos", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario   User?            @relation("PrescricaoGrupoVet", fields: [veterinarioId], references: [id], onDelete: SetNull)
  finalizadoPor User?            @relation("PrescricaoGrupoFinaliza", fields: [finalizadoPorId], references: [id], onDelete: SetNull)
  executadoPor  User?            @relation("PrescricaoGrupoExecuta", fields: [executadoPorId], references: [id], onDelete: SetNull)
  evolucao      EvolucaoClinica? @relation("EvolucaoPrescricaoGrupos", fields: [evolucaoId], references: [id], onDelete: SetNull)
  itens         Prescricao[]     @relation("GrupoPrescricoes")
  reservas      ReservaEstoque[] @relation("GrupoReservas")

  @@unique([animalId, numero])
  @@index([animalId])
  @@index([veterinarioId])
  @@index([status])
  @@index([evolucaoId])
  @@index([finalizadoPorId])
  @@index([executadoPorId])
  @@map("tb_prescricao_grupos")
  @@schema("schs2vet")
}

// Catálogo global de procedimentos veterinários
model ProcedimentoVeterinario {
  id               Int      @id @default(autoincrement())
  codigo           String?  @unique @db.VarChar(50)
  nome             String   @db.VarChar(255)
  nomeAbreviado    String?  @db.VarChar(100)
  descricao        String?  @db.Text
  categoria        String   @db.VarChar(100)
  subcategoria     String?  @db.VarChar(100)
  especialidade    String?  @db.VarChar(100)
  tipoProcedimento String?  @db.VarChar(50) // CLINICO | CIRURGICO | DIAGNOSTICO
  duracao          Int? // minutos
  requerAnestesia  Boolean  @default(false)
  requerInternacao Boolean  @default(false)
  risco            String?  @db.VarChar(20) // BAIXO | MEDIO | ALTO
  valorCusto       Float?
  valorVenda       Float?
  especie          String?  @db.VarChar(50) // Bovino | Equino | Bovino e Equino
  // null = catálogo global (ADMIN); setado = procedimento próprio da empresa
  // (criado por item manual de orçamento) — só a empresa dona vê/edita.
  empresaId        Int?     @map("empresa_id")
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  valoresEmpresa ProcedimentoValorEmpresa[] @relation("ProcedimentoValoresEmpresa")
  prestadores    ProcedimentoPrestador[]    @relation("ProcedimentoPrestadores")
  comboItens     ProcedimentoComboItem[]    @relation("ProcedimentoComboItens")

  @@index([ativo])
  @@index([categoria])
  @@index([especie])
  @@index([empresaId])
  @@map("tb_procedimentos_vet")
  @@schema("schs2vet")
}

model Vacina {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(255)
  fabricante String?  @db.VarChar(255)
  via        String   @default("Subcutânea (SC)") @db.VarChar(100)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  lotes      LoteVacina[]
  aplicacoes VacinaClinica[] @relation("VacinaAplicacoes")

  @@index([ativo])
  @@map("tb_vacinas")
  @@schema("schs2vet")
}

model LoteVacina {
  id                     Int       @id @default(autoincrement())
  vacinaId               Int?      @map("vacina_id")
  empresaId              Int       @map("empresa_id")
  medicamentoCatId       Int?      @map("medicamento_cat_id")
  lote                   String    @db.VarChar(100)
  validade               DateTime
  // Float desde 2026-09-16: o lote passou a ser contado na FORMA DE CÁLCULO do produto
  // (60 mL, não "60 doses"), e a aplicação pode tirar 2,5 mL dele.
  qtdTotal               Float     @default(0) @map("qtd_total")
  qtdDisponivel          Float     @default(0) @map("qtd_disponivel")
  // Alertas de nível de estoque (doses) — mesma lógica de EstoqueClinica.estoqueMinimo/
  // .estoqueAlarmante (farmácia): mínimo = alerta vermelho, alarmante = alerta amarelo.
  // 🔴 Migration GERADA (20260919000000), NÃO aplicada.
  estoqueMinimo          Float     @default(0) @map("estoque_minimo")
  estoqueAlarmante       Float     @default(0) @map("estoque_alarmante")
  // Quanto cada frasco rende, na forma de cálculo do produto — o par de
  // `Medicamento.dosesPorEmbalagem`. É ele que divide o preço do frasco na fatura.
  dosesPorFrasco         Float     @default(1) @map("doses_por_frasco")
  qtdFrascos             Int       @default(0) @map("qtd_frascos")
  validadeHoras          Int?      @map("validade_horas")
  validadeDias           Int       @default(0) @map("validade_dias")
  valorUnitario          Float?    @map("valor_unitario")
  valorUnitarioRepassado Float?    @map("valor_unitario_repassado")
  dataRecebimento        DateTime? @map("data_recebimento")
  ativo                  Boolean   @default(true)
  // Trilha de ATIVAÇÃO/INATIVAÇÃO (quem fez, quando) — mesma lógica de
  // `Fornecedor` (migration 20260828000000_estoque_ativacao_trilha). Sem FK
  // cascade: excluir quem fez a ação não apaga nem destrava o registro afetado.
  ativoEm                DateTime? @map("ativo_em")
  ativoPorId             Int?      @map("ativo_por_id")
  inativoEm              DateTime? @map("inativo_em")
  inativoPorId           Int?      @map("inativo_por_id")
  // Justificativa da inativação (migration 20260901000001) — obrigatória em
  // EstoqueVacinaController.toggle, exibida na aba Inativos.
  inativoMotivo          String?   @map("inativo_motivo") @db.Text
  /// Fornecedor do frasco e nota fiscal da entrada (migration 20261006000000).
  /// `tb_estoque_clinica` (farmácia) já tinha os dois; o lote de vacina não — então
  /// a entrada de vacina não sabia dizer de quem veio, e a leitura da nota fiscal
  /// não teria onde gravar isso. Sem FK: a compra registrada não muda de dono nem
  /// desaparece porque o cadastro do fornecedor foi excluído.
  /// 🔴 LEITURA/ESCRITA por SQL cru (`lib/produtoFornecedor.js`) — §11.
  fornecedorId           Int?      @map("fornecedor_id")
  notaFiscal             String?   @map("nota_fiscal") @db.VarChar(100)
  createdAt              DateTime  @default(now()) @map("created_at")

  vacina         Vacina?                @relation(fields: [vacinaId], references: [id], onDelete: Cascade)
  medicamentoCat Medicamento?           @relation("MedicamentoLotes", fields: [medicamentoCatId], references: [id], onDelete: SetNull)
  empresa        Empresa                @relation("LoteVacinaEmpresa", fields: [empresaId], references: [id], onDelete: Restrict)
  aplicacoes     VacinaClinica[]        @relation("LoteAplicacoes")
  reservas       ReservaEstoqueVacina[] @relation("LoteVacinaReservas")

  @@index([vacinaId])
  @@index([empresaId])
  @@index([medicamentoCatId])
  @@map("tb_lotes_vacina")
  @@schema("schs2vet")
}

/// PRODUTO DE FORNECEDOR (migration 20261006000000) — "de quem eu compro este item,
/// e por quanto".
///
/// 🔴 NÃO É ESTOQUE. `EstoqueClinica` e `LoteVacina` são estoque FÍSICO (quantidade,
/// lote, validade); aqui não há nada disso, porque o item NÃO está na clínica: ele é
/// pedido ao fornecedor quando o vet o prescreve. É o que faz o item aparecer na
/// prescrição como PEDÍVEL (verde, com o nome do fornecedor) em vez de "Sem estoque".
///
/// ⚠️ Por (empresa, medicamento, fornecedor): o mesmo item costuma ter mais de um
/// fornecedor com preços diferentes, e guardar um só obrigaria a apagar a cotação
/// anterior para registrar a nova.
///
/// ⚠️ `medicamentoId` aponta para `Medicamento`, o catálogo dos DOIS tipos (a vacina
/// é a linha cuja `classificacao` contém "vacin") — uma tabela por tipo duplicaria a
/// mesma regra de compra em dois lugares.
///
/// 🔴 LEITURA/ESCRITA: SEMPRE por `lib/produtoFornecedor.js` (SQL cru) — o client
/// pode não conhecer esta tabela (§11).
model ProdutoFornecedor {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  medicamentoId Int      @map("medicamento_id")
  fornecedorId  Int      @map("fornecedor_id")
  /// Preço de COMPRA. `null` = "compro dele, mas o preço não foi cadastrado" —
  /// diferente de 0, que afirmaria que o fornecedor entrega de graça.
  valorUnitario Float?   @map("valor_unitario")
  /// Preço de VENDA sugerido. `null` = a tela de origem resolve como já resolve hoje.
  valorVenda    Float?   @map("valor_venda")
  unidade       String?  @db.VarChar(30)
  notaFiscal    String?  @map("nota_fiscal") @db.VarChar(100)
  observacao    String?  @db.Text
  /// MULTIDOSE (migration 20261008000000) — a embalagem rende mais de uma aplicação.
  /// É ela que faz cada dose debitar 1/N do frasco e a linha da fatura sair pelo
  /// preço do frasco ÷ N, em vez de cobrar o frasco inteiro por aplicação.
  /// ⚠️ Mora AQUI, e não em `Medicamento`: a linha do catálogo é GLOBAL e marcá-la
  /// mudaria a cobrança de todas as clínicas (mesma armadilha da unidade).
  multidose     Boolean  @default(false)
  /// Quantas aplicações saem de UMA embalagem. `null` = marcado e ainda não
  /// informado — PENDÊNCIA de cadastro, nunca "dose única": com null a regra não
  /// entra em vigor e a cobrança segue como sempre foi.
  dosesPorEmbalagem Int? @map("doses_por_embalagem")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([empresaId, medicamentoId, fornecedorId], map: "tb_produtos_fornecedor_unico")
  @@index([empresaId])
  @@index([medicamentoId])
  @@index([fornecedorId])
  @@map("tb_produtos_fornecedor")
  @@schema("schs2vet")
}

/// CONTA A PAGAR (migration 20261006000000) — o outro lado do balcão da `Fatura`.
///
/// A fatura é o que a clínica COBRA do cliente; esta é o que ela DEVE a um terceiro.
///
/// 🔴 UMA tabela para FORNECEDOR e PRESTADOR, separados por `tipo`. São o mesmo
/// documento, com o mesmo ciclo (abrir → fechar → pagar); duas tabelas dariam duas
/// telas, dois totalizadores e duas regras de fechamento, que divergiriam na primeira
/// correção — a `Fatura` também é uma só para todo tipo de item cobrado.
///
/// ⚠️ `credorId` é id de `Fornecedor` OU de `Prestador` conforme o `tipo`: as duas
/// tabelas são independentes desde 2026-08-21 e não compartilham id. SEM FK, pelo
/// mesmo motivo de `Prescricao.prestadorId` — registro financeiro não muda de dono
/// nem some porque um cadastro foi excluído. `credorNome` é SNAPSHOT.
///
/// 🔴 LEITURA/ESCRITA: SEMPRE por `lib/contasPagar.js` (SQL cru).
model ContaPagar {
  id            Int       @id @default(autoincrement())
  empresaId     Int       @map("empresa_id")
  /// FORNECEDOR | PRESTADOR
  tipo          String    @db.VarChar(20)
  credorId      Int       @map("credor_id")
  credorNome    String    @default("") @map("credor_nome") @db.VarChar(255)
  mesReferencia String?   @map("mes_referencia") @db.VarChar(7)
  total         Float     @default(0)
  /// ABERTA | FECHADA | PAGA | CANCELADA
  status        String    @default("ABERTA") @db.VarChar(20)
  observacao    String?   @db.Text
  pagoEm        DateTime? @map("pago_em")
  pagoPorId     Int?      @map("pago_por_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  itens ContaPagarItem[] @relation("ContaPagarItens")

  @@index([empresaId])
  @@index([empresaId, tipo, credorId, status])
  @@map("tb_contas_pagar")
  @@schema("schs2vet")
}

/// Item da conta a pagar — o que o pedido exige que apareça: o ANIMAL, o valor, a
/// data e QUEM solicitou.
///
/// ⚠️ `animalNome`/`solicitanteNome`/`descricao` são GRAVADOS junto do id (snapshot),
/// pela mesma razão do ledger do prestador: a conta tem de dizer o que foi consumido
/// mesmo que o paciente seja renomeado ou o item saia do catálogo.
///
/// ⚠️ `origemTipo`/`origemId` são o que torna o lançamento automático IDEMPOTENTE —
/// há um índice único PARCIAL sobre eles no banco (só quando os dois existem), então
/// reprocessar a mesma execução não cria a segunda linha. Lançamento MANUAL não tem
/// origem, e vários deles na mesma conta são legítimos.
model ContaPagarItem {
  id              Int      @id @default(autoincrement())
  contaId         Int      @map("conta_id")
  animalId        Int?     @map("animal_id")
  animalNome      String   @default("") @map("animal_nome") @db.VarChar(255)
  descricao       String   @db.Text
  quantidade      Float    @default(1)
  valor           Float    @default(0)
  solicitanteId   Int?     @map("solicitante_id")
  solicitanteNome String   @default("") @map("solicitante_nome") @db.VarChar(255)
  /// Data do FATO GERADOR (a execução), não a do lançamento.
  ocorridoEm      DateTime @default(now()) @map("ocorrido_em")
  /// PRESCRICAO_ITEM | VACINA | EXECUCAO_PRESTADOR | MANUAL
  origemTipo      String?  @map("origem_tipo") @db.VarChar(30)
  origemId        Int?     @map("origem_id")
  createdAt       DateTime @default(now()) @map("created_at")

  conta ContaPagar @relation("ContaPagarItens", fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([animalId])
  @@map("tb_conta_pagar_itens")
  @@schema("schs2vet")
}

model VacinaClinica {
  id                       Int       @id @default(autoincrement())
  animalId                 Int
  veterinarioId            Int?
  vacinaId                 Int?      @map("vacina_id")
  loteId                   Int?      @map("lote_id")
  medicamentoCatId         Int?      @map("medicamento_cat_id")
  evolucaoId               Int?      @map("evolucao_id")
  nome                     String
  fabricante               String?
  lote                     String?
  dose                     String?   @db.VarChar(50)
  via                      String?   @db.VarChar(100)
  numero                   Int?
  tipoAtendimento          String?   @default("VC") @map("tipo_atendimento") @db.VarChar(2)
  // 🔴 `quantidade` É A DOSAGEM, não mais a contagem de doses da série (2026-09-16):
  // o campo "Qtd Doses" da tela virou "Valor + Forma de Cálculo" a pedido. 5 mL, 2,5 mL
  // ou 1 dose — a unidade é `formaCalculo`, gravada junto como SNAPSHOT para a folha e
  // a fatura antigas não mudarem de unidade quando o cadastro do produto mudar.
  // ⚠️ CONSEQUÊNCIA: `agendarReforcos` não tem mais de onde tirar o tamanho da série e
  // passou a agendar só a PRÓXIMA dose. Ver VacinaClinicaController.
  quantidade               Float?    @default(1)
  formaCalculo             String?   @map("forma_calculo") @db.VarChar(20)
  valor                    Decimal?  @db.Decimal(10, 2)
  // Quem FORNECE a dose (a clínica, ou o próprio cliente traz)
  cliente                  Boolean   @default(false)
  // Quem APLICA a dose — irmã de `cliente`, nunca a mesma decisão. É o CRUZAMENTO das
  // duas que decide execução e fatura (matriz do CLAUDE.md). Ver migration
  // 20260815000001 e `VacinaClinicaController.finalizar`.
  aplicadaPeloProprietario Boolean   @default(false) @map("aplicada_pelo_proprietario")
  status                   String    @default("SALVA") @db.VarChar(20) // SALVA | FINALIZADA | EXECUTADA
  dataAplicacao            DateTime  @default(now())
  dataReforco              DateTime?
  observacao               String?   @db.Text
  ativo                    Boolean   @default(true)
  motivoInativacao         String?   @map("motivo_inativacao") @db.Text

  animal      Animal                 @relation("AnimalVacinas", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario User?                  @relation("VacinaVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  vacina      Vacina?                @relation("VacinaAplicacoes", fields: [vacinaId], references: [id], onDelete: SetNull)
  loteVacina  LoteVacina?            @relation("LoteAplicacoes", fields: [loteId], references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica?       @relation("EvolucaoVacinas", fields: [evolucaoId], references: [id], onDelete: SetNull)
  faturaItens FaturaItem[]           @relation("FaturaItemVacina")
  reservas    ReservaEstoqueVacina[] @relation("VacinaReservas")

  @@index([animalId])
  @@index([vacinaId])
  @@index([evolucaoId])
  @@index([veterinarioId])
  @@index([loteId])
  @@map("tb_vacinas_clinicas")
  @@schema("schs2vet")
}

// Agendamentos do animal (consultas, vacinas, retornos, exames, procedimentos)
// Exibidos no painel "Agendamentos" da tela do animal (AnimalDetail)
model AgendamentoClinico {
  id                       Int       @id @default(autoincrement())
  animalId                 Int       @map("animal_id")
  veterinarioId            Int?      @map("veterinario_id")
  tipo                     String    @default("CONSULTA") @db.VarChar(20) // CONSULTA|VACINA|RETORNO|EXAME|PROCEDIMENTO
  titulo                   String    @db.VarChar(255)
  dataHora                 DateTime  @map("data_hora")
  observacao               String?   @db.Text
  // ⚠️ 30, não 20: `CANCELADO_AUTOMATICAMENTE` tem 25 caracteres e NÃO cabia em
  // VarChar(20) — o cron noturno que o grava falhava toda noite (migration
  // 20260914000000). Status novo aqui: confira o comprimento antes.
  // AGENDADO|ATRASADA|EM_ANDAMENTO|CONCLUIDO|FINALIZADO|CANCELADO|
  // CANCELADO_AUTOMATICAMENTE|REAGENDADO|TRANSFERIDO(legado)
  status                   String    @default("AGENDADO") @db.VarChar(30)
  ativo                    Boolean   @default(true)
  numero                   Int? // sequencial por animal (AG-0001)
  criadoPorId              Int?      @map("criado_por_id")
  // Contexto (empresa/equipe) em que o agendamento foi criado — agendas independentes
  // por equipe. Sem FK (sobrevive à exclusão da empresa/equipe). Backfill = contexto do animal.
  empresaId                Int       @map("empresa_id")
  equipeId                 Int?      @map("equipe_id")
  // Controle de idempotência dos lembretes por WhatsApp (D-1 e 2h antes)
  lembreteWa1DiaEnviadoEm  DateTime? @map("lembrete_wa_1dia_em") // legado — não usado mais
  lembreteWa2hEnviadoEm    DateTime? @map("lembrete_wa_2h_em") // legado — não usado mais
  // Lembretes 1h / 15min antes (proprietário + veterinário) — idempotência por flag.
  lembreteWa1hEnviadoEm    DateTime? @map("lembrete_wa_1h_em")
  lembreteWa15minEnviadoEm DateTime? @map("lembrete_wa_15min_em")
  // Especialidade do atendimento — define o passo da grade e a duração do slot.
  especialidadeId          Int?      @map("especialidade_id")
  // Snapshot da duração em minutos. NÃO derivar na leitura: se o profissional mudar
  // o tempo da especialidade depois, os agendamentos já marcados mantêm o seu.
  // null = anterior à migration 20260804000000 (a agenda trata como 60min).
  duracaoMin               Int?      @map("duracao_min")
  // Quem PERDEU o atendimento na última vez em que alguém o assumiu (agenda ou
  // evolução). Sem isso a troca de responsável é invisível na tela: o atendimento
  // some da agenda de um e aparece na do outro sem explicação. Ver migration
  // 20260815000000 e lib/agendamentoAssumido.js (leitura/escrita por SQL cru).
  assumidoDeId             Int?      @map("assumido_de_id")
  assumidoEm               DateTime? @map("assumido_em")
  // TODOS os que já responderam pelo registro, do mais antigo ao mais recente — é a
  // coluna "Responsável" da tela, que risca cada um deles e deixa em pé só o atual.
  // `assumidoDeId`/`autorId` guardam UM nome cada (o anterior imediato e o primeiro);
  // com três assunções seguidas nenhum dos dois conta a história.
  // Leitura/escrita por SQL cru — lib/cadeiaResponsaveis.js (migration 20260924000000).
  responsaveisAnteriores   Int[]     @map("responsaveis_anteriores")
  // Trava otimista — mesma regra da evolução. Ver lib/concorrenciaRegistro.js.
  versao                   Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  animal        Animal            @relation("AnimalAgendamentos", fields: [animalId], references: [id], onDelete: Cascade)
  especialidade Especialidade?    @relation("AgendamentoEspecialidade", fields: [especialidadeId], references: [id], onDelete: SetNull)
  veterinario   User?             @relation("AgendamentoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  criadoPor     User?             @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  assumidoDe    User?             @relation("AgendamentoAssumidoDe", fields: [assumidoDeId], references: [id], onDelete: SetNull)
  evolucoes     EvolucaoClinica[] @relation("AgendamentoEvolucoes")

  @@unique([animalId, numero])
  @@index([animalId, dataHora])
  @@index([empresaId, dataHora])
  @@index([equipeId, dataHora])
  @@index([especialidadeId])
  @@index([assumidoDeId])
  @@index([veterinarioId])
  @@index([criadoPorId])
  @@map("tb_agendamentos_clinicos")
  @@schema("schs2vet")
}

model EncaminhamentoClinico {
  id                 Int      @id @default(autoincrement())
  animalId           Int
  veterinarioId      Int?
  prestadorId             Int?     @map("prestador_id") // LOGIN do prestador — null quando o prestador não tem acesso ao sistema, ou quando o destino é externo
  // 🔴 CADASTRO de origem do prestador (migration 20261022000000). O destino interno
  // deixou de exigir login: `tb_prestadores` e `tb_fornecedores` são tabelas distintas,
  // então o endereço é o par (origem, id) — o mesmo padrão de conta a pagar.
  // ⚠️ `prestadorId` continua sendo quem recebe a `DesignacaoPrestador`; sem login não
  // há a quem dar acesso, e o encaminhamento fica só como registro clínico.
  prestadorCadastroId     Int?     @map("prestador_cadastro_id")
  prestadorCadastroOrigem String?  @map("prestador_cadastro_origem") @db.VarChar(12) // PRESTADOR | FORNECEDOR
  evolucaoId         Int?     @map("evolucao_id")
  especialidade      String
  motivo             String   @db.Text
  veterinarioDestino String?
  clinicaDestino     String?
  urgencia           String   @default("NORMAL")
  status             String   @default("PENDENTE")
  dataEncaminhamento DateTime @default(now())
  observacao         String?  @db.Text
  ativo              Boolean  @default(true)

  animal      Animal                @relation("AnimalEncaminhamentos", fields: [animalId], references: [id], onDelete: Cascade)
  veterinario User?                 @relation("EncaminhamentoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  prestador   User?                 @relation("EncaminhamentoPrestador", fields: [prestadorId], references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica?      @relation("EvolucaoEncaminhamentos", fields: [evolucaoId], references: [id], onDelete: SetNull)
  designacoes DesignacaoPrestador[] @relation("EncaminhamentoDesignacoes")
  faturaItens FaturaItem[]          @relation("FaturaItemEncaminhamento")

  @@index([prestadorId])
  @@index([prestadorCadastroOrigem, prestadorCadastroId])
  @@index([evolucaoId])
  @@index([animalId])
  @@index([veterinarioId])
  @@map("tb_encaminhamentos_clinicos")
  @@schema("schs2vet")
}

// Designação de prestador (User FORNECEDOR) a um animal específico.
// É o escopo de acesso do prestador: ele só enxerga animais com designação ativa.
// Criada automaticamente ao encaminhar para um prestador da equipe; inativada ao
// concluir/cancelar o encaminhamento (ou manualmente pelo gestor).
model DesignacaoPrestador {
  id               Int       @id @default(autoincrement())
  animalId         Int       @map("animal_id")
  prestadorId      Int       @map("prestador_id") // User userType=FORNECEDOR
  equipeId         Int       @map("equipe_id") // equipe que designou (segregação multi-empresa)
  encaminhamentoId Int?      @map("encaminhamento_id") // origem clínica, quando criada via encaminhamento
  motivo           String?   @db.VarChar(255)
  ativo            Boolean   @default(true)
  dataInicio       DateTime  @default(now()) @map("data_inicio")
  dataFim          DateTime? @map("data_fim")
  criadoPorId      Int?      @map("criado_por_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  animal         Animal                 @relation("AnimalDesignacoes", fields: [animalId], references: [id], onDelete: Cascade)
  prestador      User                   @relation("DesignacaoPrestadorUser", fields: [prestadorId], references: [id], onDelete: Cascade)
  equipe         Equipe                 @relation("EquipeDesignacoes", fields: [equipeId], references: [id], onDelete: Cascade)
  encaminhamento EncaminhamentoClinico? @relation("EncaminhamentoDesignacoes", fields: [encaminhamentoId], references: [id], onDelete: SetNull)
  criadoPor      User?                  @relation("DesignacaoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([animalId, prestadorId, equipeId])
  @@index([prestadorId, ativo])
  @@index([equipeId])
  @@index([encaminhamentoId])
  @@map("tb_designacoes_prestador")
  @@schema("schs2vet")
}

// =============================================================================
// FINANCEIRO
// =============================================================================

model Fatura {
  id               Int          @id @default(autoincrement())
  animalId         Int? // legado — manter para compatibilidade com prescricoes antigas
  proprietarioId   Int?
  mesReferencia    String?      @db.VarChar(7) // "2026-06"
  // 🔴 O QUE ESTA FATURA COBRA — só os itens ABERTOS. O bloco de um animal fechado à
  // parte (`FaturaItem.fechadoEm`) sai daqui e vai para `totalFechado`.
  total            Float        @default(0)
  // O que SAIU do total por fechamento POR ANIMAL. Existe para que nenhum indicador
  // perca dinheiro calado: o bloco fechado continua DEVIDO (só é acertado à parte),
  // então "contas a receber" e "devedores" somam `total + totalFechado`.
  // Mantido por `recalcularTotal` (lib/faturaUtils.js), junto com `total`.
  totalFechado     Float        @default(0) @map("total_fechado")
  // O que já foi ACERTADO à parte, por bloco de paciente pago (`FaturaItem.pagoEm`).
  // Não é mais "a receber" — por isso sai de `totalFechado` ao ser marcado. Quem quer
  // o RECEBIDO (melhores pagadores) soma esta coluna. Mantido por `recalcularTotal`.
  totalPagoAnimal  Float        @default(0) @map("total_pago_animal")
  status           String       @default("ABERTA") // ABERTA | PAGA | CANCELADA
  criadoEm         DateTime     @default(now())
  qtdCorrecoes     Int          @default(0) @map("qtd_correcoes") // nº de edições/remoções de itens existentes
  ultimaCorrecaoEm DateTime?    @map("ultima_correcao_em")
  // Tenancy: a fatura é POR EMPRESA. O mesmo cliente atendido por duas clínicas tem
  // DUAS faturas independentes — sem isto, o lançamento da clínica B caía na fatura
  // aberta da clínica A e cada uma via os itens da outra. Sem FK (mesmo critério de
  // EvolucaoClinica/AgendamentoClinico: o registro sobrevive à exclusão da empresa).
  // null = legado anterior à migration 20260812000000, sem tenancy dedutível.
  empresaId        Int          @map("empresa_id")
  itens            FaturaItem[]

  animal       Animal? @relation("AnimalFaturas", fields: [animalId], references: [id])
  proprietario User?   @relation("FaturaProprietario", fields: [proprietarioId], references: [id], onDelete: SetNull)

  linksPublicos FaturaLinkPublico[]

  @@index([proprietarioId, status])
  @@index([empresaId])
  @@index([proprietarioId, empresaId, status])
  @@index([animalId])
  @@map("tb_faturas")
  @@schema("schs2vet")
}

/// Link de acesso PÚBLICO a um PDF de fatura já gerado (envio por WhatsApp/e-mail
/// em vez do anexo — ver `lib/faturaLinkPublico.js`). O PDF em si mora em
/// `MidiaArquivo` (mesmo storage de qualquer outro arquivo — `midiaChave` é a
/// chave lá); esta tabela só guarda o TOKEN de acesso e a validade do link.
///
/// `token` é o ÚNICO identificador na URL pública (`/#/fatura/:token`) — de
/// propósito sem `faturaId`/`proprietarioId` na rota, para não dar a quem tem
/// o link nenhuma pista para adivinhar o link de OUTRO proprietário trocando
/// um caractere. É uma capability URL "pura" (decisão do usuário em
/// 2026-09-11, revertendo a camada de código de acesso que existiu por um
/// instante): sem segundo fator, então o TOKEN é que precisa segurar toda a
/// segurança — 64 caracteres sorteados de um alfabeto de 64 símbolos
/// (`A-Za-z0-9-_`, o alfabeto base64url — `crypto.randomBytes(48).
/// toString('base64url')`, ver lib/faturaLinkPublico.js) são 384 bits de
/// entropia, inviável de adivinhar por força bruta. `@unique` é a garantia
/// de "nunca um igual ao outro"; `criarLink` ainda re-sorteia e tenta de novo
/// no caso (virtualmente impossível) de colisão.
model FaturaLinkPublico {
  id             Int      @id @default(autoincrement())
  faturaId       Int      @map("fatura_id")
  // Cópia do tenant da fatura NA CRIAÇÃO do link — reforço de isolamento: a
  // leitura pública (sem sessão, sem req.empresaId) resolve o escopo de RLS
  // por `comEscopoPlataforma`, e esta coluna é o que a policy compara.
  empresaId      Int      @map("empresa_id")
  proprietarioId Int      @map("proprietario_id")
  token          String   @unique @db.VarChar(64)
  midiaChave     String   @map("midia_chave") @db.VarChar(64)
  expiraEm       DateTime @map("expira_em")
  criadoPorId    Int?     @map("criado_por_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  /// Canal e destino do ENVIO que originou este link — cada clique de "enviar"
  /// gera uma linha nova (ver criarLink), então canal/destino são do envio, não
  /// um atributo genérico da fatura. `null` cobre link criado sem envio associado
  /// (nenhum caso hoje, mas evita obrigar todo caller a informar).
  canal              String?   @map("canal") @db.VarChar(10) // 'WHATSAPP' | 'EMAIL'
  destino            String?   @map("destino") @db.VarChar(180) // telefone/e-mail usado
  status             String    @default("PENDENTE") @map("status") @db.VarChar(20)
  // PENDENTE | ENVIADO | FALHOU | FALHOU_DEFINITIVO
  tentativas         Int       @default(0) @map("tentativas")
  ultimoErro         String?   @map("ultimo_erro") @db.VarChar(300)
  enviadoEm          DateTime? @map("enviado_em")
  proximaTentativaEm DateTime? @map("proxima_tentativa_em")

  /// Revogação — distinta de expiração (`expiraEm`, sempre 30 dias corridos).
  /// `abrirLink`/`obterResumo` respondem 410 com mensagem própria quando setado.
  revogadoEm    DateTime? @map("revogado_em")
  revogadoPorId Int?      @map("revogado_por_id")

  /// Contador aproximado de acesso público — incrementado por `obterResumo`
  /// (uma vez por visita da página, não por byte servido). Uso: UI "Links
  /// enviados" mostrar se o cliente já abriu, não telemetria de precisão.
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")
  qtdAcessos     Int       @default(0) @map("qtd_acessos")

  fatura       Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  proprietario User   @relation("FaturaLinkProprietario", fields: [proprietarioId], references: [id], onDelete: Cascade)
  revogadoPor  User?  @relation("FaturaLinkRevogadoPor", fields: [revogadoPorId], references: [id], onDelete: SetNull)

  @@index([faturaId])
  @@index([expiraEm])
  @@index([status, proximaTentativaEm])
  @@map("tb_fatura_links_publicos")
  @@schema("schs2vet")
}

model FaturaItem {
  id                      Int      @id @default(autoincrement())
  faturaId                Int
  animalId                Int?
  tipo                    String   @db.VarChar(50) // ASSISTENCIA | MEDICAMENTO | PROCEDIMENTO
  descricao               String
  valor                   Float    @default(0)
  quantidade              Float    @default(1)
  veterinarioId           Int?
  criadoEm                DateTime @default(now())
  exameClinicoId          Int?
  prescricaoId            Int?
  vacinaClinicaId         Int?
  encaminhamentoClinicoId Int?
  orcamentoItemId         Int?     @map("orcamento_item_id") // origem: OrcamentoItem tipo OUTROS
  // Desconto do item: PERCENTUAL (0-100) ou VALOR (R$ sobre o bruto). null/0 = sem desconto.
  descontoTipo            String?  @map("desconto_tipo") @db.VarChar(12)
  descontoValor           Float    @default(0) @map("desconto_valor")
  // 🔴 FECHAMENTO POR ANIMAL (2026-09-22): preenchido = esta linha já foi encerrada
  // junto com o bloco do paciente dela e NÃO entra mais em `Fatura.total` (vai para
  // `Fatura.totalFechado`). null = linha aberta, o estado de sempre.
  // ⚠️ A marca é do ITEM, não do par (fatura, animal): é isso que faz a cobrança que
  // chega DEPOIS do fechamento nascer aberta e voltar a contar — com a marca no par,
  // toda dose aplicada depois cairia dentro de um bloco encerrado, sem ser cobrada.
  fechadoEm               DateTime? @map("fechado_em")
  // Quem fechou. SEM FK de propósito (registro histórico — ver a migration):
  // conta excluída depois não pode apagar nem alterar quem encerrou a cobrança.
  fechadoPorId            Int?      @map("fechado_por_id")
  // 🔴 PAGAMENTO POR ANIMAL (2026-09-23): preenchido = o bloco deste paciente já foi
  // ACERTADO à parte. Sai de `Fatura.totalFechado` (que é o fechado ainda DEVIDO) e
  // entra em `Fatura.totalPagoAnimal`. Item pago é sempre item FECHADO — pagar o
  // bloco fecha o que estiver aberto antes de dar a baixa.
  // ⚠️ A marca é do ITEM pela mesma razão de `fechadoEm`: cobrança que chegue DEPOIS
  // do acerto nasce aberta e volta a contar.
  pagoEm                  DateTime? @map("pago_em")
  // Quem deu a baixa. SEM FK de propósito (registro histórico — ver a migration).
  pagoPorId               Int?      @map("pago_por_id")

  fatura                Fatura                 @relation(fields: [faturaId], references: [id])
  origens               FaturaItemOrigem[]     @relation("FaturaItemOrigens")
  animal                Animal?                @relation("FaturaItemAnimal", fields: [animalId], references: [id])
  veterinario           User?                  @relation("FaturaItemVet", fields: [veterinarioId], references: [id], onDelete: SetNull)
  exameClinico          ExameClinico?          @relation("FaturaItemExameClinico", fields: [exameClinicoId], references: [id], onDelete: SetNull)
  prescricao            Prescricao?            @relation("FaturaItemPrescricao", fields: [prescricaoId], references: [id], onDelete: SetNull)
  vacinaClinica         VacinaClinica?         @relation("FaturaItemVacina", fields: [vacinaClinicaId], references: [id], onDelete: SetNull)
  encaminhamentoClinico EncaminhamentoClinico? @relation("FaturaItemEncaminhamento", fields: [encaminhamentoClinicoId], references: [id], onDelete: SetNull)
  orcamentoItem         OrcamentoItem?         @relation("FaturaItemOrcamento", fields: [orcamentoItemId], references: [id], onDelete: SetNull)

  @@index([exameClinicoId])
  @@index([prescricaoId])
  @@index([vacinaClinicaId])
  @@index([encaminhamentoClinicoId])
  @@index([orcamentoItemId])
  @@index([faturaId])
  @@index([animalId])
  // O recorte do fechamento por animal: os itens de UM paciente dentro de UMA fatura,
  // separando abertos de fechados.
  @@index([faturaId, animalId, fechadoEm])
  @@map("tb_fatura_itens")
  @@schema("schs2vet")
}

// 🔴 AS ORIGENS DE UMA LINHA DE FATURA (2026-09-17) — a observação por baixo da cobrança.
//
// Uma linha por CONTRIBUIÇÃO: de qual registro clínico veio, quando e quantas unidades.
// A linha da fatura passou a consolidar origens DIFERENTES (o mesmo medicamento, na
// mesma dose e pelo mesmo preço, aplicado em dois atendimentos, é UMA linha), e a FK de
// origem em `FaturaItem` só comporta a PRIMEIRA delas. É esta tabela que responde
// "Quant.: 5 veio de onde?" e, mais importante, que mantém o ESTORNO certo: cancelar
// uma das prescrições SUBTRAI o que era dela em vez de apagar a linha inteira.
//
// ⚠️ INVARIANTE: `FaturaItem.quantidade` = soma das `quantidade` daqui. Quem lança item
// com origem passa por `lib/faturaUtils.js`; lançamento manual do financeiro e
// assistência mensal não têm origem e simplesmente não têm contribuição.
//
// ⚠️ Lida e gravada por SQL CRU (`lib/faturaItemOrigens.js`) — o client Prisma pode não
// conhecer a tabela (no Windows o `prisma generate` falha com o backend rodando, §11), e
// a fatura não pode parar por causa da OBSERVAÇÃO dela.
model FaturaItemOrigem {
  id                      Int      @id @default(autoincrement())
  faturaItemId            Int      @map("fatura_item_id")
  quantidade              Float    @default(1)
  // Quando a execução aconteceu — é a data que aparece na observação. NÃO é `criadoEm`:
  // o lançamento pode ser reprocessado, a aplicação não.
  ocorridoEm              DateTime @default(now()) @map("ocorrido_em")
  criadoEm                DateTime @default(now()) @map("criado_em")
  exameClinicoId          Int?     @map("exame_clinico_id")
  prescricaoId            Int?     @map("prescricao_id")
  vacinaClinicaId         Int?     @map("vacina_clinica_id")
  encaminhamentoClinicoId Int?     @map("encaminhamento_clinico_id")

  faturaItem FaturaItem @relation("FaturaItemOrigens", fields: [faturaItemId], references: [id], onDelete: Cascade)

  @@index([faturaItemId])
  @@index([prescricaoId])
  @@index([vacinaClinicaId])
  @@index([exameClinicoId])
  @@index([encaminhamentoClinicoId])
  @@map("tb_fatura_item_origens")
  @@schema("schs2vet")
}

