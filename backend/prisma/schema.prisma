generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int        @id @default(autoincrement())
  fullName             String     @db.VarChar(255)
  email                String     @unique @db.VarChar(255)
  passwordHash         String     @db.VarChar(255)
  phone                String?    @db.VarChar(30)
  role                 String     @default("USER") @db.VarChar(50)
  userType             String     @default("PROPRIETARIO") @db.VarChar(50)
  cep                  String?    @db.VarChar(10)
  endereco             String?    @db.VarChar(255)
  complemento          String?    @db.VarChar(100)
  bairro               String?    @db.VarChar(100)
  cidade               String?    @db.VarChar(100)
  estado               String?    @db.VarChar(2)
  createdAt            DateTime   @default(now()) @db.DateTime(0)
  ativo                Boolean    @default(true)
  resetPasswordToken   String?    @unique @db.VarChar(255)
  resetPasswordExpires DateTime?  @db.DateTime(0)
  animais              Animal[]
  auditLogs            AuditLog[]
  dietasCriadas        Dieta[]    @relation("CriadorDieta")
  dietasModificadas    Dieta[]    @relation("ModificadorDieta")

  @@map("users")
}

model Animal {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.Text
  peso               Float
  dataNascimento     DateTime?            @db.DateTime(0)
  sexo               String               @db.Text
  photoUrl           String?              @db.Text
  dataCadastro       DateTime             @default(now()) @db.DateTime(0)
  ativo              Boolean              @default(true)
  especieId          Int
  racaId             Int?
  userId             Int
  exercise           String?              @db.Text      // ← Adicionado aqui
  periodicidade      String?              @db.Text      // Opcional: se quiser separar

  especie            Especie              @relation(fields: [especieId], references: [id])
  raca               Raca?                @relation(fields: [racaId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Remova ou comente este bloco se não for mais usar a tabela separada
  // tb_animal_exercise tb_animal_exercise[]

  dietas             Dieta[]
  exames             ExameNutricional[]
  ocorrencias        OcorrenciaSaude[]
  planosDieta  PlanoDieta[]

  @@index([especieId], map: "tb_animais_especieId_fkey")
  @@index([racaId], map: "tb_animais_racaId_fkey")
  @@index([userId], map: "tb_animais_userId_fkey")
  @@map("tb_animais")
}

model Especie {
  id      Int      @id @default(autoincrement())
  nome    String   @db.Text
  animais Animal[]
  composicoes   ComposicaoAlimento[]
  racas   Raca[]

  @@map("tb_especies")
}

model Raca {
  id        Int      @id @default(autoincrement())
  nome      String   @db.Text
  especieId Int
  animais   Animal[]
  especie   Especie  @relation(fields: [especieId], references: [id])

  @@index([especieId], map: "tb_racas_especieId_fkey")
  @@map("tb_racas")
}

model Dieta {
  id              Int       @id @default(autoincrement())
  animalId        Int
  alimentoId      Int
  qtdGramasDia    Float
  periodicidade   String?   @db.Text
  unidade         String?   @db.Text
  dataInicio      DateTime  @default(now()) @db.DateTime(0)
  dataFim         DateTime? @db.DateTime(0)
  horario         String?   @db.Text
  observacao      String?   @db.Text
  dataCriacao     DateTime  @default(now()) @db.DateTime(0)
  dataAlteracao   DateTime  @updatedAt @db.DateTime(0)
  criadopor       Int
  modificadopor   Int
  planoDietaId    Int?

  plano  PlanoDieta? @relation(fields: [planoDietaId], references: [id])
  alimento        Alimento  @relation(fields: [alimentoId], references: [id])
  animal          Animal    @relation(fields: [animalId], references: [id])
  userCriador     User      @relation("CriadorDieta", fields: [criadopor], references: [id])
  userModificador User      @relation("ModificadorDieta", fields: [modificadopor], references: [id])

  @@index([alimentoId], map: "tb_dieta_alimentoId_fkey")
  @@index([animalId], map: "tb_dieta_animalId_fkey")
  @@index([criadopor], map: "tb_dieta_criadopor_fkey")
  @@index([modificadopor], map: "tb_dieta_modificadopor_fkey")
  @@map("tb_dieta")
}

model Alimento {
  id          Int                  @id @default(autoincrement())
  nome        String               @db.Text
  categoria   String               @db.Text
  fabricante  String?              @db.Text
  forma       String?              @db.Text
  ativo       Boolean              @default(true)
  composicoes ComposicaoAlimento[]
  dietas      Dieta[]

  @@map("tb_alimentos")
}

model Nutriente {
  id            Int                  @id @default(autoincrement())
  nome          String               @db.Text
  categoria     String               @db.Text
  unidadePadrao String               @db.Text
  composicoes   ComposicaoAlimento[]
  exames        ExameNutricional[]
  exigenciasNRC ExigenciasNRC[]

  @@map("tb_nutrientes")
}

model PlanoDieta {
  id          Int      @id @default(autoincrement())
  animalId    Int
  nome        String   @db.VarChar(255)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now())

  animal Animal  @relation(fields: [animalId], references: [id])
  itens  Dieta[]

  @@map("tb_planos_dieta")
}

model ComposicaoAlimento {
  id          Int       @id @default(autoincrement())
  alimentoId  Int
  nutrienteId Int
  especieId   Int?
  valorPorKg  Float
  base        String    @default("Seca") @db.VarChar(50)
  alimento    Alimento  @relation(fields: [alimentoId], references: [id])
  nutriente   Nutriente @relation(fields: [nutrienteId], references: [id])
  especie     Especie?  @relation(fields: [especieId], references: [id])

  @@unique([alimentoId, nutrienteId])
  @@index([nutrienteId], map: "tb_composicao_alimento_nutrienteId_fkey")
  @@index([especieId])
  @@map("tb_composicao_alimento")
}

model ExameNutricional {
  id              Int       @id @default(autoincrement())
  animalId        Int
  nutrienteId     Int
  dataExame       DateTime  @db.DateTime(0)
  valorEncontrado Float
  unidade         String    @db.Text
  valorMinRef     Float?
  valorMaxRef     Float?
  observacao      String?   @db.Text
  arquivoUrl      String?   @db.Text
  animal          Animal    @relation(fields: [animalId], references: [id])
  nutriente       Nutriente @relation(fields: [nutrienteId], references: [id])

  @@index([animalId], map: "tb_exames_nutricionais_animalId_fkey")
  @@index([nutrienteId], map: "tb_exames_nutricionais_nutrienteId_fkey")
  @@map("tb_exames_nutricionais")
}

model OcorrenciaSaude {
  id          Int       @id @default(autoincrement())
  animalId    Int
  dataInicio  DateTime  @db.DateTime(0)
  dataFim     DateTime? @db.DateTime(0)
  problema    String    @db.Text
  tratamento  String?   @db.Text
  responsavel String?   @db.Text
  animal      Animal    @relation(fields: [animalId], references: [id])

  @@index([animalId], map: "tb_ocorrencias_saude_animalId_fkey")
  @@map("tb_ocorrencias_saude")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String   @db.Text
  email     String   @db.Text
  action    String   @db.Text
  timestamp DateTime @default(now()) @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "tb_audit_logs_userId_fkey")
  @@map("tb_audit_logs")
}

model ExigenciasNRC {
  id            Int       @id @default(autoincrement())
  nutrienteId   Int
  peso          Float     @db.Float
  tipoExercicio String    @db.VarChar(100)
  valorExigido  Float     @db.Float
  createdAt     DateTime  @default(now()) @db.DateTime(0)
  updatedAt     DateTime  @default(now()) @updatedAt @db.DateTime(0)
  nutriente     Nutriente @relation(fields: [nutrienteId], references: [id])

  @@unique([nutrienteId, peso, tipoExercicio], map: "tb_exigencias_nrc_unique")
  @@map("tb_exigencias_nrc")
}
