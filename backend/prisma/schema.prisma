model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String   @db.Text
  email     String   @db.Text
  action    String   @db.Text
  empresaId Int? // multi-tenant: sem FK — logs sobrevivem à exclusão da empresa
  timestamp DateTime @default(now())

  // Auditoria estruturada de exclusões/cancelamentos (migration 20260710000003)
  categoria  String? @db.Text // EXCLUSAO | CANCELAMENTO
  entidade   String? @db.Text // EVOLUCAO, PRESCRICAO, EXAME_CLINICO, VACINA, ENCAMINHAMENTO, AGENDAMENTO, ESTOQUE_FARMACIA, ...
  entidadeId Int?
  animalId   Int? // sem FK — log sobrevive à exclusão do animal
  motivo     String? @db.Text // justificativa informada pelo usuário (obrigatória nos endpoints de exclusão/cancelamento)
  detalhes   String? @db.Text // descrição legível do registro excluído/cancelado
  ip         String? @db.Text // IP de origem do request (migration 20260710000004)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([empresaId])
  @@index([categoria])
  @@index([timestamp])
  @@map("tb_audit_logs")
  @@schema("schs2vet")
}

model AiUsageLog {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  operacao      String
  // Módulo de origem da chamada (ver MODULOS_IA em src/ai) — alimenta o
  // relatório de consumo em /ai-usage. 'LEGADO' = registros anteriores à coluna.
  modulo        String   @default("LEGADO") @db.VarChar(40)
  modelo        String
  provedor      String   @default("google")
  tokensEntrada Int
  tokensSaida   Int
  tokensTotal   Int
  custoUsd      Float
  latenciaMs    Int
  userId        Int?
  animalId      Int?
  // Cliente (tenant) a quem o consumo é atribuído — base do metering/faturamento.
  // Sem FK de propósito: o log sobrevive à exclusão da empresa (igual AuditLog).
  empresaId     Int?     @map("empresa_id")
  sucesso       Boolean  @default(true)
  erroMensagem  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([operacao])
  @@index([modulo])
  @@index([modulo, createdAt])
  @@index([empresaId])
  @@index([empresaId, createdAt])
  @@map("tb_ai_usage_logs")
  @@schema("schs2vet")
}

