// =============================================================================
// S2Vet — Prisma Schema
// Provider : PostgreSQL
// Schema   : schs2vet
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["schs2vet"]
}

// =============================================================================
// USUÁRIOS
// =============================================================================

model User {
  id                   Int       @id @default(autoincrement())
  fullName             String    @db.VarChar(255)
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @db.VarChar(255)
  phone                String?   @db.VarChar(30)
  phone2               String?   @db.VarChar(30)
  role                 String    @default("USER") @db.VarChar(50)
  userType             String    @default("PROPRIETARIO") @db.VarChar(50)
  cep                  String?   @db.VarChar(10)
  endereco             String?   @db.VarChar(255)
  complemento          String?   @db.VarChar(100)
  bairro               String?   @db.VarChar(100)
  cidade               String?   @db.VarChar(100)
  estado               String?   @db.VarChar(2)
  createdAt            DateTime  @default(now())
  ativo                Boolean   @default(true)
  resetPasswordToken   String?   @unique @db.VarChar(255)
  resetPasswordExpires DateTime?
  mustChangePassword   Boolean   @default(false)
  isConvidado          Boolean   @default(false)
  refreshToken         String?   @db.VarChar(512)
  cpf               String?  @db.VarChar(14)
  cnpj              String?  @db.VarChar(18)
  mensalista        Boolean  @default(false)
  valorAssistencia  Float?
  frequenciaVisitas Int?
  empresaId         Int?     @map("empresa_id")
  equipeId          Int?     @map("equipe_id") // equipe que cadastrou o proprietário (segregação por equipe)

  empresa              Empresa?               @relation("ProprietarioEmpresa", fields: [empresaId], references: [id], onDelete: SetNull)
  equipe               Equipe?                @relation("ProprietarioEquipe", fields: [equipeId], references: [id], onDelete: SetNull)
  animais              Animal[]
  auditLogs            AuditLog[]
  dietasCriadas        Dieta[]                @relation("CriadorDieta")
  dietasModificadas    Dieta[]                @relation("ModificadorDieta")
  evolucoesCriadas     EvolucaoClinica[]      @relation("EvolucaoVeterinario")
  evolucoesModificadas EvolucaoClinica[]      @relation("EvolucaoModificadoPor")
  prescricoes          Prescricao[]           @relation("PrescricaoVeterinario")
  prescricaoGrupos          PrescricaoGrupo[]      @relation("PrescricaoGrupoVet")
  prescricaoGruposFinalizou PrescricaoGrupo[]      @relation("PrescricaoGrupoFinaliza")
  prescricaoGruposExecutou  PrescricaoGrupo[]      @relation("PrescricaoGrupoExecuta")
  vacinas              VacinaClinica[]        @relation("VacinaVeterinario")
  encaminhamentos      EncaminhamentoClinico[] @relation("EncaminhamentoVeterinario")
  examesClinicos       ExameClinico[]         @relation("ExameClinicoVeterinario")
  faturaItens          FaturaItem[]           @relation("FaturaItemVet")
  faturas              Fatura[]               @relation("FaturaProprietario")
  aiUsageLogs          AiUsageLog[]
  vetPerfil            VetPerfil?
  vetSolicitacoes      VetAnimalSolicitacao[] @relation("VetSolicitacoes")
  novasVetSolicitacoes VetAnimalSolicitacao[] @relation("NovoVetSolicitacoes")
  empresasOwner        Empresa[]              @relation("EmpresaOwner")
  membrosEquipe        MembroEquipe[]
  permissoesMembro       PermissaoMembro[]
  permissoesProprietario PermissaoProprietario[]
  fornecedorPerfil         Fornecedor?             @relation("FornecedorUser")
  encaminhamentosRecebidos EncaminhamentoClinico[] @relation("EncaminhamentoPrestador")
  designacoesComoPrestador DesignacaoPrestador[]   @relation("DesignacaoPrestadorUser")
  designacoesCriadas       DesignacaoPrestador[]   @relation("DesignacaoCriadoPor")
  agendamentosComoVet      AgendamentoClinico[]    @relation("AgendamentoVeterinario")
  agendamentosCriados      AgendamentoClinico[]    @relation("AgendamentoCriadoPor")
  resenhasCriadas          ResenhaEquino[]         @relation("ResenhasCriadas")
  resenhasGraficasCriadas  ResenhaGrafica[]        @relation("ResenhaGraficaCriadaPor")
  @@index([equipeId])
  @@map("users")
  @@schema("schs2vet")
}

// =============================================================================
// ANIMAIS
// =============================================================================

model Animal {
  id                 Int      @id @default(autoincrement())
  nome               String   @db.Text
  peso               Float
  dataNascimento     DateTime?
  sexo               String   @db.Text
  photoUrl           String?  @db.Text
  dataCadastro       DateTime @default(now())
  ativo              Boolean  @default(true)
  especieId          Int
  racaId             Int?
  userId             Int
  empresaId          Int?     // multi-tenant: clínica principal que gerencia este animal
  equipeId           Int?     // equipe responsável dentro da empresa (segregação de permissões)
  categoriaAnimal    String?  @db.VarChar(100)
  tipoExercicio      String?  @db.VarChar(100)
  veterinarioNome    String?  @db.VarChar(255)
  veterinarioClinica String?  @db.VarChar(255)
  local              String?  @db.VarChar(255)
  baia               String?  @db.VarChar(100)
  idadeAnos          Int?
  localizacaoId      Int?      @map("localizacao_id")
  tratadorId         Int?      @map("tratador_id")
  bloqueado          Boolean   @default(false)
  bloqueioTipo       String?   @db.VarChar(30) @map("bloqueio_tipo")
  bloqueioExpira     DateTime? @map("bloqueio_expira")
  pelagem            String?   @db.VarChar(100)
  altura             String?   @db.VarChar(50)
  registroPassaporte String?   @db.VarChar(100) @map("registro_passaporte")
  finalidade         String?   @db.VarChar(100)
  seguradora         String?   @db.VarChar(150)

  especie         Especie              @relation(fields: [especieId],    references: [id])
  raca            Raca?                @relation(fields: [racaId],       references: [id])
  user            User                 @relation(fields: [userId],       references: [id], onDelete: Cascade)
  empresa         Empresa?             @relation("EmpresaAnimais", fields: [empresaId], references: [id], onDelete: SetNull)
  equipe          Equipe?              @relation("EquipeAnimais", fields: [equipeId], references: [id], onDelete: SetNull)
  localizacao     LocalizacaoAnimal?   @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  tratador        Tratador?            @relation(fields: [tratadorId],   references: [id], onDelete: SetNull)
  dietas          Dieta[]
  exames          ExameNutricional[]
  ocorrencias     OcorrenciaSaude[]
  planosDieta     PlanoDieta[]
  relatorios      RelatorioSalvo[]
  evolucoes       EvolucaoClinica[]      @relation("AnimalEvolucoes")
  prescricoes      Prescricao[]           @relation("AnimalPrescricoes")
  prescricaoGrupos PrescricaoGrupo[]     @relation("AnimalPrescricaoGrupos")
  vacinas          VacinaClinica[]       @relation("AnimalVacinas")
  encaminhamentos EncaminhamentoClinico[] @relation("AnimalEncaminhamentos")
  examesClinicos  ExameClinico[]         @relation("AnimalExamesClinicos")
  faturas         Fatura[]               @relation("AnimalFaturas")
  faturaItens     FaturaItem[]           @relation("FaturaItemAnimal")
  solicitacoes    VetAnimalSolicitacao[] @relation("AnimalSolicitacoes")
  reservasEstoque ReservaEstoque[]       @relation("AnimalReservas")
  designacoes     DesignacaoPrestador[]  @relation("AnimalDesignacoes")
  agendamentos    AgendamentoClinico[]   @relation("AnimalAgendamentos")
  resenha         ResenhaEquino?         @relation("AnimalResenha")
  resenhasGraficas ResenhaGrafica[]      @relation("ResenhaGraficaAnimal")

  @@index([especieId])
  @@index([racaId])
  @@index([userId])
  @@index([empresaId])
  @@index([equipeId])
  @@index([localizacaoId])
  @@index([tratadorId])
  @@map("tb_animais")
  @@schema("schs2vet")
}

// =============================================================================
// ESPÉCIES E RAÇAS
// =============================================================================

model Especie {
  id            Int                  @id @default(autoincrement())
  nome          String               @db.Text
  animais       Animal[]
  composicoes   ComposicaoAlimento[]
  racas         Raca[]
  exigenciasNRC ExigenciasNRC[]
  vetEspecies   VetEspecie[]
  medicamentos  MedicamentoEspecie[]

  @@map("tb_especies")
  @@schema("schs2vet")
}

model Raca {
  id        Int      @id @default(autoincrement())
  nome      String   @db.Text
  especieId Int
  animais   Animal[]
  especie   Especie  @relation(fields: [especieId], references: [id])

  @@index([especieId])
  @@map("tb_racas")
  @@schema("schs2vet")
}

// =============================================================================
// DIETAS E PLANOS
// =============================================================================

model PlanoDieta {
  id          Int      @id @default(autoincrement())
  animalId    Int
  nome        String   @db.VarChar(255)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now())

  animal Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  itens  Dieta[]

  @@map("tb_planos_dieta")
  @@schema("schs2vet")
}

model Dieta {
  id            Int       @id @default(autoincrement())
  animalId      Int
  alimentoId    Int
  qtdGramasDia  Float
  periodicidade String?   @db.Text
  unidade       String?   @db.Text
  dataInicio    DateTime  @default(now())
  dataFim       DateTime?
  horario       String?   @db.Text
  observacao    String?   @db.Text
  dataCriacao   DateTime  @default(now())
  dataAlteracao DateTime  @updatedAt
  criadopor     Int?
  modificadopor Int?
  planoDietaId  Int?

  plano           PlanoDieta? @relation(fields: [planoDietaId],  references: [id])
  alimento        Alimento    @relation(fields: [alimentoId],    references: [id])
  animal          Animal      @relation(fields: [animalId],      references: [id], onDelete: Cascade)
  userCriador     User?       @relation("CriadorDieta",     fields: [criadopor],     references: [id], onDelete: SetNull)
  userModificador User?       @relation("ModificadorDieta", fields: [modificadopor], references: [id], onDelete: SetNull)

  @@index([alimentoId])
  @@index([animalId])
  @@index([criadopor])
  @@index([modificadopor])
  @@map("tb_dieta")
  @@schema("schs2vet")
}

// =============================================================================
// ALIMENTOS E NUTRIENTES
// =============================================================================

model Alimento {
  id          Int                  @id @default(autoincrement())
  nome        String               @db.Text
  categoria   String               @db.Text
  fabricante  String?              @db.Text
  forma       String?              @db.Text
  ativo       Boolean              @default(true)
  composicoes ComposicaoAlimento[]
  dietas      Dieta[]

  @@map("tb_alimentos")
  @@schema("schs2vet")
}

model Nutriente {
  id            Int                  @id @default(autoincrement())
  nome          String               @db.Text
  categoria     String               @db.Text
  unidadePadrao String               @db.Text
  composicoes   ComposicaoAlimento[]
  exames        ExameNutricional[]
  exigenciasNRC ExigenciasNRC[]

  @@map("tb_nutrientes")
  @@schema("schs2vet")
}

model ComposicaoAlimento {
  id          Int       @id @default(autoincrement())
  alimentoId  Int
  nutrienteId Int
  especieId   Int?
  valorPorKg  Float
  base        String    @default("Seca") @db.VarChar(50)

  alimento  Alimento  @relation(fields: [alimentoId],  references: [id])
  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])
  especie   Especie?  @relation(fields: [especieId],   references: [id])

  @@unique([alimentoId, nutrienteId])
  @@index([nutrienteId])
  @@index([especieId])
  @@map("tb_composicao_alimento")
  @@schema("schs2vet")
}

model ExigenciasNRC {
  id              Int       @id @default(autoincrement())
  nutrienteId     Int
  peso            Int
  categoriaAnimal String?   @db.VarChar(100)
  tipoExercicio   String    @db.VarChar(100)
  valorExigido    Float
  unidade         String?   @db.VarChar(20)
  fonte           String?   @db.VarChar(100)
  especieId       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])
  especie   Especie?  @relation(fields: [especieId],   references: [id])

  @@unique([nutrienteId, peso, categoriaAnimal, tipoExercicio])
  @@index([nutrienteId])
  @@index([especieId])
  @@map("tb_exigencias_nrc")
  @@schema("schs2vet")
}

// =============================================================================
// EXAMES
// =============================================================================

model ExameNutricional {
  id              Int       @id @default(autoincrement())
  animalId        Int
  nutrienteId     Int
  dataExame       DateTime
  valorEncontrado Float
  unidade         String    @db.Text
  valorMinRef     Float?
  valorMaxRef     Float?
  observacao      String?   @db.Text
  arquivoUrl      String?   @db.Text

  animal    Animal    @relation(fields: [animalId],    references: [id], onDelete: Cascade)
  nutriente Nutriente @relation(fields: [nutrienteId], references: [id])

  @@index([animalId])
  @@index([nutrienteId])
  @@map("tb_exames_nutricionais")
  @@schema("schs2vet")
}

model ExameClinico {
  id              Int       @id @default(autoincrement())
  animalId        Int
  veterinarioId   Int?
  evolucaoId      Int?      @map("evolucao_id")
  tipo            String
  descricao       String
  status          String    @default("SOLICITADO")
  resultado       String?   @db.Text
  dataSolicitacao DateTime  @default(now())
  dataResultado   DateTime?
  arquivoUrl      String?
  observacao      String?   @db.Text
  qtdAmostra      Int?      @map("qtd_amostra")
  numero          Int?
  ativo           Boolean   @default(true)

  animal      Animal           @relation("AnimalExamesClinicos",    fields: [animalId],      references: [id], onDelete: Cascade)
  veterinario User?            @relation("ExameClinicoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica? @relation("EvolucaoExames",          fields: [evolucaoId],    references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([evolucaoId])
  @@map("tb_exames_clinicos")
  @@schema("schs2vet")
}

// =============================================================================
// OCORRÊNCIAS DE SAÚDE
// =============================================================================

model OcorrenciaSaude {
  id          Int       @id @default(autoincrement())
  animalId    Int
  dataInicio  DateTime
  dataFim     DateTime?
  problema    String    @db.Text
  tratamento  String?   @db.Text
  responsavel String?   @db.Text

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("tb_ocorrencias_saude")
  @@schema("schs2vet")
}

// =============================================================================
// CLÍNICA — EVOLUÇÕES, PRESCRIÇÕES, VACINAS, ENCAMINHAMENTOS
// =============================================================================

model EvolucaoClinica {
  id                    Int       @id @default(autoincrement())
  animalId              Int
  veterinarioId         Int?
  modificadoPorId       Int?
  agendamentoId         Int?      @map("agendamento_id")
  especialidade         String
  status                String    @default("EM_ANDAMENTO")
  texto                 String    @db.Text
  titulo                String?   @db.VarChar(255)
  numero                Int?      // sequencial por animal dentro do tipo (EV-0001 ou herdado do AG)
  tipoAtendimento       String?   @default("EV") @db.VarChar(2) @map("tipo_atendimento") // 'AG' | 'EV'
  dataInicio            DateTime  @default(now())
  dataFim               DateTime?
  dataModificacao       DateTime?
  ativo                 Boolean   @default(true)
  justificativaExclusao String?   @db.Text
  aprovado              Boolean   @default(true)

  animal            Animal              @relation("AnimalEvolucoes",       fields: [animalId],        references: [id], onDelete: Cascade)
  veterinario       User?               @relation("EvolucaoVeterinario",   fields: [veterinarioId],   references: [id], onDelete: SetNull)
  modificadoPor     User?               @relation("EvolucaoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)
  agendamento       AgendamentoClinico? @relation("AgendamentoEvolucoes",  fields: [agendamentoId],   references: [id], onDelete: SetNull)
  midias            EvolucaoMidia[]
  prescricaoGrupos  PrescricaoGrupo[]   @relation("EvolucaoPrescricaoGrupos")
  vacinasClinicas   VacinaClinica[]     @relation("EvolucaoVacinas")
  examesClinicos    ExameClinico[]      @relation("EvolucaoExames")
  encaminhamentos   EncaminhamentoClinico[] @relation("EvolucaoEncaminhamentos")

  @@index([agendamentoId])
  @@map("tb_evolucoes_clinicas")
  @@schema("schs2vet")
}

model EvolucaoMidia {
  id         Int             @id @default(autoincrement())
  evolucaoId Int
  tipo       String          @db.VarChar(10)
  url        String          @db.VarChar(500)
  nome       String          @db.VarChar(255)
  tamanho    Int?
  criadoEm  DateTime         @default(now())

  evolucao   EvolucaoClinica @relation(fields: [evolucaoId], references: [id], onDelete: Cascade)

  @@map("tb_evolucao_midias")
  @@schema("schs2vet")
}

model Prescricao {
  id                  Int       @id @default(autoincrement())
  animalId            Int
  veterinarioId       Int?
  grupoId             Int?      // FK para PrescricaoGrupo (null = item legado sem grupo)
  medicamentoCatId    Int?      // FK para Medicamento quando selecionado do catálogo
  tipo                String    @default("MEDICAMENTO")
  medicamento         String    // nome livre ou nome do catálogo
  dose                String    @default("")
  dosagem             String?
  unidade             String?
  frequencia          String    @default("")
  duracao             String    @default("")
  duracaoDias         Int       @default(1)
  diasAplicacaoInicio Int       @default(1)
  diasAplicacaoFim    Int?
  horaInicio          String?
  via                 String    @default("Oral")
  observacao          String?
  status              String    @default("RASCUNHO")  // RASCUNHO(=SALVO) | ATIVA(=FINALIZADO) | CANCELADA
  horariosGerados     Json?
  dataInicio          DateTime  @default(now())
  dataFim             DateTime?
  ativo               Boolean   @default(true)
  aprovado            Boolean   @default(true)
  medicamentoCliente  Boolean   @default(false)

  animal           Animal           @relation("AnimalPrescricoes",     fields: [animalId],         references: [id], onDelete: Cascade)
  veterinario      User?            @relation("PrescricaoVeterinario", fields: [veterinarioId],    references: [id], onDelete: SetNull)
  grupo            PrescricaoGrupo? @relation("GrupoPrescricoes",      fields: [grupoId],          references: [id])
  medicamentoCat   Medicamento?     @relation("MedicamentoPrescricoes", fields: [medicamentoCatId], references: [id])

  @@index([animalId])
  @@index([veterinarioId])
  @@index([grupoId])
  @@map("tb_prescricoes")
  @@schema("schs2vet")
}

// Documento de prescrição (agrupa itens Medicamento/Procedimento)
model PrescricaoGrupo {
  id              Int       @id @default(autoincrement())
  numero          Int                              // sequencial por animal (1=001, 2=002…)
  animalId        Int
  veterinarioId   Int?
  empresaId       Int?
  evolucaoId      Int?      @map("evolucao_id")   // evolução que originou este grupo
  status          String    @default("SALVO")      // SALVO | FINALIZADO | EXECUTADO | CANCELADO | CANCELADO_PARCIALMENTE
  motivoCancelamento String? @db.Text
  finalizadoPorId Int?
  finalizadoEm    DateTime?
  executadoPorId  Int?
  executadoEm     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  animal        Animal           @relation("AnimalPrescricaoGrupos",    fields: [animalId],        references: [id], onDelete: Cascade)
  veterinario   User?            @relation("PrescricaoGrupoVet",        fields: [veterinarioId],   references: [id], onDelete: SetNull)
  finalizadoPor User?            @relation("PrescricaoGrupoFinaliza",   fields: [finalizadoPorId], references: [id], onDelete: SetNull)
  executadoPor  User?            @relation("PrescricaoGrupoExecuta",    fields: [executadoPorId],  references: [id], onDelete: SetNull)
  evolucao      EvolucaoClinica? @relation("EvolucaoPrescricaoGrupos",  fields: [evolucaoId],      references: [id], onDelete: SetNull)
  itens         Prescricao[]     @relation("GrupoPrescricoes")
  reservas      ReservaEstoque[] @relation("GrupoReservas")

  @@unique([animalId, numero])
  @@index([animalId])
  @@index([veterinarioId])
  @@index([status])
  @@index([evolucaoId])
  @@map("tb_prescricao_grupos")
  @@schema("schs2vet")
}

// Catálogo global de procedimentos veterinários
model ProcedimentoVeterinario {
  id               Int      @id @default(autoincrement())
  codigo           String?  @unique @db.VarChar(50)
  nome             String   @db.VarChar(255)
  nomeAbreviado    String?  @db.VarChar(100)
  descricao        String?  @db.Text
  categoria        String   @db.VarChar(100)
  subcategoria     String?  @db.VarChar(100)
  especialidade    String?  @db.VarChar(100)
  tipoProcedimento String?  @db.VarChar(50)   // CLINICO | CIRURGICO | DIAGNOSTICO
  duracao          Int?                        // minutos
  requerAnestesia  Boolean  @default(false)
  requerInternacao Boolean  @default(false)
  risco            String?  @db.VarChar(20)   // BAIXO | MEDIO | ALTO
  valorCusto       Float?
  valorVenda       Float?
  especie          String?  @db.VarChar(50)    // Bovino | Equino | Bovino e Equino
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ativo])
  @@index([categoria])
  @@index([especie])
  @@map("tb_procedimentos_vet")
  @@schema("schs2vet")
}

model Vacina {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(255)
  fabricante String?  @db.VarChar(255)
  via        String   @default("Subcutânea (SC)") @db.VarChar(100)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  lotes      LoteVacina[]
  aplicacoes VacinaClinica[] @relation("VacinaAplicacoes")

  @@index([ativo])
  @@map("tb_vacinas")
  @@schema("schs2vet")
}

model LoteVacina {
  id              Int       @id @default(autoincrement())
  vacinaId        Int?      @map("vacina_id")
  empresaId       Int?      @map("empresa_id")
  medicamentoCatId Int?     @map("medicamento_cat_id")
  lote            String    @db.VarChar(100)
  validade        DateTime
  qtdTotal        Int       @default(0) @map("qtd_total")
  qtdDisponivel   Int       @default(0) @map("qtd_disponivel")
  dosesPorFrasco  Int       @default(1)  @map("doses_por_frasco")
  qtdFrascos      Int       @default(0)  @map("qtd_frascos")
  validadeHoras   Int?      @map("validade_horas")
  validadeDias    Int       @default(0)  @map("validade_dias")
  valorUnitario          Float?    @map("valor_unitario")
  valorUnitarioRepassado Float?    @map("valor_unitario_repassado")
  dataRecebimento        DateTime? @map("data_recebimento")
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")

  vacina         Vacina?      @relation(fields: [vacinaId],         references: [id], onDelete: Cascade)
  medicamentoCat Medicamento? @relation("MedicamentoLotes",         fields: [medicamentoCatId], references: [id], onDelete: SetNull)
  empresa        Empresa?     @relation("LoteVacinaEmpresa",        fields: [empresaId],        references: [id], onDelete: SetNull)
  aplicacoes     VacinaClinica[] @relation("LoteAplicacoes")

  @@index([vacinaId])
  @@index([empresaId])
  @@index([medicamentoCatId])
  @@map("tb_lotes_vacina")
  @@schema("schs2vet")
}

model VacinaClinica {
  id               Int       @id @default(autoincrement())
  animalId         Int
  veterinarioId    Int?
  vacinaId         Int?      @map("vacina_id")
  loteId           Int?      @map("lote_id")
  medicamentoCatId Int?      @map("medicamento_cat_id")
  evolucaoId       Int?      @map("evolucao_id")
  nome             String
  fabricante       String?
  lote             String?
  dose             String?   @db.VarChar(50)
  via              String?   @db.VarChar(100)
  numero           Int?
  tipoAtendimento  String?   @default("VC") @db.VarChar(2) @map("tipo_atendimento")
  quantidade       Int?      @default(1)
  valor            Decimal?  @db.Decimal(10, 2)
  cliente          Boolean   @default(false)
  dataAplicacao      DateTime  @default(now())
  dataReforco        DateTime?
  observacao         String?   @db.Text
  ativo              Boolean   @default(true)
  motivoInativacao   String?   @map("motivo_inativacao") @db.Text

  animal      Animal           @relation("AnimalVacinas",     fields: [animalId],      references: [id], onDelete: Cascade)
  veterinario User?            @relation("VacinaVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  vacina      Vacina?          @relation("VacinaAplicacoes",  fields: [vacinaId],      references: [id], onDelete: SetNull)
  loteVacina  LoteVacina?      @relation("LoteAplicacoes",    fields: [loteId],        references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica? @relation("EvolucaoVacinas",   fields: [evolucaoId],    references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([vacinaId])
  @@index([evolucaoId])
  @@map("tb_vacinas_clinicas")
  @@schema("schs2vet")
}

// Agendamentos do animal (consultas, vacinas, retornos, exames, procedimentos)
// Exibidos no painel "Agendamentos" da tela do animal (AnimalDetail)
model AgendamentoClinico {
  id            Int      @id @default(autoincrement())
  animalId      Int      @map("animal_id")
  veterinarioId Int?     @map("veterinario_id")
  tipo          String   @default("CONSULTA") @db.VarChar(20) // CONSULTA|VACINA|RETORNO|EXAME|PROCEDIMENTO
  titulo        String   @db.VarChar(255)
  dataHora      DateTime @map("data_hora")
  observacao    String?  @db.Text
  status        String   @default("AGENDADO") @db.VarChar(20) // AGENDADO|CONCLUIDO|CANCELADO
  ativo         Boolean  @default(true)
  numero        Int?     // sequencial por animal (AG-0001)
  criadoPorId   Int?     @map("criado_por_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  animal      Animal               @relation("AnimalAgendamentos",     fields: [animalId],      references: [id], onDelete: Cascade)
  veterinario User?                @relation("AgendamentoVeterinario", fields: [veterinarioId], references: [id], onDelete: SetNull)
  criadoPor   User?                @relation("AgendamentoCriadoPor",   fields: [criadoPorId],   references: [id], onDelete: SetNull)
  evolucoes   EvolucaoClinica[]    @relation("AgendamentoEvolucoes")

  @@unique([animalId, numero])
  @@index([animalId, dataHora])
  @@map("tb_agendamentos_clinicos")
  @@schema("schs2vet")
}

model EncaminhamentoClinico {
  id                 Int      @id @default(autoincrement())
  animalId           Int
  veterinarioId      Int?
  prestadorId        Int?     @map("prestador_id") // prestador da equipe (User FORNECEDOR) — null = destino externo
  evolucaoId         Int?     @map("evolucao_id")
  especialidade      String
  motivo             String   @db.Text
  veterinarioDestino String?
  clinicaDestino     String?
  urgencia           String   @default("NORMAL")
  status             String   @default("PENDENTE")
  dataEncaminhamento DateTime @default(now())
  observacao         String?  @db.Text
  ativo              Boolean  @default(true)

  animal      Animal           @relation("AnimalEncaminhamentos",        fields: [animalId],      references: [id], onDelete: Cascade)
  veterinario User?            @relation("EncaminhamentoVeterinario",    fields: [veterinarioId], references: [id], onDelete: SetNull)
  prestador   User?            @relation("EncaminhamentoPrestador",      fields: [prestadorId],   references: [id], onDelete: SetNull)
  evolucao    EvolucaoClinica? @relation("EvolucaoEncaminhamentos",      fields: [evolucaoId],    references: [id], onDelete: SetNull)
  designacoes DesignacaoPrestador[] @relation("EncaminhamentoDesignacoes")

  @@index([prestadorId])
  @@index([evolucaoId])
  @@map("tb_encaminhamentos_clinicos")
  @@schema("schs2vet")
}

// Designação de prestador (User FORNECEDOR) a um animal específico.
// É o escopo de acesso do prestador: ele só enxerga animais com designação ativa.
// Criada automaticamente ao encaminhar para um prestador da equipe; inativada ao
// concluir/cancelar o encaminhamento (ou manualmente pelo gestor).
model DesignacaoPrestador {
  id               Int       @id @default(autoincrement())
  animalId         Int       @map("animal_id")
  prestadorId      Int       @map("prestador_id")      // User userType=FORNECEDOR
  equipeId         Int       @map("equipe_id")          // equipe que designou (segregação multi-empresa)
  encaminhamentoId Int?      @map("encaminhamento_id")  // origem clínica, quando criada via encaminhamento
  motivo           String?   @db.VarChar(255)
  ativo            Boolean   @default(true)
  dataInicio       DateTime  @default(now()) @map("data_inicio")
  dataFim          DateTime? @map("data_fim")
  criadoPorId      Int?      @map("criado_por_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  animal         Animal                 @relation("AnimalDesignacoes",        fields: [animalId],         references: [id], onDelete: Cascade)
  prestador      User                   @relation("DesignacaoPrestadorUser",  fields: [prestadorId],      references: [id], onDelete: Cascade)
  equipe         Equipe                 @relation("EquipeDesignacoes",        fields: [equipeId],         references: [id], onDelete: Cascade)
  encaminhamento EncaminhamentoClinico? @relation("EncaminhamentoDesignacoes", fields: [encaminhamentoId], references: [id], onDelete: SetNull)
  criadoPor      User?                  @relation("DesignacaoCriadoPor",      fields: [criadoPorId],      references: [id], onDelete: SetNull)

  @@unique([animalId, prestadorId, equipeId])
  @@index([prestadorId, ativo])
  @@index([equipeId])
  @@index([encaminhamentoId])
  @@map("tb_designacoes_prestador")
  @@schema("schs2vet")
}

// =============================================================================
// FINANCEIRO
// =============================================================================

model Fatura {
  id              Int          @id @default(autoincrement())
  animalId        Int?         // legado — manter para compatibilidade com prescricoes antigas
  proprietarioId  Int?
  mesReferencia   String?      @db.VarChar(7)  // "2026-06"
  total           Float        @default(0)
  status          String       @default("ABERTA")  // ABERTA | PAGA | CANCELADA
  criadoEm        DateTime     @default(now())
  itens           FaturaItem[]

  animal       Animal? @relation("AnimalFaturas",      fields: [animalId],       references: [id])
  proprietario User?   @relation("FaturaProprietario", fields: [proprietarioId], references: [id], onDelete: SetNull)

  @@index([proprietarioId, status])
  @@map("tb_faturas")
  @@schema("schs2vet")
}

model FaturaItem {
  id            Int      @id @default(autoincrement())
  faturaId      Int
  animalId      Int?
  tipo          String   @db.VarChar(50)   // ASSISTENCIA | MEDICAMENTO | PROCEDIMENTO
  descricao     String
  valor         Float    @default(0)
  quantidade    Float    @default(1)
  veterinarioId Int?
  criadoEm      DateTime @default(now())

  fatura      Fatura  @relation(fields: [faturaId],      references: [id])
  animal      Animal? @relation("FaturaItemAnimal", fields: [animalId], references: [id])
  veterinario User?   @relation("FaturaItemVet",    fields: [veterinarioId], references: [id], onDelete: SetNull)

  @@map("tb_fatura_itens")
  @@schema("schs2vet")
}

// =============================================================================
// RELATÓRIOS
// =============================================================================

model RelatorioSalvo {
  id             Int      @id @default(autoincrement())
  animalId       Int
  planoDietaId   Int?
  payload        String   @db.Text
  fonteCalculo   String   @db.VarChar(50)
  pesoCalculado  Float?
  categoriaUsada String?  @db.VarChar(100)
  especieNome    String?  @db.VarChar(100)
  geradoEm       DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([geradoEm])
  @@map("tb_relatorios_salvos")
  @@schema("schs2vet")
}

// =============================================================================
// AUDITORIA E IA
// =============================================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String   @db.Text
  email     String   @db.Text
  action    String   @db.Text
  empresaId Int?     // multi-tenant: sem FK — logs sobrevivem à exclusão da empresa
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([empresaId])
  @@map("tb_audit_logs")
  @@schema("schs2vet")
}

model AiUsageLog {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  operacao     String
  modelo       String
  provedor     String   @default("groq")
  tokensEntrada Int
  tokensSaida  Int
  tokensTotal  Int
  custoUsd     Float
  latenciaMs   Int
  userId       Int?
  animalId     Int?
  sucesso      Boolean  @default(true)
  erroMensagem String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([operacao])
  @@map("tb_ai_usage_logs")
  @@schema("schs2vet")
}

// =============================================================================
// VETERINÁRIO — PERFIL, ESPÉCIES, SUBESPECIALIDADES
// =============================================================================

model VetPerfil {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  crmv      String?  @unique @db.VarChar(20)
  bio       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  especies          VetEspecie[]
  subespecialidades VetSubespecialidade[]

  @@map("tb_vet_perfil")
  @@schema("schs2vet")
}

model VetEspecie {
  id          Int @id @default(autoincrement())
  vetPerfilId Int
  especieId   Int

  vetPerfil VetPerfil @relation(fields: [vetPerfilId], references: [id], onDelete: Cascade)
  especie   Especie   @relation(fields: [especieId],   references: [id], onDelete: Cascade)

  @@unique([vetPerfilId, especieId])
  @@map("tb_vet_especies")
  @@schema("schs2vet")
}

model VetSubespecialidade {
  id          Int      @id @default(autoincrement())
  vetPerfilId Int
  nome        String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  vetPerfil VetPerfil @relation(fields: [vetPerfilId], references: [id], onDelete: Cascade)

  @@map("tb_vet_subespecialidades")
  @@schema("schs2vet")
}

model VetAnimalSolicitacao {
  id              Int       @id @default(autoincrement())
  animalId        Int
  vetUserId       Int
  status          String    @default("PENDENTE")
  mensagem        String?   @db.Text
  approvalToken   String?   @unique @db.VarChar(64)
  expiresAt       DateTime?
  solicitanteId   Int?
  tipo            String    @default("VINCULO") // VINCULO | DESVINCULO | TROCA_VET
  novoVetUserId   Int?      // TROCA_VET: ID do novo vet a ser vinculado após aceite do vet atual
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  animal          Animal @relation("AnimalSolicitacoes",    fields: [animalId],      references: [id], onDelete: Cascade)
  veterinario     User   @relation("VetSolicitacoes",       fields: [vetUserId],     references: [id], onDelete: Cascade)
  novoVeterinario User?  @relation("NovoVetSolicitacoes",   fields: [novoVetUserId], references: [id], onDelete: SetNull)

  @@unique([animalId, vetUserId])
  @@index([approvalToken])
  @@index([novoVetUserId])
  @@map("tb_vet_animal_solicitacoes")
  @@schema("schs2vet")
}

// =============================================================================
// EMPRESA E EQUIPES
// =============================================================================

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String?
  telefone  String?
  endereco  String?
  ownerId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner           User?            @relation("EmpresaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  proprietarios   User[]           @relation("ProprietarioEmpresa")
  equipes         Equipe[]
  animais         Animal[]         @relation("EmpresaAnimais")
  estoques    EstoqueClinica[] @relation("EmpresaEstoque")
  loteVacinas LoteVacina[]     @relation("LoteVacinaEmpresa")

  // Duplicidade: mesmo gestor (ownerId ≡ e-mail único) + mesmo nome + mesmo CNPJ é bloqueado.
  // cnpj NULL (empresa pessoal/CPF): Postgres trata NULLs como distintos — enforcement na aplicação.
  @@unique([ownerId, nome, cnpj])
  @@map("tb_empresas")
  @@schema("schs2vet")
}

model Equipe {
  id        Int             @id @default(autoincrement())
  nome      String
  empresaId Int
  createdAt DateTime        @default(now())

  empresa  Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  membros  MembroEquipe[]
  convites ConviteEquipe[]
  permissoesMembros       PermissaoMembro[]
  permissoesProprietarios PermissaoProprietario[]
  perfis                  PerfilEquipe[]
  animais                 Animal[]                @relation("EquipeAnimais")
  proprietarios           User[]                  @relation("ProprietarioEquipe")
  designacoesPrestador    DesignacaoPrestador[]   @relation("EquipeDesignacoes")

  @@unique([empresaId, nome])
  @@map("tb_equipes")
  @@schema("schs2vet")
}

model MembroEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int
  userId    Int
  cargo     String
  cargos    String[] @default([])
  createdAt DateTime @default(now())

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([equipeId, userId])
  @@map("tb_membros_equipe")
  @@schema("schs2vet")
}

model ConviteEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int
  email     String
  cargo     String
  token     String   @unique @default(uuid())
  status    String   @default("PENDENTE")
  expiresAt DateTime
  createdAt DateTime @default(now())

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@map("tb_convites_equipe")
  @@schema("schs2vet")
}

// Catálogo imutável de módulos e ações do sistema.
// Populado via seed — NUNCA alterado em runtime.
model ModuloSistema {
  id        Int    @id @default(autoincrement())
  slug      String @unique // "atendimento.evolucoes.criar"
  modulo    String @db.VarChar(50)   // "atendimento"
  submodulo String @db.VarChar(50)   // "evolucoes"
  acao      String @db.VarChar(50)   // "criar"
  label     String @db.VarChar(150)  // "Evoluções — Criar"
  ordemExib Int    @default(0)

  permissoes   PermissaoMembro[]
  matrizPerfis MatrizPerfil[]

  @@map("tb_modulos_sistema")
  @@schema("schs2vet")
}

// Matriz real de permissões — uma linha por (equipeId, userId, moduloSlug).
// nivel: NENHUM | LEITURA | PROPRIO | EQUIPE | FULL
model PermissaoMembro {
  id            Int      @id @default(autoincrement())
  equipeId      Int
  userId        Int
  moduloSlug    String   @db.VarChar(100)
  nivel         String   @default("LEITURA") @db.VarChar(20)
  atualizadoPor Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipe Equipe        @relation(fields: [equipeId],    references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId],      references: [id], onDelete: Cascade)
  modulo ModuloSistema @relation(fields: [moduloSlug],  references: [slug])

  @@unique([equipeId, userId, moduloSlug])
  @@index([equipeId, userId])
  @@map("tb_permissoes_membros")
  @@schema("schs2vet")
}

// Log imutável de alterações de permissão.
// Sem FKs deletáveis — deve persistir mesmo se user for removido.
model AuditoriaPermissao {
  id              Int      @id @default(autoincrement())
  equipeId        Int
  equipeNome      String   @db.VarChar(150)
  alvoUserId      Int
  alvoUserNome    String   @db.VarChar(255)
  alvoUserEmail   String   @db.VarChar(255)
  moduloSlug      String   @db.VarChar(100)
  moduloLabel     String   @db.VarChar(150)
  nivelAnterior   String?  @db.VarChar(20)
  nivelNovo       String   @db.VarChar(20)
  alteradoPorId   Int
  alteradoPorNome String   @db.VarChar(255)
  motivo          String?  @db.Text
  ipOrigem        String?  @db.VarChar(45)
  createdAt       DateTime @default(now())

  @@index([equipeId])
  @@index([alvoUserId])
  @@index([alteradoPorId])
  @@index([createdAt])
  @@map("tb_auditoria_permissoes")
  @@schema("schs2vet")
}

// Perfis (cargos) explícitos por equipe — existem independentemente de membros.
// Permite criar e configurar um perfil antes de associar qualquer membro.
model PerfilEquipe {
  id        Int      @id @default(autoincrement())
  equipeId  Int
  slug      String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipe Equipe         @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  matriz MatrizPerfil[]

  @@unique([equipeId, slug])
  @@index([equipeId])
  @@map("tb_perfis_equipe")
  @@schema("schs2vet")
}

// Matriz de permissões template por perfil — independente de membros.
// Quando um membro é adicionado/tem cargo alterado, essa matriz é copiada para PermissaoMembro.
model MatrizPerfil {
  id         Int     @id @default(autoincrement())
  equipeId   Int
  perfilSlug String  @db.VarChar(50)
  moduloSlug String  @db.VarChar(100)
  nivel      String  @default("NENHUM") @db.VarChar(20)
  locked     Boolean @default(false)

  perfil PerfilEquipe  @relation(fields: [equipeId, perfilSlug], references: [equipeId, slug], onDelete: Cascade)
  modulo ModuloSistema @relation(fields: [moduloSlug],           references: [slug])

  @@unique([equipeId, perfilSlug, moduloSlug])
  @@index([equipeId, perfilSlug])
  @@map("tb_matriz_perfis")
  @@schema("schs2vet")
}

// Permissões especiais liberadas para proprietários pelo veterinário gestor.
// Por padrão todas são false — habilitadas sob demanda.
// funcionalidade: "ver_prontuario" | "ver_exames" | "ver_faturas" | "agendar"
model PermissaoProprietario {
  id              Int      @id @default(autoincrement())
  equipeId        Int
  userId          Int      // userId do proprietário
  funcionalidade  String   @db.VarChar(50)
  habilitado      Boolean  @default(false)
  atualizadoPor   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([equipeId, userId, funcionalidade])
  @@index([equipeId, userId])
  @@map("tb_permissoes_proprietarios")
  @@schema("schs2vet")
}

// =============================================================================
// ÍNDICE CRMV (scraping diário do SISCAD/CFMV)
// =============================================================================

// Armazena SHA-256(numero_6digits + UF) de cada CRMV ativo encontrado no SISCAD.
// Nunca armazena o número em claro — apenas hash unidirecional.
model CrmvValido {
  id        Int      @id @default(autoincrement())
  hash      String   @unique @db.VarChar(64)
  uf        String   @db.VarChar(2)
  createdAt DateTime @default(now())

  @@index([uf])
  @@map("tb_crmv_validos")
  @@schema("schs2vet")
}

// Log de cada execução do scraper
model CrmvSyncLog {
  id             Int      @id @default(autoincrement())
  executadoEm    DateTime @default(now())
  totalRegistros Int      @default(0)
  duracao        Int?     // segundos
  sucesso        Boolean  @default(true)
  erro           String?  @db.Text

  @@map("tb_crmv_sync_log")
  @@schema("schs2vet")
}

// =============================================================================
// FARMÁCIA — CATÁLOGO GLOBAL + ESTOQUE POR CLÍNICA
// =============================================================================

// Catálogo global de medicamentos (compartilhado entre clínicas)
model Medicamento {
  id                Int      @id @default(autoincrement())
  nome              String   @db.VarChar(90)
  formaFarmaceutica String   @db.VarChar(255)
  unidade           String   @db.VarChar(100)
  apresentacao      String   @db.VarChar(255)
  classificacao     String?  @db.VarChar(255)
  fabricante        String?  @db.VarChar(150)
  controlado        Boolean  @default(false)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vias        MedicamentoVia[]
  especies    MedicamentoEspecie[]
  estoques    EstoqueClinica[]
  prescricoes Prescricao[]     @relation("MedicamentoPrescricoes")
  lotes       LoteVacina[]     @relation("MedicamentoLotes")

  @@index([nome])
  @@index([ativo])
  @@index([controlado])
  @@map("tb_medicamentos")
  @@schema("schs2vet")
}

// Espécies para as quais o medicamento é indicado (relação N:N)
model MedicamentoEspecie {
  id            Int         @id @default(autoincrement())
  medicamentoId Int
  especieId     Int

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  especie     Especie     @relation(fields: [especieId],     references: [id], onDelete: Cascade)

  @@unique([medicamentoId, especieId])
  @@index([medicamentoId])
  @@index([especieId])
  @@map("tb_medicamento_especies")
  @@schema("schs2vet")
}

// Vias de administração vinculadas ao catálogo
model MedicamentoVia {
  id            Int         @id @default(autoincrement())
  medicamentoId Int
  via           String      @db.VarChar(255)

  medicamento Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)

  @@unique([medicamentoId, via])
  @@index([medicamentoId])
  @@map("tb_medicamento_vias")
  @@schema("schs2vet")
}

// Estoque por clínica (uma linha = um medicamento em uma clínica)
model EstoqueClinica {
  id               Int       @id @default(autoincrement())
  medicamentoId    Int
  empresaId        Int?
  valor              Float     @default(0)        // preço de compra
  valorRepassado     Float     @default(0)        @map("valor_repassado")
  precoUnitarioBase  Float?                       @map("preco_unitario_base") // R$/g ou R$/mL — fixo na entrada
  lote               String?   @db.VarChar(100)
  validade           DateTime?
  qtdEstoque         Float     @default(0)
  estoqueMinimo    Float     @default(0)        // alerta vermelho
  estoqueAlarmante Float     @default(0)        // alerta amarelo
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fornecedorId Int?      @map("fornecedor_id")
  notaFiscal   String?   @db.VarChar(100) @map("nota_fiscal")

  medicamento Medicamento      @relation(fields: [medicamentoId], references: [id])
  empresa     Empresa?         @relation("EmpresaEstoque", fields: [empresaId], references: [id], onDelete: SetNull)
  fornecedor  Fornecedor?      @relation("FornecedorEstoque", fields: [fornecedorId], references: [id], onDelete: SetNull)
  movimentos  MovimentoEstoque[]
  reservas    ReservaEstoque[] @relation("EstoqueReservas")

  @@index([medicamentoId])
  @@index([empresaId])
  @@index([fornecedorId])
  @@index([ativo])
  @@map("tb_estoque_clinica")
  @@schema("schs2vet")
}

// Movimentações de estoque por clínica
model MovimentoEstoque {
  id         Int            @id @default(autoincrement())
  estoqueId  Int
  tipo       String         @db.VarChar(20)  // ENTRADA | SAIDA | AJUSTE
  quantidade Float
  motivo     String?        @db.Text
  createdAt  DateTime       @default(now())

  estoque EstoqueClinica @relation(fields: [estoqueId], references: [id], onDelete: Cascade)

  @@index([estoqueId])
  @@index([createdAt])
  @@map("tb_movimentos_estoque")
  @@schema("schs2vet")
}

// =============================================================================
// CADASTRO — TRATADOR
// =============================================================================

model Tratador {
  id            Int      @id @default(autoincrement())
  nome          String   @db.VarChar(255)
  telefone      String?  @db.VarChar(30)
  localizacaoId Int?     @map("localizacao_id")
  tipoEntrada   String   @default("CLIENTE") @db.VarChar(10) @map("tipo_entrada")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  localizacao LocalizacaoAnimal?  @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  animais     Animal[]

  @@unique([nome, localizacaoId])
  @@index([localizacaoId])
  @@map("tb_tratadores")
  @@schema("schs2vet")
}

model Fornecedor {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(255)
  cpf         String?  @db.VarChar(20)
  cnpj        String?  @db.VarChar(20)
  telefone    String?  @db.VarChar(30)  // obrigatório na app (nullable p/ legado)
  email       String?  @db.VarChar(255) // obrigatório na app (nullable p/ legado) — usado p/ vincular ao User
  tipoServico String   @db.VarChar(50)  @map("tipo_servico")
  tipoEntrada String   @default("CLIENTE") @db.VarChar(10) @map("tipo_entrada")
  cep         String?  @db.VarChar(10)
  endereco    String?  @db.VarChar(500)
  complemento String?  @db.VarChar(255)
  bairro      String?  @db.VarChar(255)
  cidade      String?  @db.VarChar(255)
  estado      String?  @db.VarChar(2)
  ativo       Boolean  @default(true)
  // SYSTEM (ADMIN) e registros legados: empresaId null = visível para todos.
  // CLIENTE novo: escopado à empresa ativa (req.empresaId) de quem criou.
  empresaId   Int?     @map("empresa_id")
  userId      Int?     @unique @map("user_id") // conta de login (User FORNECEDOR) — dá ao prestador o tipoServico
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  user     User?            @relation("FornecedorUser", fields: [userId], references: [id], onDelete: SetNull)
  estoques EstoqueClinica[] @relation("FornecedorEstoque")

  @@index([empresaId])
  @@map("tb_fornecedores")
  @@schema("schs2vet")
}

// Reservas de estoque vinculadas a prescrições finalizadas (aguardando execução)
model ReservaEstoque {
  id                Int      @id @default(autoincrement())
  estoqueId         Int
  prescricaoGrupoId Int
  animalId          Int
  quantidade        Float
  criadoEm          DateTime @default(now())

  estoque         EstoqueClinica  @relation("EstoqueReservas",  fields: [estoqueId],         references: [id], onDelete: Cascade)
  prescricaoGrupo PrescricaoGrupo @relation("GrupoReservas",   fields: [prescricaoGrupoId], references: [id], onDelete: Cascade)
  animal          Animal          @relation("AnimalReservas",  fields: [animalId],          references: [id], onDelete: Cascade)

  @@unique([prescricaoGrupoId, estoqueId])
  @@index([estoqueId])
  @@map("tb_reservas_estoque")
  @@schema("schs2vet")
}

// =============================================================================
// CADASTRO — LOCALIZAÇÃO DE ANIMAL
// =============================================================================
// Tabela global compartilhada entre todas as empresas.
// tipoEntrada: SYSTEM (criado pelo ADMIN, imutável para não-ADMIN)
//              CLIENTE (criado por outros, pode receber solicitação de alteração ao ADMIN)
// Apenas ADMIN pode editar diretamente ou inativar.

model LocalizacaoAnimal {
  id                Int      @id @default(autoincrement())
  nome              String   @unique @db.VarChar(255)
  cnpj              String?  @db.VarChar(18)
  cep               String?  @db.VarChar(10)
  endereco          String?  @db.VarChar(500)
  pessoaResponsavel String?  @db.VarChar(255)
  telefone          String?  @db.VarChar(30)
  tipoLocalizacao   String   @db.VarChar(50)
  tipoEntrada       String   @default("CLIENTE") @db.VarChar(10)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  animais    Animal[]
  tratadores Tratador[]

  @@index([tipoLocalizacao])
  @@index([ativo])
  @@map("tb_localizacoes_animal")
  @@schema("schs2vet")
}

model Laboratorio {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(255)
  contato   String?  @db.VarChar(100)
  email     String?  @db.VarChar(255)
  site      String?  @db.VarChar(255)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grupos ExameGrupo[]

  @@index([ativo])
  @@map("tb_laboratorios")
  @@schema("schs2vet")
}

model ExameGrupo {
  id            Int     @id @default(autoincrement())
  laboratorioId Int     @map("laboratorio_id")
  nome          String  @db.VarChar(255)
  ordem         Int     @default(0)
  ativo         Boolean @default(true)

  laboratorio Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)
  itens       ExameItem[]

  @@unique([laboratorioId, nome])
  @@index([laboratorioId])
  @@map("tb_exame_grupos")
  @@schema("schs2vet")
}

model ExameItem {
  id           Int      @id @default(autoincrement())
  grupoId      Int      @map("grupo_id")
  nome         String   @db.VarChar(500)
  sigla        String?  @db.VarChar(100)
  tiposAmostra String[] @map("tipo_amostra") @default([])
  ativo        Boolean  @default(true)

  grupo ExameGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, nome])
  @@index([grupoId])
  @@map("tb_exame_itens")
  @@schema("schs2vet")
}

model ImagemExameGrupo {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(255)
  categoria String   @default("Diagnóstico por Imagem") @db.VarChar(255)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens ImagemExameItem[]

  @@index([ativo])
  @@map("tb_imagem_exame_grupos")
  @@schema("schs2vet")
}

model ImagemExameItem {
  id      Int     @id @default(autoincrement())
  grupoId Int     @map("grupo_id")
  codigo  String  @unique @db.VarChar(20)
  nome    String  @db.VarChar(500)
  sigla   String? @db.VarChar(100)
  especie String  @default("Ambas") @db.VarChar(50)
  ativo   Boolean @default(true)

  grupo ImagemExameGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId])
  @@map("tb_imagem_exame_itens")
  @@schema("schs2vet")
}

// =============================================================================
// RESENHA EQUINO
// =============================================================================

model ResenhaEquino {
  id                 Int      @id @default(autoincrement())
  animalId           Int?     @map("animal_id")
  numeroCBH          String?  @db.VarChar(100) @map("numero_cbh")
  paisNascimento     String?  @db.VarChar(100) @default("Brasil") @map("pais_nascimento")
  registroGenealogia String?  @db.VarChar(100) @map("registro_genealogia")
  pai                String?  @db.VarChar(255)
  mae                String?  @db.VarChar(255)
  paiDaMae           String?  @db.VarChar(255) @map("pai_da_mae")
  sinaisCabeca       String?  @map("sinais_cabeca")
  sinaisAE           String?  @map("sinais_ae")
  sinaisAD           String?  @map("sinais_ad")
  sinaisPE           String?  @map("sinais_pe")
  sinaisPD           String?  @map("sinais_pd")
  sinaisCorpo        String?  @map("sinais_corpo")
  marcaFogo          String?  @db.VarChar(100) @map("marca_fogo")
  outroId            String?  @db.VarChar(100) @map("outro_id")
  graficaData        Json?    @map("grafica_data")
  criadoPorId        Int?     @map("criado_por_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  animal    Animal? @relation("AnimalResenha", fields: [animalId], references: [id], onDelete: SetNull)
  criadoPor User?   @relation("ResenhasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([animalId])
  @@map("tb_resenha_equino")
  @@schema("schs2vet")
}

// =============================================================================
// RESENHA GRÁFICA EQUINA
// =============================================================================

enum VistaResenha {
  LATERAL
  CABECA_FRONTAL
  FOCINHO
  PESCOCO_INFERIOR
  MEMBROS_ANTERIORES
  MEMBROS_POSTERIORES

  @@schema("schs2vet")
}

enum TipoMarcacaoResenha {
  PELO_BRANCO
  CICATRIZ
  MANCHA
  REDEMOINHO

  @@schema("schs2vet")
}

model RegiaoAnatomicaEquino {
  id        Int          @id @default(autoincrement())
  codigo    String       @unique @db.VarChar(60)
  labelPt   String       @map("label_pt") @db.VarChar(120)
  labelEn   String?      @map("label_en") @db.VarChar(120)
  labelEs   String?      @map("label_es") @db.VarChar(120)
  vista     VistaResenha
  poligono  Json
  ativo     Boolean      @default(true)
  ordem     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tracosRegiao ResenhaTracoRegiao[]

  @@map("tb_regioes_anatomicas_equino")
  @@schema("schs2vet")
}

model ResenhaGrafica {
  id          Int          @id @default(autoincrement())
  animalId    Int          @map("animal_id")
  vista       VistaResenha
  vetorTracos Json         @map("vetor_tracos")
  snapshotPng String?      @map("snapshot_png") @db.Text
  versao      Int          @default(1)
  criadoPorId Int          @map("criado_por_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  animal       Animal               @relation("ResenhaGraficaAnimal", fields: [animalId], references: [id], onDelete: Cascade)
  criadoPor    User                 @relation("ResenhaGraficaCriadaPor", fields: [criadoPorId], references: [id])
  tracosRegiao ResenhaTracoRegiao[]

  @@unique([animalId, vista])
  @@index([animalId])
  @@map("tb_resenha_grafica")
  @@schema("schs2vet")
}

model ResenhaTracoRegiao {
  id                Int                 @id @default(autoincrement())
  resenhaGraficaId  Int                 @map("resenha_grafica_id")
  tracoIndex        Int                 @map("traco_index")
  regiaoId          Int                 @map("regiao_id")
  tipoMarcacao      TipoMarcacaoResenha @map("tipo_marcacao")
  percentualOverlap Decimal?            @map("percentual_overlap") @db.Decimal(5, 2)
  createdAt         DateTime            @default(now()) @map("created_at")

  resenhaGrafica ResenhaGrafica        @relation(fields: [resenhaGraficaId], references: [id], onDelete: Cascade)
  regiao         RegiaoAnatomicaEquino @relation(fields: [regiaoId], references: [id])

  @@index([resenhaGraficaId])
  @@index([regiaoId])
  @@map("tb_resenha_traco_regiao")
  @@schema("schs2vet")
}
