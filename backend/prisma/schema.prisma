generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ====================== USUÁRIOS + RBAC ======================
model User {
  id Int @id @default(autoincrement())
  fullName String
  email String @unique
  passwordHash String
  phone String?
  role String @default("USER")
  userType String @default("PROPRIETARIO")

  // === Campos de endereço ===
  cep String?
  endereco String?
  complemento String?
  bairro String?
  cidade String?
  estado String?

  createdAt DateTime @default(now())
  ativo Boolean @default(true)

  // === Campos de recuperação de senha ===
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // === Auditoria ===
  auditLogs AuditLog[]

  @@map("users")
}

// ====================== MODELOS EXISTENTES ======================
model Animal {
  id                Int      @id @default(autoincrement())
  nome              String
  peso              Float
  dataNascimento    DateTime?
  sexo              String
  photoUrl          String?
  dataCadastro      DateTime @default(now())
  ativo             Boolean  @default(true)

  especieId         Int
  racaId            Int?
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  especie           Especie  @relation(fields: [especieId], references: [id])
  raca              Raca?    @relation(fields: [racaId], references: [id])

  dietas            Dieta[]
  exames            ExameNutricional[]
  ocorrencias       OcorrenciaSaude[]
  exercises         AnimalExercise[]

  @@map("tb_animais")
}

model Especie {
  id     Int    @id @default(autoincrement())
  nome   String @unique

  animais Animal[]
  racas   Raca[]

  @@map("tb_especies")
}

model Raca {
  id         Int      @id @default(autoincrement())
  nome       String
  especieId  Int

  especie    Especie  @relation(fields: [especieId], references: [id])
  animais    Animal[]

  @@unique([nome, especieId])   // ← ESSA LINHA É OBRIGATÓRIA
  @@map("tb_racas")
}

model AnimalExercise {
  id             Int      @id @default(autoincrement())
  animalId       Int
  tipo           String   // ex: "Adestramento", "Salto", "Barril", "Cross"
  periodicidade  String   // ex: "2x na semana", "1x por dia"

  animal         Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("tb_animal_exercise")
}

model Dieta {
  id               Int      @id @default(autoincrement())
  animalId         Int
  produtoId        Int
  qtdGramasDia     Float
  dataInicio       DateTime @default(now())
  dataFim          DateTime?
  horario          String?
  observacao       String?

  animal           Animal   @relation(fields: [animalId], references: [id])
  produto          Produto  @relation(fields: [produtoId], references: [id])

  @@map("tb_dieta")
}

model Produto {
  id            Int      @id @default(autoincrement())
  nome          String
  categoria     String
  fabricante    String?
  forma         String?
  ativo         Boolean  @default(true)

  composicoes   ComposicaoProduto[]
  dietas        Dieta[]

  @@map("tb_produtos")
}

model Nutriente {
  id             Int      @id @default(autoincrement())
  nome           String
  categoria      String
  unidadePadrao  String
  codigo         String?  @unique
  essencial      Boolean  @default(false)

  composicoes    ComposicaoProduto[]
  exames         ExameNutricional[]

  @@map("tb_nutrientes")
}

model ComposicaoProduto {
  id            Int      @id @default(autoincrement())
  produtoId     Int
  nutrienteId   Int
  valorPorKg    Float
  base          String   @default("Seca")

  produto       Produto   @relation(fields: [produtoId], references: [id])
  nutriente     Nutriente @relation(fields: [nutrienteId], references: [id])

  @@unique([produtoId, nutrienteId])
  @@map("tb_composicao_produto")
}

model ExameNutricional {
  id                  Int      @id @default(autoincrement())
  animalId            Int
  nutrienteId         Int
  dataExame           DateTime
  valorEncontrado     Float
  unidade             String
  valorMinRef         Float?
  valorMaxRef         Float?
  observacao          String?
  statusClinico       String?

  animal              Animal    @relation(fields: [animalId], references: [id])
  nutriente           Nutriente @relation(fields: [nutrienteId], references: [id])

  @@map("tb_exames_nutricionais")
}

model OcorrenciaSaude {
  id            Int      @id @default(autoincrement())
  animalId      Int
  dataInicio    DateTime
  dataFim       DateTime?
  problema      String
  tratamento    String?
  responsavel   String?

  animal        Animal   @relation(fields: [animalId], references: [id])

  @@map("tb_ocorrencias_saude")
}

// ====================== AUDITORIA ======================
model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  userName    String
  email       String
  action      String   // "LOGIN" ou "LOGOUT"
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("tb_audit_logs")
}